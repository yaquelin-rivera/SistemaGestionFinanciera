@model SistemaGestionFinanciera.Models.ClientesBeneficiario

@{
    ViewData["Title"] = "Detalles del cliente / beneficiario";

    int totalCuentasPorCobrar = ViewBag.TotalCuentasPorCobrar ?? 0;
    int cuentasPendientes = ViewBag.CuentasPendientes ?? 0;
    int cuentasVencidas = ViewBag.CuentasVencidas ?? 0;
    decimal saldoPendiente = ViewBag.SaldoPendiente ?? 0m;

    int facturas = Model.Facturas?.Count ?? 0;
    int ingresos = Model.Ingresos?.Count ?? 0;

    var contactosAdicionales = Model.ContactosAdicionales?
        .Where(c => c.Activo)
        .OrderBy(c => c.TipoContacto)
        .ThenByDescending(c => c.IdContactoCliente)
        .ToList()
        ?? new List<SistemaGestionFinanciera.Models.ContactoClienteBeneficiario>();
}

<div class="container-fluid mt-4">

    <h2 class="fw-bold mb-0">Detalles del cliente / beneficiario</h2>
    <small class="text-muted">Información general y relaciones financieras del registro.</small>

    @*
    <div class="row g-3 mt-2 mb-3">

        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-primary border-4 h-100">
