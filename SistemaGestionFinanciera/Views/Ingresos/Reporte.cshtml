@model IEnumerable<SistemaGestionFinanciera.Models.Ingreso>

@{
    // La vista no utiliza el menú lateral ni el Layout general,
    // porque está diseñada para imprimir o guardar como PDF.
    Layout = null;

    ViewData["Title"] = "Reporte de ingresos";

    // ===========================================================
    // TOTALES RECIBIDOS DESDE INGRESOSCONTROLLER
    // ===========================================================

    decimal totalEsperado = ViewBag.TotalEsperado ?? 0m;
    decimal totalRecibido = ViewBag.TotalRecibido ?? 0m;
    decimal diferenciaTotal = ViewBag.DiferenciaTotal ?? 0m;

    // Detecta si el usuario aplicó algún filtro.
    bool hayFiltros =
        !string.IsNullOrWhiteSpace(ViewBag.Buscar as string) ||
        !string.IsNullOrWhiteSpace(ViewBag.Tipo as string) ||
        !string.IsNullOrWhiteSpace(ViewBag.Estado as string) ||
        !string.IsNullOrWhiteSpace(ViewBag.Origen as string) ||
        ViewBag.ProyectoId != null ||
        ViewBag.Anio != null ||
        ViewBag.Mes != null ||
        !string.IsNullOrWhiteSpace(ViewBag.FechaInicio as string) ||
        !string.IsNullOrWhiteSpace(ViewBag.FechaFin as string);

    // Convierte el número del mes a su nombre.
    string nombreMes = "";

    if (ViewBag.Mes != null)
    {
        int numeroMes = Convert.ToInt32(ViewBag.Mes);

        nombreMes = new DateTime(2000, numeroMes, 1)
            .ToString(
                "MMMM",
                new System.Globalization.CultureInfo("es-CR"));

        nombreMes =
            char.ToUpper(nombreMes[0]) +
            nombreMes.Substring(1);
    }
}

<link rel="stylesheet"
      href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

<link rel="stylesheet"
      href="~/css/site.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<div class="container-fluid reporte-contenedor">

    <!-- 
         BOTONES DE CONTROL
         No aparecen cuando el reporte se imprime.
        -->
    <div class="d-flex justify-content-end gap-2 mb-3 no-imprimir">

        <button type="button"
                class="btn btn-info btn-lg px-4 shadow-sm"
                onclick="window.print();">

            <i class="fas fa-file-pdf me-2"></i>
            Imprimir / Guardar PDF

        </button>

        <button type="button"
                class="btn btn-secondary btn-lg px-4 shadow-sm"
                onclick="history.back();">

            <i class="fas fa-arrow-left me-2"></i>
            Volver

        </button>

    </div>

    <!-- 
         ENCABEZADO DEL REPORTE
          -->
    <div class="encabezado-reporte text-center">

        <h2>
            <i class="fas fa-chart-pie me-2"></i>
            Unión Cantonal de Asociaciones de Desarrollo de Santa Ana
        </h2>

        <h4>
            <i class="fas fa-file-invoice-dollar me-1"></i>
            Reporte de Ingresos
        </h4>

        <div class="fecha-generacion">
            <i class="fas fa-calendar-alt me-1"></i>
            Fecha de generación:

            <strong>
                @(((DateTime)ViewBag.FechaGeneracion)
                    .ToString("dd/MM/yyyy HH:mm"))
            </strong>
        </div>

    </div>

    <!-- ======================================================
         FILTROS APLICADOS
         ====================================================== -->
    <div class="seccion-reporte">

        <div class="titulo-seccion">
            <i class="fas fa-filter me-1"></i>
            Filtros aplicados
        </div>

        @if (hayFiltros)
        {
            <div class="row g-2 small">

                @if (!string.IsNullOrWhiteSpace(ViewBag.Buscar as string))
                {
                    <div class="col-md-4">
                        <strong>Búsqueda:</strong>
                        @ViewBag.Buscar
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(ViewBag.Tipo as string))
                {
                    <div class="col-md-4">
                        <strong>Tipo:</strong>
                        @ViewBag.Tipo
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(ViewBag.Estado as string))
                {
                    <div class="col-md-4">
                        <strong>Estado:</strong>
                        @ViewBag.Estado
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(ViewBag.Origen as string))
                {
                    <div class="col-md-4">
                        <strong>Origen:</strong>
                        @ViewBag.Origen
                    </div>
                }

                @if (ViewBag.ProyectoId != null)
                {
                    <div class="col-md-4">
                        <strong>Proyecto:</strong>
                        Código @ViewBag.ProyectoId
                    </div>
                }

                @if (ViewBag.Anio != null)
                {
                    <div class="col-md-4">
                        <strong>Año:</strong>
                        @ViewBag.Anio
                    </div>
                }

                @if (ViewBag.Mes != null)
                {
                    <div class="col-md-4">
                        <strong>Mes:</strong>
                        @nombreMes
                    </div>
                }
                @if (ViewBag.PendientePresupuesto == true)
                {
                    <span>
                        Pendientes de asignación presupuestaria
                    </span>
                }
                @if (!string.IsNullOrWhiteSpace(ViewBag.FechaInicio as string))
                {
                    <div class="col-md-4">
                        <strong>Desde:</strong>
                        @ViewBag.FechaInicio
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(ViewBag.FechaFin as string))
                {
                    <div class="col-md-4">
                        <strong>Hasta:</strong>
                        @ViewBag.FechaFin
                    </div>
                }

            </div>
        }
        else
        {
            <span class="text-muted">
                No se aplicaron filtros. El reporte muestra todos los ingresos registrados.
            </span>
        }

    </div>

    <!-- ======================================================
         RESUMEN DEL REPORTE
         ====================================================== -->
    <div class="row row-cols-1 row-cols-md-4 g-2 mb-3 cards-reporte">

        <div class="col">
            <div class="resumen-reporte card-registros">

                <div class="icono">
                    <i class="fas fa-file-invoice"></i>
                </div>

                <small>Total de registros</small>

                <div class="fw-bold">
                    @ViewBag.TotalRegistros
                </div>

            </div>
        </div>

        <div class="col">
            <div class="resumen-reporte card-esperado">

                <div class="icono">
                    <i class="fas fa-coins"></i>
                </div>

                <small>Total esperado</small>

                <div class="fw-bold">
                    ₡@totalEsperado.ToString("N2")
                </div>

            </div>
        </div>

        <div class="col">
            <div class="resumen-reporte card-recibido">

                <div class="icono">
                    <i class="fas fa-money-bill-transfer"></i>
                </div>

                <small>Total recibido</small>

                <div class="fw-bold">
                    ₡@totalRecibido.ToString("N2")
                </div>

            </div>
        </div>

        <div class="col">
            <div class="resumen-reporte card-diferencia">

                <div class="icono">
                    <i class="fas fa-triangle-exclamation"></i>
                </div>

                <small>Diferencia total</small>

                <div class="fw-bold">
                    ₡@diferenciaTotal.ToString("N2")
                </div>

            </div>
        </div>

    </div>
    <!-- ======================================================
         TABLA DE INGRESOS
         ====================================================== -->
    <div class="table-responsive">

        <table class="table table-bordered table-sm tabla-reporte">

            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Fuente</th>
                    <th>Descripción</th>
                    <th>Tipo</th>
                    <th>Categoría</th>
                    <th class="solo-pantalla">Cliente / Beneficiario</th>
                    <th class="solo-pantalla">Proyecto</th>
                    <th class="solo-pantalla">Centro de costo</th>
                    <th>Origen</th>
                    <th>Estado</th>
                    <th class="text-end">Monto esperado</th>
                    <th class="text-end">Monto recibido</th>
                    <th class="text-end">Diferencia</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        bool esIngresoDesdeCxC =
                        item.TipoIngreso == "Cobro CxC" ||
                        (!string.IsNullOrWhiteSpace(item.Fuente) &&
                        item.Fuente.ToUpper().StartsWith("CUC-"));

                        bool esIngresoDesdeFactura =
                        item.FacturaId != null ||
                        item.TipoIngreso == "Facturación" ||
                        (!string.IsNullOrWhiteSpace(item.Fuente) &&
                        item.Fuente.ToUpper().StartsWith("FV-"));

                        string origenIngreso;

                        if (esIngresoDesdeCxC)
                        {
                            origenIngreso = "CxC";
                        }
                        else if (esIngresoDesdeFactura)
                        {
                            origenIngreso = "Factura";
                        }
                        else
                        {
                            origenIngreso = "Manual";
                        }
                        string claseFila = "";

                        if (item.Estado == "Anulado")
                        {
                            claseFila = "fila-anulada";
                        }
                        else if (item.Estado == "Pendiente")
                        {
                            claseFila = "fila-pendiente";
                        }

                        decimal montoEsperado = item.MontoEsperado ?? 0m;
                        decimal montoRecibido = item.MontoReal ?? 0m;
                        decimal diferencia =
                        item.Diferencia ??
                        (montoEsperado - montoRecibido);

                        <tr class="@claseFila">

                            <td>
                                @item.Fecha.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.Fuente)
                                    ? "Sin fuente"
                                    : item.Fuente)
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.Descripcion)
                                    ? "Sin descripción"
                                    : item.Descripcion)
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.TipoIngreso)
                                    ? "Sin tipo"
                                    : item.TipoIngreso)
                            </td>

                            <td>
                                @(item.CategoriaIngreso?.Nombre
                                    ?? "Sin categoría")
                            </td>

                            <td class="solo-pantalla">
                                @(item.ClienteBeneficiario?.Nombre
                                    ?? "Sin cliente")
                            </td>

                            <td class="solo-pantalla">
                                @(item.Proyecto?.Nombre
                                    ?? "Sin proyecto")
                            </td>

                            <td class="solo-pantalla">
                                @(item.CentroCosto?.Nombre
                                    ?? "Sin centro")
                            </td>

                            <td>
                                @origenIngreso
                            </td>

                            <td>
                                @item.Estado
                            </td>

                            <td class="text-end monto-reporte">
                                ₡@montoEsperado.ToString("N2")
                            </td>

                            <td class="text-end monto-reporte">
                                ₡@montoRecibido.ToString("N2")
                            </td>

                            <td class="text-end monto-reporte">
                                ₡@diferencia.ToString("N2")
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="13"
                            class="text-center text-muted py-4">

                            No existen ingresos con los filtros seleccionados.

                        </td>
                    </tr>
                }

            </tbody>

        </table>

        <!-- ==================================================
             TOTALES INFERIORES
             ================================================== -->
        @if (Model.Any())
        {
            <div class="totales-reporte">

                <div>
                    <span>Total esperado:</span>
                    <strong>
                        ₡@totalEsperado.ToString("N2")
                    </strong>
                </div>

                <div>
                    <span>Total recibido:</span>
                    <strong>
                        ₡@totalRecibido.ToString("N2")
                    </strong>
                </div>

                <div>
                    <span>Diferencia total:</span>
                    <strong>
                        ₡@diferenciaTotal.ToString("N2")
                    </strong>
                </div>

                <div>
                    <span>Pagados:</span>
                    <strong>@ViewBag.Pagados</strong>
                </div>

                <div>
                    <span>Pendientes:</span>
                    <strong>@ViewBag.Pendientes</strong>
                </div>

                <div>
                    <span>Parciales:</span>
                    <strong>@ViewBag.Parciales</strong>
                </div>

                <div>
                    <span>Anulados:</span>
                    <strong>@ViewBag.Anulados</strong>
                </div>

            </div>
        }

    </div>

    <!-- ======================================================
         PIE DEL REPORTE
         ====================================================== -->
    <div class="pie-reporte">

        <div>
            Sistema Web de Gestión Financiera
        </div>

        <div>
            UCAD Santa Ana
        </div>

        <div>
            Generado:
            @(((DateTime)ViewBag.FechaGeneracion)
                .ToString("dd/MM/yyyy HH:mm"))
        </div>

    </div>

</div>
