}
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // ============================================================
            // FILTROS AUTOMÁTICOS
            // ============================================================
            const formularioFiltros =
                document.getElementById("formFiltrosPresupuesto");

            if (formularioFiltros) {
                formularioFiltros
                    .querySelectorAll("select")
                    .forEach(function (select) {

                        select.addEventListener("change", function () {
                            formularioFiltros.requestSubmit();
                        });
                    });
            }

            // ============================================================
            // DATATABLES
            // ============================================================
            let tablaPresupuestos = null;

            if ($.fn.DataTable &&
                document.getElementById("tablaPresupuestos")) {

                tablaPresupuestos = $("#tablaPresupuestos").DataTable({
                    pageLength: 10,

                    lengthMenu: [
                        [10, 25, 50, 100],
                        [10, 25, 50, 100]
                    ],

                    ordering: true,
                    order: [
                        [1, "desc"],
                        [2, "desc"],
                        [0, "asc"]
                    ],

                    searching: true,
                    paging: true,
                    info: true,
                    autoWidth: false,
                    scrollX:false,

                    columnDefs: [
                        {
                            targets: -1,
                            orderable: false,
                            searchable: false
                        }
                    ],

                    language: {
                        lengthMenu: "Mostrar _MENU_ registros",
                        search: "Buscar en la tabla:",
                        zeroRecords: "No se encontraron presupuestos.",
                        emptyTable: "No hay presupuestos registrados.",
                        info: "Mostrando _START_ a _END_ de _TOTAL_ registros",
                        infoEmpty: "Mostrando 0 registros",
                        infoFiltered: "(filtrado de _MAX_ registros)",
                        paginate: {
                            first: "Primero",
                            last: "Último",
                            next: "Siguiente",
                            previous: "Anterior"
                        }
                    }
                });
            }

            // ============================================================
            // VER PRESUPUESTO EN LA TABLA
            // ============================================================
            document.querySelectorAll(".btn-ver-tabla")
                .forEach(function (boton) {

                    boton.addEventListener("click", function () {
                        const idPresupuesto = boton.dataset.id;
                        const fila = document.getElementById(
                            "presupuesto-" + idPresupuesto
                        );

                        if (!fila) {
                            mostrarAdvertencia(
                                "No se encontró el presupuesto dentro de los resultados filtrados."
                            );
                            return;
                        }

                        const resaltarFila = function () {
                            fila.classList.remove(
                                "fila-presupuesto-resaltada"
                            );

                            void fila.offsetWidth;

                            fila.classList.add(
                                "fila-presupuesto-resaltada"
                            );

                            fila.scrollIntoView({
                                behavior: "smooth",
                                block: "center"
                            });

                            window.setTimeout(function () {
                                fila.classList.remove(
                                    "fila-presupuesto-resaltada"
                                );
                            }, 3000);
                        };

                        if (!tablaPresupuestos) {
                            resaltarFila();
                            return;
                        }

                        const filaDataTable =
                            tablaPresupuestos.row(fila);

                        if (!filaDataTable.any()) {
                            mostrarAdvertencia(
                                "No fue posible ubicar el presupuesto en la tabla."
                            );
                            return;
                        }

                        // Índices de las filas según orden y búsqueda actuales.
                        const indicesVisibles = tablaPresupuestos
                            .rows({
                                order: "applied",
                                search: "applied"
                            })
                            .indexes()
                            .toArray();

                        const indiceInterno = filaDataTable.index();
                        const posicionVisible =
                            indicesVisibles.indexOf(indiceInterno);

                        if (posicionVisible === -1) {
                            mostrarAdvertencia(
                                "El presupuesto no está disponible con la búsqueda actual de la tabla."
                            );
                            return;
                        }

                        const cantidadPorPagina =
                            tablaPresupuestos.page.len();

                        const paginaDestino = Math.floor(
                            posicionVisible / cantidadPorPagina
                        );

                        tablaPresupuestos
                            .page(paginaDestino)
                            .draw("page");

                        window.setTimeout(function () {
                            resaltarFila();
                        }, 150);
                    });
                });
            // ============================================================
            // CONFIRMACIÓN DE APROBACIÓN CON RESUMEN PRESUPUESTARIO
            // ============================================================
            document.querySelectorAll(".formulario-aprobar")
                .forEach(function (formulario) {

                    formulario.addEventListener(
                        "submit",
                        async function (evento) {

                            if (formulario.dataset.enviado === "true") {
                                return;
                            }

                            evento.preventDefault();

                            const boton =
                                formulario.querySelector(
                                    "button[type='submit']"
                                );

                            const id =
                                boton.dataset.id;

                            if (!id) {
                                Swal.fire({
                                    icon: "error",
                                    title: "No fue posible aprobar",
                                    text: "No se pudo identificar el presupuesto seleccionado."
                                });

                                return;
                            }

                            boton.disabled = true;

                            try {
                                const respuesta = await fetch(
                                    "@Url.Action(
                "ObtenerResumenAprobacion",
                "PresupuestosMensuales")" +
                                "?id=" +
                                    encodeURIComponent(id),
                                    {
                                        method: "GET",
                                        headers: {
                                            "X-Requested-With":
                                                "XMLHttpRequest"
                                        }
                                    }
                                );

                                const data =
                                    await respuesta.json();

                                if (!respuesta.ok) {
                                    throw new Error(
                                        data.mensaje ||
                                        "No fue posible obtener el resumen del presupuesto."
                                    );
                                }

                                const moneda =
                                    new Intl.NumberFormat(
                                        "es-CR",
                                        {
                                            style: "currency",
                                            currency: "CRC",
                                            minimumFractionDigits: 2
                                        }
                                    );

                                const totalPeriodos =
                                    data.totalPeriodos !== null
                                        ? data.totalPeriodos
                                        : "No calculable";

                                const periodosPresupuestados =
                                    data.periodosPresupuestados !== null
                                        ? data.periodosPresupuestados
                                        : "No calculable";

                                const periodosPendientes =
                                    data.periodosPendientes !== null
                                        ? data.periodosPendientes
                                        : "No calculable";

                                const distribucion =
                                    data.distribucionOrientativa !== null
                                        ? moneda.format(
                                            data.distribucionOrientativa
                                        ) +
                                        " por período pendiente"
                                        : "No calculable";

                                const claseDisponible =
                                    data.disponibleDespues < 0
                                        ? "text-danger"
                                        : "text-success";

                                const avisoCero =
                                    data.presupuestoEnCero
                                        ? `
                                        <div class="alert alert-warning text-start mt-3 mb-0">
                                            <i class="fas fa-triangle-exclamation me-1"></i>
                                            Este presupuesto será aprobado con
                                            ingreso y gasto planificados en cero.
                                        </div>
                                      `
                                        : "";

                                const avisoUltimosPeriodos =
                                    data.periodosPendientes === 0
                                        ? `
                                        <div class="alert alert-info text-start mt-3 mb-0">
                                            <i class="fas fa-circle-info me-1"></i>
                                            Con este registro, todos los períodos
                                            de vigencia del proyecto ya poseen
                                            presupuesto mensual.
                                        </div>
                                      `
                                        : "";

                                const resultado =
                                    await Swal.fire({
                                        icon: "question",

                                        title:
                                            "¿Aprobar presupuesto mensual?",

                                        html: `
                                        <div class="text-start">

                                            <div class="mb-3">
                                                <div>
                                                    <strong>Proyecto:</strong>
                                                    ${data.proyecto}
                                                </div>

                                                <div>
                                                    <strong>Período:</strong>
                                                    ${data.periodo}
                                                </div>
                                            </div>

                                            <div class="border rounded p-3">

                                                <div class="d-flex justify-content-between gap-3">
                                                    <span>Ingreso planificado:</span>
                                                    <strong>
                                                        ${moneda.format(
                                            data.ingresoPlanificado
                                        )}
                                                    </strong>
                                                </div>

                                                <div class="d-flex justify-content-between gap-3">
                                                    <span>Gasto planificado:</span>
                                                    <strong>
                                                        ${moneda.format(
                                            data.gastoPlanificado
                                        )}
                                                    </strong>
                                                </div>

                                                <hr>

                                                <div class="d-flex justify-content-between gap-3">
                                                    <span>Presupuesto global:</span>
                                                    <strong>
                                                        ${moneda.format(
                                            data.presupuestoGlobal
                                        )}
                                                    </strong>
                                                </div>

                                                <div class="d-flex justify-content-between gap-3">
                                                    <span>Gasto comprometido actualmente:</span>
                                                    <strong>
                                                        ${moneda.format(
                                            data.comprometidoAntes
                                        )}
                                                    </strong>
                                                </div>

                                                <div class="d-flex justify-content-between gap-3">
                                                    <span>Gasto comprometido después de aprobar:</span>
                                                    <strong>
                                                        ${moneda.format(
                                            data.comprometidoDespues
                                        )}
                                                    </strong>
                                                </div>

                                                <div class="d-flex justify-content-between gap-3">
                                                    <span>Disponible después para este proyecto:</span>
                                                    <strong class="${claseDisponible}">
                                                        ${moneda.format(
                                            data.disponibleDespues
                                        )}
                                                    </strong>
                                                </div>

                                                <hr>

                                                <div class="d-flex justify-content-between gap-3">
                                                    <span>Períodos totales:</span>
                                                    <strong>
                                                        ${totalPeriodos}
                                                    </strong>
                                                </div>

                                                <div class="d-flex justify-content-between gap-3">
                                                    <span>Períodos con presupuesto:</span>
                                                    <strong>
                                                        ${periodosPresupuestados}
                                                    </strong>
                                                </div>

                                                <div class="d-flex justify-content-between gap-3">
                                                    <span>Períodos todavía pendientes:</span>
                                                    <strong>
                                                        ${periodosPendientes}
                                                    </strong>
                                                </div>

                                                <div class="d-flex justify-content-between gap-3">
                                                    <span>Distribución sugerida:</span>
                                                    <strong>
                                                        ${distribucion}
                                                    </strong>
                                                </div>

                                            </div>

                                            ${avisoCero}
                                            ${avisoUltimosPeriodos}

                                            <div class="alert alert-secondary text-start mt-3 mb-0">
                                                Una vez aprobado, el presupuesto
                                                ya no podrá modificarse.
                                            </div>

                                        </div>
                                    `,

                                        showCancelButton: true,

                                        confirmButtonText:
                                            '<i class="fas fa-circle-check me-1"></i> Sí, aprobar',

                                        cancelButtonText:
                                            '<i class="fas fa-xmark me-1"></i> Cancelar',

                                        confirmButtonColor:
                                            "#198754",

                                        cancelButtonColor:
                                            "#6C757D",

                                        reverseButtons: true,
                                        focusCancel: true,
                                        width: 650
                                    });

                                if (resultado.isConfirmed) {
                                    formulario.dataset.enviado =
                                        "true";

                                    formulario.submit();
                                }
                            }
                            catch (error) {
                                Swal.fire({
                                    icon: "error",
                                    title:
                                        "No fue posible cargar el resumen",
                                    text:
                                        error.message ||
                                        "Intente nuevamente."
                                });
                            }
                            finally {
                                boton.disabled = false;
                            }
                        }
                    );
                });
            // ============================================================
            // RECHAZO CON RESUMEN + OBSERVACIÓN OBLIGATORIA
            // ============================================================
            document.querySelectorAll(".btn-rechazar")
                .forEach(function (boton) {

                    boton.addEventListener("click", async function () {

                        const id = boton.dataset.id;

                        if (!id) {
                            Swal.fire({
                                icon: "error",
                                title: "No fue posible continuar",
                                text: "No se pudo identificar el presupuesto seleccionado."
                            });

                            return;
                        }

                        boton.disabled = true;

                        try {

                            const respuesta = await fetch(
                                "@Url.Action("ObtenerResumenRechazo", "PresupuestosMensuales")" +
                                "?id=" +
                                encodeURIComponent(id),
                                {
                                    method: "GET",
                                    headers: {
                                        "X-Requested-With": "XMLHttpRequest"
                                    }
                                }
                            );

                            const data = await respuesta.json();

                            if (!respuesta.ok) {
                                throw new Error(
                                    data.mensaje ||
                                    "No fue posible obtener la información del presupuesto."
                                );
                            }

                            const moneda =
                                new Intl.NumberFormat(
                                    "es-CR",
                                    {
                                        style: "currency",
                                        currency: "CRC",
                                        minimumFractionDigits: 2
                                    }
                                );

                            const nombresMeses = [
                                "",
                                "Enero",
                                "Febrero",
                                "Marzo",
                                "Abril",
                                "Mayo",
                                "Junio",
                                "Julio",
                                "Agosto",
                                "Septiembre",
                                "Octubre",
                                "Noviembre",
                                "Diciembre"
                            ];

                            const periodo =
                                `${nombresMeses[data.mes] || data.mes} ${data.anio}`;

                            let avisoIngresos = "";

                            if (data.cantidadIngresos > 0) {

                                avisoIngresos = `
                                <div class="alert alert-warning text-start mt-3 mb-0">

                                           <div class="fw-bold mb-2">
            <i class="fas fa-triangle-exclamation me-1"></i>
            Ingresos asociados
        </div>

        <div class="d-flex justify-content-between">
            <span>Cantidad de ingresos:</span>
            <strong>
                ${data.cantidadIngresos}
            </strong>
        </div>

        <div class="d-flex justify-content-between">
            <span>Monto total asociado:</span>
            <strong>
                ${moneda.format(data.montoIngresos)}
            </strong>
        </div>

        <hr>

        <div class="small">
            Al rechazar este presupuesto, los ingresos asociados
            <strong>no serán anulados ni eliminados</strong>.
            Continuarán registrados como ingresos reales del sistema,
            pero quedarán pendientes de una asignación presupuestaria válida.
            <br><br>
            <strong>Nota:</strong> si este presupuesto no será aprobado,
            los ingresos deberán reasignarse posteriormente a un período
            presupuestario válido desde el módulo de Ingresos.
        </div>
                            `;
                            }

                            if (data.tieneGastosAprobados) {

                                await Swal.fire({
                                    icon: "error",
                                    title: "No se puede rechazar",
                                    html: `
                                    <div class="text-start">

                                        <div class="mb-3">
                                            <strong>Proyecto:</strong>
                                            ${data.proyecto}
                                        </div>

                                        <div class="mb-3">
                                            <strong>Período:</strong>
                                            ${periodo}
                                        </div>

                                        <div class="alert alert-danger mb-0">
                                            Este presupuesto posee gastos aprobados
                                            asociados y no puede ser rechazado.
                                        </div>

                                    </div>
                                `,
                                    confirmButtonText: "Entendido",
                                    confirmButtonColor: "#6C757D",
                                    width: 600
                                });

                                return;
                            }

                            const resultado =
                                await Swal.fire({

                                    title: "Rechazar presupuesto",

                                    icon: "warning",

                                    html: `
                                    <div class="text-start">

                                        <div class="mb-3">
                                            <div>
                                                <strong>Proyecto:</strong>
                                                ${data.proyecto}
                                            </div>

                                            <div>
                                                <strong>Período:</strong>
                                                ${periodo}
                                            </div>
                                        </div>

                                        <div class="border rounded p-3">

                                            <div class="d-flex justify-content-between gap-3">
                                                <span>Ingreso planificado:</span>
                                                <strong>
                                                    ${moneda.format(
                                        data.ingresoPlanificado
                                    )}
                                                </strong>
                                            </div>

                                            <div class="d-flex justify-content-between gap-3">
                                                <span>Gasto planificado:</span>
                                                <strong>
                                                    ${moneda.format(
                                        data.gastoPlanificado
                                    )}
                                                </strong>
                                            </div>

                                        </div>

                                        ${avisoIngresos}

                                        <div class="mt-3 fw-semibold">
                                            Indique el motivo del rechazo:
                                        </div>

                                    </div>
                                `,

                                    input: "textarea",

                                    inputPlaceholder:
                                        "Escriba una observación clara y específica...",

                                    inputAttributes: {
                                        maxlength: "500",
                                        "aria-label": "Motivo del rechazo"
                                    },

                                    showCancelButton: true,

                                    confirmButtonText:
                                        '<i class="fas fa-ban me-1"></i> Confirmar rechazo',

                                    cancelButtonText:
                                        '<i class="fas fa-xmark me-1"></i> Cancelar',

                                    confirmButtonColor: "#DC3545",
                                    cancelButtonColor: "#6C757D",

                                    reverseButtons: true,
                                    focusCancel: true,

                                    width: 650,

                                    inputValidator: function (valor) {

                                        const observacion =
                                            (valor || "").trim();

                                        if (!observacion) {
                                            return "Debe indicar el motivo del rechazo.";
                                        }

                                        if (observacion.length > 500) {
                                            return "La observación no puede superar los 500 caracteres.";
                                        }

                                        return null;
                                    }
                                });

                            if (!resultado.isConfirmed) {
                                return;
                            }

                            const observacion =
                                resultado.value.trim();

                            document.getElementById(
                                "rechazoPresupuestoId"
                            ).value = id;

                            document.getElementById(
                                "rechazoObservacion"
                            ).value = observacion;

                            document.getElementById(
                                "formularioRechazoOculto"
                            ).submit();
                        }
                        catch (error) {

                            Swal.fire({
                                icon: "error",
                                title: "No fue posible cargar el resumen",
                                text:
                                    error.message ||
                                    "Intente nuevamente."
                            });
                        }
                        finally {

                            boton.disabled = false;
                        }
                    });
                });

        });
    </script>
}