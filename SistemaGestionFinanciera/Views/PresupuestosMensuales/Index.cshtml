@model IEnumerable<SistemaGestionFinanciera.Models.PresupuestosMensuale>

@{
    ViewData["Title"] = "Presupuesto Mensual";

    var presupuestos = Model?.ToList()
        ?? new List<SistemaGestionFinanciera.Models.PresupuestosMensuale>();

    var totalPresupuestos = presupuestos.Count;

    var totalBorradores = presupuestos.Count(x =>
        x.EstadoAprobacion == "Borrador");

    var totalAprobados = presupuestos.Count(x =>
        x.EstadoAprobacion == "Aprobado");

    var totalRechazados = presupuestos.Count(x =>
        x.EstadoAprobacion == "Rechazado");

    var presupuestosEnAlerta = presupuestos
        .Where(x =>
            (x.SaldoDisponible ?? 0) < 0 ||
            (x.TotalGastoReal ?? 0) >
                (x.MontoGastoPlanificado ?? 0) ||
            (x.TotalIngresoReal ?? 0) <
                (x.MontoIngresadoPlanificado ?? 0))
        .ToList();

    var totalAlertas = presupuestosEnAlerta.Count;

    string rol =
      Context.Session.GetString("Rol") ?? "";

    bool esAdministrador =
        rol == "Administrador";

        bool puedePreparar =
    rol == "Administrador" ||
    rol == "Contador" ||
    rol == "Auxiliar Contable";

    bool puedeRegistrarDirectamente =
     rol == "Administrador" ||
     rol == "Contador";

    bool puedeAprobarRechazar =
        rol == "Administrador";

    bool soloConsulta =
        rol == "Tesorero";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0 fw-bold">Gestionar Presupuesto Mensual</h2>
            <small class="text-muted">
                Control de montos planificados, ejecución real y saldo disponible por proyecto.
            </small>
        </div>

        <div class="d-flex gap-2">

            @if (ViewBag.DesdeProyectos == true)
            {
                <a asp-controller="Proyectos"
                   asp-action="Index"
                   class="btn btn-secondary btn-sistema">
                    <i class="fas fa-arrow-left me-1"></i>
                    Volver a Proyectos
                </a>
            }

            @if (puedeRegistrarDirectamente)
            {
                <a asp-action="Create"
                   class="btn btn-primary">
                    <i class="fas fa-plus-circle me-1"></i>
                    Registrar
                </a>
            }

        </div>
    </div>
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header text-white fw-bold" style="background-color:#0F5C64;">
            Filtros de búsqueda
        </div>
        @*filtros*@
        <div class="card-body">
            <form asp-action="Index"
                  method="get"
                  id="formFiltrosPresupuesto">
                <div class="row g-3">

                    <div class="col-lg-3 col-md-3">
                        <label class="form-label fw-bold"><i class="fas fa-project-diagram text-muted me-1"></i>Proyecto</label>
                        <select name="proyectoId" class="form-select" asp-items="ViewBag.Proyectos">
                            <option value="">Todos</option>
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-2">
                        <label class="form-label fw-bold"><i class="fas fa-calendar-alt text-muted me-1"></i>Año</label>

                        <select name="anio" class="form-select">

                            <option value="">Todos</option>

                            @foreach (var anio in ViewBag.Anios)
                            {
                                if (ViewBag.Anio == anio)
                                {
                                    <option value="@anio" selected>@anio</option>
                                }
                                else
                                {
                                    <option value="@anio">@anio</option>
                                }
                            }

                        </select>
                    </div>

                    <div class="col-lg-2 col-md-2">
                        <label class="form-label fw-bold"><i class="fas fa-calendar text-muted me-1"></i>Mes</label>
                        <select name="mes" class="form-select">
                            <option value="">Todos</option>
                            <option value="1" selected="@(ViewBag.Mes == 1)">Enero</option>
                            <option value="2" selected="@(ViewBag.Mes == 2)">Febrero</option>
                            <option value="3" selected="@(ViewBag.Mes == 3)">Marzo</option>
                            <option value="4" selected="@(ViewBag.Mes == 4)">Abril</option>
                            <option value="5" selected="@(ViewBag.Mes == 5)">Mayo</option>
                            <option value="6" selected="@(ViewBag.Mes == 6)">Junio</option>
                            <option value="7" selected="@(ViewBag.Mes == 7)">Julio</option>
                            <option value="8" selected="@(ViewBag.Mes == 8)">Agosto</option>
                            <option value="9" selected="@(ViewBag.Mes == 9)">Septiembre</option>
                            <option value="10" selected="@(ViewBag.Mes == 10)">Octubre</option>
                            <option value="11" selected="@(ViewBag.Mes == 11)">Noviembre</option>
                            <option value="12" selected="@(ViewBag.Mes == 12)">Diciembre</option>
                        </select>
                    </div>

                    <div class="col-lg-2 col-md-2">
                        <label class="form-label fw-bold"><i class="fas fa-chart-pie text-muted me-1"></i>Estado de ejecución</label>
                        <select name="estado" class="form-select">
                            <option value="">Todos</option>
                            <option value="Sin movimientos" selected="@(ViewBag.Estado == "Sin movimientos")">Sin movimientos</option>
                            <option value="Gasto excedido" selected="@(ViewBag.Estado == "Gasto excedido")">Gasto excedido</option>
                            <option value="Ingresos bajos" selected="@(ViewBag.Estado == "Ingresos bajos")">Ingresos bajos</option>
                            <option value="En ejecución" selected="@(ViewBag.Estado == "En ejecución")">En ejecución</option>
                        </select>
                    </div>
                    <div class="col-lg-3 col-md-2">
                        <label class="form-label fw-bold">
                            <i class="fas fa-check-circle text-muted me-1"></i>Estado de aprobación
                        </label>

                        <select name="estadoAprobacion" class="form-select">
                            <option value="">Todos</option>

                            <option value="Borrador"
                                    selected="@(ViewBag.EstadoAprobacion == "Borrador")">
                                Borrador
                            </option>

                            <option value="Aprobado"
                                    selected="@(ViewBag.EstadoAprobacion == "Aprobado")">
                                Aprobado
                            </option>

                            <option value="Rechazado"
                                    selected="@(ViewBag.EstadoAprobacion == "Rechazado")">
                                Rechazado
                            </option>
                        </select>
                    </div>
                    <div class="col-md-12 d-flex align-items-end">
                    <div class="d-flex gap-2">
                        <button type="submit"
                                class="btn btn-primary btn-sistema px-5 ">
                            <i class="fas fa-search me-1"></i>
                            Buscar
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary btn-sistema px-5">
                            <i class="fas fa-eraser me-1"></i>
                            Limpiar
                        </a>
                        </div>
                        <div class="ms-auto d-flex gap-2">

                            <a asp-action="Reporte"
                               asp-route-proyectoId="@ViewBag.ProyectoId"
                               asp-route-anio="@ViewBag.Anio"
                               asp-route-mes="@ViewBag.Mes"
                               asp-route-estado="@ViewBag.Estado"
                               asp-route-estadoAprobacion="@ViewBag.EstadoAprobacion"
                            
                               class="btn btn-info text-white px-5">
                                <i class="fas fa-eye me-2"></i>
                                Vista previa PDF
                            </a>

                            <a asp-action="ExportarExcel"
                               asp-route-proyectoId="@ViewBag.ProyectoId"
                               asp-route-anio="@ViewBag.Anio"
                               asp-route-mes="@ViewBag.Mes"
                               asp-route-estado="@ViewBag.Estado"
                               asp-route-estadoAprobacion="@ViewBag.EstadoAprobacion"
                               class="btn btn-success px-5">
                                <i class="fas fa-file-excel me-2"></i>
                                Exportar Excel
                            </a>

                          </div>
                        </div>
                </div>
            </form>
        </div>

    </div>
                    @* ============================================================
                    CARDS DINÁMICAS SEGÚN LOS FILTROS APLICADOS
                    ============================================================ *@
                    <div class="row g-3   mb-4">

                        <div class="col-xl col-md-4 col-sm-6">
                            <div class="card shadow-sm card card-resumen border-0 h-100 card-indicador card-total">
                                <div class="card-body d-flex align-items-center">
                                    <div class="icono-indicador me-3">
                                        <i class="fas fa-file-invoice-dollar"></i>
                                    </div>

                                    <div>
                                        <div class="text-muted small fw-semibold">
                                            Total presupuestos
                                        </div>

                                        <div class="fs-3 fw-bold">
                                            @totalPresupuestos
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl col-md-4 col-sm-6">
                            <div class="card shadow-sm card-resumen border-0 h-100 card-indicador card-borrador">
                                <div class="card-body d-flex align-items-center">
                                    <div class="icono-indicador me-3">
                                        <i class="fas fa-file-pen"></i>
                                    </div>

                                    <div>
                                        <div class="text-muted small fw-semibold">
                                            Borradores
                                        </div>

                                        <div class="fs-3 fw-bold">
                                            @totalBorradores
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl col-md-4 col-sm-6">
                            <div class="card shadow-sm card-resumen border-0 h-100 card-indicador card-aprobado">
                                <div class="card-body d-flex align-items-center">
                                    <div class="icono-indicador me-3">
                                        <i class="fas fa-circle-check"></i>
                                    </div>

                                    <div>
                                        <div class="text-muted small fw-semibold">
                                            Aprobados
                                        </div>

                                        <div class="fs-3 fw-bold">
                                            @totalAprobados
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl col-md-4 col-sm-6">
                            <div class="card shadow-sm card-resumen border-0 h-100 card-indicador card-rechazado">
                                <div class="card-body d-flex align-items-center">
                                    <div class="icono-indicador me-3">
                                        <i class="fas fa-circle-xmark"></i>
                                    </div>

                                    <div>
                                        <div class="text-muted small fw-semibold">
                                            Rechazados
                                        </div>

                                        <div class="fs-3 fw-bold">
                                            @totalRechazados
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl col-md-4 col-sm-6">
                            <div class="card shadow-sm card-resumen border-0 h-100 card-indicador card-alerta">
                                <div class="card-body d-flex align-items-center">
                                    <div class="icono-indicador me-3">
                                        <i class="fas fa-triangle-exclamation"></i>
                                    </div>

                                    <div>
                                        <div class="text-muted small fw-semibold">
                            Presupuestos en alerta
                                        </div>

                                        <div class="fs-3 fw-bold">
                                            @totalAlertas
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
    @* ============================================================
    PANEL DESPLEGABLE GENERAL DE ALERTAS
    ============================================================ *@
    @if (presupuestosEnAlerta.Any())
    {
        var alertasOrdenadas = presupuestosEnAlerta
        .OrderBy(x =>
        (x.SaldoDisponible ?? 0) < 0 ? 1 :
        (x.TotalGastoReal ?? 0) >
        (x.MontoGastoPlanificado ?? 0) ? 2 : 3)
        .ThenBy(x => x.SaldoDisponible ?? 0)
        .ToList();

        <div class="accordion mb-4" id="panelGeneralAlertas">
            <div class="accordion-item border-0 shadow-sm">

                <h2 class="accordion-header" id="encabezadoAlertasGenerales">
                    <button class="accordion-button collapsed encabezado-alertas"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#contenidoAlertasGenerales"
                            aria-expanded="false"
                            aria-controls="contenidoAlertasGenerales">

                        <span class="d-flex align-items-center w-100">
                            <i class="fas fa-triangle-exclamation me-2"></i>

                            <span class="fw-bold">
                                Presupuestos que requieren atención
                            </span>

                            <span class="badge bg-light text-danger ms-2">
                                @totalAlertas
                            </span>

                            <small class="ms-auto me-3 text-white-50">
                                Presione para mostrar u ocultar
                            </small>
                        </span>
                    </button>
                </h2>

                <div id="contenidoAlertasGenerales"
                     class="accordion-collapse collapse"
                     aria-labelledby="encabezadoAlertasGenerales"
                     data-bs-parent="#panelGeneralAlertas">

                    <div class="accordion-body p-3">

                        @foreach (var alerta in alertasOrdenadas)
                        {
                            var ingresoPlanificadoAlerta =
                            alerta.MontoIngresadoPlanificado ?? 0;

                            var ingresoRealAlerta =
                            alerta.TotalIngresoReal ?? 0;

                            var gastoPlanificadoAlerta =
                            alerta.MontoGastoPlanificado ?? 0;

                            var gastoRealAlerta =
                            alerta.TotalGastoReal ?? 0;

                            var saldoAlerta =
                            alerta.SaldoDisponible ?? 0;

                            string tipoAlerta;
                            string claseAlerta;
                            string claseBorde;
                            string iconoAlerta;
                            decimal montoAlerta;

                            if (saldoAlerta < 0)
                            {
                                tipoAlerta = "Déficit presupuestario";
                                claseAlerta = "text-danger";
                                claseBorde = "alerta-critica";
                                iconoAlerta = "fas fa-circle-xmark";
                                montoAlerta = Math.Abs(saldoAlerta);
                            }
                            else if (gastoRealAlerta > gastoPlanificadoAlerta)
                            {
                                tipoAlerta = "Gasto superior a lo planificado";
                                claseAlerta = "text-danger";
                                claseBorde = "alerta-gasto";
                                iconoAlerta = "fas fa-arrow-trend-up";
                                montoAlerta =
                                gastoRealAlerta - gastoPlanificadoAlerta;
                            }
                            else
                            {
                                tipoAlerta = "Ingreso inferior a lo planificado";
                                claseAlerta = "texto-alerta-naranja";
                                claseBorde = "alerta-ingreso";
                                iconoAlerta = "fas fa-triangle-exclamation";
                                montoAlerta =
                                ingresoPlanificadoAlerta - ingresoRealAlerta;
                            }

                            string nombreMesAlerta = alerta.Mes switch
                            {
                                1 => "Enero",
                                2 => "Febrero",
                                3 => "Marzo",
                                4 => "Abril",
                                5 => "Mayo",
                                6 => "Junio",
                                7 => "Julio",
                                8 => "Agosto",
                                9 => "Septiembre",
                                10 => "Octubre",
                                11 => "Noviembre",
                                12 => "Diciembre",
                                _ => "No definido"
                            };

                            <div class="alerta-presupuesto @claseBorde mb-3">
                                <div class="row g-3 align-items-center">

                                    <div class="col-xl-3 col-md-6">
                                        <span class="@claseAlerta fw-bold d-block mb-1">
                                            <i class="@iconoAlerta me-1"></i>
                                            @tipoAlerta
                                        </span>

                                        <strong>
                                            @(alerta.Proyecto?.Nombre ?? "Sin proyecto")
                                        </strong>
                                    </div>

                                    <div class="col-xl-2 col-md-3">
                                        <span class="dato-etiqueta">
                                            Periodo
                                        </span>

                                        <strong class="d-block">
                                            @nombreMesAlerta @alerta.Anio
                                        </strong>
                                    </div>

                                    <div class="col-xl-2 col-md-3">
                                        <span class="dato-etiqueta">
                                            Estado de ejecución
                                        </span>

                                        <strong class="d-block">
                                            @alerta.Estado
                                        </strong>
                                    </div>

                                    <div class="col-xl-2 col-md-4">
                                        <span class="dato-etiqueta">
                                            Estado de aprobación
                                        </span>

                                        @if (alerta.EstadoAprobacion == "Aprobado")
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-circle-check me-1"></i>
                                                Aprobado
                                            </span>
                                        }
                                        else if (alerta.EstadoAprobacion == "Rechazado")
                                        {
                                            <span class="badge bg-danger">
                                                <i class="fas fa-circle-xmark me-1"></i>
                                                Rechazado
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="fas fa-file-pen me-1"></i>
                                                Borrador
                                            </span>
                                        }
                                    </div>

                                    <div class="col-xl-2 col-md-4">
                                        <span class="dato-etiqueta">
                                            Monto de alerta
                                        </span>

                                        <strong class="@claseAlerta d-block">
                                            ₡@montoAlerta.ToString("N2")
                                        </strong>
                                    </div>

                                    <div class="col-xl-1 col-md-4 text-md-end">
                                        <button type="button"
                                                class="btn btn-outline-primary btn-sm btn-ver-tabla"
                                                data-id="@alerta.IdPresupuestoMensual"
                                                title="Ubicar el presupuesto en la tabla">
                                            <i class="fas fa-table-list me-1"></i>
                                            Ver en tabla
                                        </button>
                                    </div>

                                </div>
                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>
    }
              
       
    <div class="card shadow-sm border-0">
        <div class="card-header text-white fw-bold" style="background-color:#0F5C64;">
            <i class="fas fa-list-alt me-1"></i>Lista de presupuestos mensuales registrados
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table id="tablaPresupuestos"
                       class="table table-hover align-middle w-100 tabla-sistema">
                <thead>
                    <tr>
                            <th>
                                <i class="fas fa-project-diagram me-1"></i>
                                Proyecto
                            </th>

                            <th>
                                <i class="fas fa-calendar-alt me-1"></i>
                                Año
                            </th>

                            <th>
                                <i class="fas fa-calendar me-1"></i>
                                Mes
                            </th>

                            <th>
                                <i class="fas fa-arrow-circle-up text-success me-1"></i>
                                Ingreso planificado
                            </th>

                            <th>
                                <i class="fas fa-arrow-circle-down text-danger me-1"></i>
                                Gasto planificado
                            </th>

                            <th>
                                <i class="fas fa-hand-holding-usd text-success me-1"></i>
                                Ingreso real
                            </th>

                            <th>
                                <i class="fas fa-money-bill-wave text-danger me-1"></i>
                                Gasto real
                            </th>

                            <th>
                                <i class="fas fa-chart-line text-danger me-1"></i>
                                Diferencia de ingreso
                            </th>

                            <th>
                                <i class="fas fa-wallet text-success me-1"></i>
                                Saldo de gasto
                            </th>

                            <th>
                                <i class="fas fa-balance-scale me-1"></i>
                                Balance real del período
                            </th>

                            <th>
                                <i class="fas fa-chart-pie me-1"></i>
                                Estado de ejecución
                            </th>

                            <th>
                                <i class="fas fa-check-circle me-1"></i>
                                Estado de aprobación
                            </th>

                            <th>
                                <i class="fas fa-comment-dots me-1"></i>
                                Observación
                            </th>

                            <th>
                                <i class="fas fa-exclamation-triangle text-warning me-1"></i>
                                Alertas
                            </th>

                            <th>
                                <i class="fas fa-calendar-plus me-1"></i>
                                Fecha creación
                            </th>

                            <th class="text-center">
                                <i class="fas fa-cogs me-1"></i>
                                Acciones
                            </th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr id="presupuesto-@item.IdPresupuestoMensual"
                                data-presupuesto-id="@item.IdPresupuestoMensual">
                                <td>
                                    @(item.Proyecto != null ? item.Proyecto.Nombre : "Sin proyecto")
                                </td>

                                <td>@item.Anio</td>

                                    <td data-order="@item.Mes">
                                    @{
                                        var nombreMes = item.Mes switch
                                        {
                                            1 => "Enero",
                                            2 => "Febrero",
                                            3 => "Marzo",
                                            4 => "Abril",
                                            5 => "Mayo",
                                            6 => "Junio",
                                            7 => "Julio",
                                            8 => "Agosto",
                                            9 => "Septiembre",
                                            10 => "Octubre",
                                            11 => "Noviembre",
                                            12 => "Diciembre",
                                            _ => "No definido"
                                        };
                                    }
                                    @nombreMes
                                </td>

                                <td>₡@((item.MontoIngresadoPlanificado ?? 0).ToString("N2"))</td>
                                <td>₡@((item.MontoGastoPlanificado ?? 0).ToString("N2"))</td>
                                <td>₡@((item.TotalIngresoReal ?? 0).ToString("N2"))</td>
                                <td>₡@((item.TotalGastoReal ?? 0).ToString("N2"))</td>

                                <td>
                                    @{
                                        var diferenciaIngreso = item.DiferenciaIngreso ?? 0;
                                    }

                                    @if (diferenciaIngreso < 0)
                                    {
                                        <span class="text-danger fw-bold">
                                            ₡@diferenciaIngreso.ToString("N2")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-success fw-bold">
                                            ₡@diferenciaIngreso.ToString("N2")
                                        </span>
                                    }
                                </td>

                                <td>
                                    @{
                                        var diferenciaGasto = item.DiferenciaGasto ?? 0;
                                    }

                                    @if (diferenciaGasto < 0)
                                    {
                                        <span class="text-danger fw-bold">
                                            ₡@diferenciaGasto.ToString("N2")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-success fw-bold">
                                            ₡@diferenciaGasto.ToString("N2")
                                        </span>
                                    }
                                </td>

                                <td>
                                    @{
                                        var saldo = item.SaldoDisponible ?? 0;
                                    }

                                    @if (saldo < 0)
                                    {
                                        <span class="text-danger fw-bold">
                                            ₡@saldo.ToString("N2")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-primary fw-bold">
                                            ₡@saldo.ToString("N2")
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (item.Estado == "Sin movimientos")
                                    {
                                        <span class="badge bg-secondary">Sin movimientos</span>
                                    }
                                    else if (item.Estado == "Gasto excedido")
                                    {
                                        <span class="badge bg-danger">Gasto excedido</span>
                                    }
                                    else if (item.Estado == "Ingresos bajos")
                                    {
                                        <span class="badge bg-warning text-dark">Ingresos bajos</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">En ejecución</span>
                                    }
                                </td>

                                <td class="text-center">
                                    @if (item.EstadoAprobacion == "Borrador")
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="fas fa-file-pen me-1"></i>
                                            Borrador - 
                                        </span>
                                    }
                                    else if (item.EstadoAprobacion == "Aprobado")
                                    {
                                        <span class="badge bg-success">
                                            <i class="fas fa-circle-check me-1"></i>
                                            Aprobado
                                        </span>
                                    }
                                    else if (item.EstadoAprobacion == "Rechazado")
                                    {
                                        <span class="badge bg-danger">
                                            <i class="fas fa-circle-xmark me-1"></i>
                                            Rechazado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark">
                                            Sin definir
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (item.EstadoAprobacion == "Rechazado" &&
                                   !string.IsNullOrWhiteSpace(item.ObservacionRevision))
                                    {
                                        <span class="text-danger small"
                                              title="@item.ObservacionRevision">
                                            <i class="fas fa-comment-dots me-1"></i>

                                            @(item.ObservacionRevision.Length > 45
                                                ? item.ObservacionRevision.Substring(0, 45) + "..."
                                                : item.ObservacionRevision)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-center align-middle">

                                    @{
                                        var ingresoPlanificado = item.MontoIngresadoPlanificado ?? 0;
                                        var ingresoReal = item.TotalIngresoReal ?? 0;
                                        var gastoPlanificado = item.MontoGastoPlanificado ?? 0;
                                        var gastoReal = item.TotalGastoReal ?? 0;
                                        var saldoDisponible = item.SaldoDisponible ?? 0;
                                    }

                                    @if (saldoDisponible < 0)
                                    {
                                        <div class="text-danger small fw-semibold text-center">
                                            <i class="fas fa-times-circle d-block fs-5 mb-1"></i>
                                            Déficit presupuestario
                                        </div>
                                    }
                                    else if (gastoReal > gastoPlanificado)
                                    {
                                        <div class="text-danger small fw-semibold text-center">
                                            <i class="fas fa-arrow-trend-up d-block fs-5 mb-1"></i>
                                            Gasto supera lo planificado
                                        </div>
                                    }
                                    else if (ingresoReal < ingresoPlanificado)
                                    {
                                        <div class="small fw-semibold text-center" style="color:#F97316;">
                                            <i class="fas fa-exclamation-triangle d-block fs-5 mb-1"></i>
                                            Ingreso menor al planificado
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-success small fw-semibold text-center">
                                            <i class="fas fa-circle-check d-block fs-5 mb-1"></i>
                                            Presupuesto controlado
                                        </div>
                                    }

                                </td>
                                <td>
                                    @(item.FechaCreacion.HasValue
                                        ? item.FechaCreacion.Value.ToString("dd/MM/yyyy")
                                        : "Sin fecha")
                                </td>

                                <td class="col-acciones">
                                    <div class="acciones-botones">

                                        <a asp-action="Details"
                                           asp-route-id="@item.IdPresupuestoMensual"
                                           class="btn btn-primary btn-sm btn-accion"
                                           title="Consultar presupuesto">
                                            <i class="fas fa-eye"></i>
                                            Detalles
                                        </a>

                                            @if (puedePreparar &&
                                           item.EstadoAprobacion != "Aprobado")
                                            {
                                                <a asp-action="Edit"
                                                   asp-route-id="@item.IdPresupuestoMensual"
                                                   class="btn btn-warning btn-sm btn-accion">
                                                    <i class="fas fa-pen-to-square"></i>
                                                    Modificar
                                                </a>
                                            }

                                        <a asp-controller="PresupuestosDetalles"
                                           asp-action="Movimientos"
                                           asp-route-id="@item.IdPresupuestoMensual"
                                           asp-route-origen="PresupuestoMensual"
                                           class="btn btn-info btn-sm btn-accion"
                                           title="Consultar movimientos presupuestarios">
                                            <i class="fas fa-list-check"></i>
                                            Movimientos
                                        </a>

                                        @if (puedeAprobarRechazar &&
                                       item.EstadoAprobacion == "Borrador")
                                        {
                                            <form asp-action="Aprobar"
                                                  asp-route-id="@item.IdPresupuestoMensual"
                                                  method="post"
                                                  class="d-inline formulario-aprobar">

                                                @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-success btn-sm btn-accion"
                                                            data-id="@item.IdPresupuestoMensual"
                                                            data-proyecto="@(item.Proyecto?.Nombre ?? "Sin proyecto")"
                                                            data-periodo="@nombreMes @item.Anio"
                                                            title="Aprobar presupuesto">
                                                        <i class="fas fa-circle-check"></i>
                                                        Aprobar
                                                    </button>
                                            </form>

                                            <button type="button"
                                                    class="btn btn-danger btn-sm btn-accion btn-rechazar"
                                                    data-id="@item.IdPresupuestoMensual"
                                                    data-proyecto="@(item.Proyecto?.Nombre ?? "Sin proyecto")"
                                                    data-periodo="@nombreMes @item.Anio"
                                                    title="Rechazar presupuesto">
                                                <i class="fas fa-circle-xmark"></i>
                                                Rechazar
                                            </button>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                <tr id="presupuesto-@item.IdPresupuestoMensual"
                                    data-presupuesto-id="@item.IdPresupuestoMensual">

                                        @* Todas las 16 celdas del registro *@

                                </tr>
                                }
                            }
                    </tbody>
                </tbody>
            </table>
          </div>
            <form asp-action="Rechazar"
                  method="post"
                  id="formularioRechazoOculto"
                  class="d-none">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       id="rechazoPresupuestoId" />

                <input type="hidden"
                       name="observacionRevision"
                       id="rechazoObservacion" />
            </form>
        </div>
    </div>
</div>

