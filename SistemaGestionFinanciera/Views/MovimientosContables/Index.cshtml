@model IEnumerable<SistemaGestionFinanciera.Models.MovimientosContable>

@{
    ViewData["Title"] = "Movimientos contables";

    bool filtroAplicado =
       !string.IsNullOrWhiteSpace(ViewBag.Buscar as string) ||
       ViewBag.CuentaContableId != null ||
       !string.IsNullOrWhiteSpace(ViewBag.TipoMovimiento as string) ||
       !string.IsNullOrWhiteSpace(ViewBag.OrigenModulo as string) ||
       ViewBag.ProyectoId != null ||
       ViewBag.CentroCostoId != null ||
       !string.IsNullOrWhiteSpace(ViewBag.Estado as string) ||
       ViewBag.Anio != null ||
       ViewBag.Mes != null ||
       !string.IsNullOrWhiteSpace(ViewBag.Desde as string) ||
       !string.IsNullOrWhiteSpace(ViewBag.Hasta as string);

    string textoConsulta = filtroAplicado
        ? "Filtro aplicado"
        : "Acumulado";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold mb-0">Movimientos Contables</h2>
            <small class="text-muted">
                Consulta automática de movimientos financieros generados desde ingresos, gastos, facturas, CxC y CxP
            </small>
        </div>

        <div class="text-end">
            <small class="text-muted">Última sincronización</small><br />
            <span class="badge bg-dark">
                @(ViewBag.UltimaSincronizacion != null
                    ? ((DateTime)ViewBag.UltimaSincronizacion).ToString("dd/MM/yyyy HH:mm")
                    : "Sin movimientos")
            </span>
        </div>
    </div>
    @if ((ViewBag.Origen as string) == "CierreContable")
    {
        <div class="mb-3 text-end ">
            <a asp-controller="CierresContables"
               asp-action="Index"
               asp-route-anio="@ViewBag.Anio"
               asp-route-mes="@(ViewBag.Mes ?? 0)"
               class="btn btn-secondary text-end ">

                <i class="fas fa-arrow-left me-1"></i>
                Volver a Cierre Contable
            </a>
        </div>
    }
    <div class="d-flex align-items-center mb-2">
        <small class="fw-bold text-muted">
            <i class="fas fa-exchange-alt me-1"></i>
            Resumen de movimientos consultados
        </small>
    </div>
    <!--PRIMER BLOQUE DE CARDS -->


    <div class="row g-3 mb-3">

        <div class="col-xl-3 col-md-6">
            <div class="card shadow-sm border-0 card-resumen border-start border-4 border-primary h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <small class="fw-bold mb-1">Total debe</small>

                        <div class="text-muted small">
                            @textoConsulta
                        </div>

                        <h5 class="text-primary fw-bold mb-0 mt-1">
                            ₡@String.Format("{0:N2}", ViewBag.TotalDebe)
                        </h5>
                    </div>

                    <i class="fas fa-arrow-down fa-2x icono-card"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card shadow-sm card-resumen border-0 border-start border-4 border-success h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <small class="fw-bold mb-1">Total haber</small>

                        <div class="text-muted small">
                            @textoConsulta
                        </div>

                        <h5 class="text-success fw-bold mb-0 mt-1">
                            ₡@String.Format("{0:N2}", ViewBag.TotalHaber)
                        </h5>
                    </div>

                    <i class="fas fa-arrow-up fa-2x icono-card"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-6">
            <div class="card shadow-sm  border-0 card-resumen border-start border-4 border-warning h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <small class="fw-bold mb-1">
                            Diferencia Debe/Haber
                        </small>

                        <div class="text-muted small">
                            @textoConsulta
                        </div>

                        <h5 class="text-warning fw-bold mb-0 mt-1">
                            ₡@String.Format("{0:N2}", ViewBag.Diferencia)
                        </h5>
                    </div>

                    <i class="fas fa-balance-scale fa-2x icono-card"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-6">
            <div class="card shadow-sm card-resumen border-0 border-start border-4 border-orange h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <small class="fw-bold mb-1">Movimientos</small>

                        <div class="text-muted small">
                            @textoConsulta
                        </div>

                        <h5 class="fw-bold mb-0 mt-1">
                            @ViewBag.TotalMovimientos
                        </h5>
                    </div>

                    <i class="fas fa-exchange-alt fa-2x icono-card"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-6">
            <div class="card shadow-sm card-resumen  border-0 border-start border-4 border-danger h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <small class="fw-bold mb-1">Anulados</small>

                        <div class="text-muted small">
                            @textoConsulta
                        </div>

                        <h5 class="text-danger fw-bold mb-0 mt-1">
                            @ViewBag.TotalAnulados
                        </h5>
                    </div>

                    <i class="fas fa-ban fa-2x icono-card"></i>
                </div>
            </div>
        </div>

    </div>

    <div class="d-flex align-items-center mb-2">
        <small class="fw-bold text-muted">
            <i class="fas fa-chart-pie me-1"></i>
            Resumen financiero general acumulado
        </small>
    </div>
    <!--SEGUNDO BLOQUE DE CARDS -->
    <div class="row g-3 mb-3">

        <div class="col-xl-2 col-md-4">
            <div class="card shadow-sm border-0 border-start border-4 border-primary h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <small class="fw-bold  mb-1">Activos</small>
                        <div class="text-muted small">
                            Acumulado general
                        </div>
                        <h6 class="fw-bold mb-0 mt-1">
                            ₡@String.Format("{0:N2}", ViewBag.TotalActivos)
                        </h6>
                    </div>

                    <i class="fas fa-building-columns fa-2x icono-card"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4">
            <div class="card shadow-sm border-0 border-start border-4 border-warning h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <small class="fw-bold  mb-1">Pasivos</small>
                        <div class="text-muted small">
                            Acumulado general
                        </div>
                        <h6 class="txt- fw-bold mb-0 mt-1">
                            ₡@String.Format("{0:N2}", ViewBag.TotalPasivos)
                        </h6>
                    </div>

                    <i class="fas fa-file-invoice-dollar fa-2x icono-card"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4">
            <div class="card shadow-sm border-0 border-start border-4 border-info h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <small class="fw-bold  mb-1">Patrimonio</small>
                        <div class="text-muted small">
                            Acumulado general
                        </div>
                        <h6 class=" text-info fw-bold mb-0 mt-1">
                            ₡@String.Format("{0:N2}", ViewBag.TotalPatrimonio)
                        </h6>
                    </div>

                    <i class="fas fa-landmark fa-2x icono-card"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4">
            <div class="card shadow-sm border-0 border-start border-4 border-success h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <small class="fw-bold  mb-1">Ingresos</small>
                        <div class="text-muted small">
                            Acumulado general
                        </div>
                        <h6 class="text-success fw-bold mb-0 mt-1">
                            ₡@String.Format("{0:N2}", ViewBag.TotalIngresos)
                        </h6>
                    </div>

                    <i class="fas fa-hand-holding-dollar fa-2x icono-card"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4">
            <div class="card shadow-sm border-0 border-start border-4 border-danger h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <small class="fw-bold  mb-1">Gastos</small>
                        <div class="text-muted small">
                            Acumulado general
                        </div>
                        <h6 class="text-danger fw-bold mb-0 mt-1">
                            ₡@String.Format("{0:N2}", ViewBag.TotalGastos)
                        </h6>
                    </div>

                    <i class="fas fa-money-bill-wave fa-2x icono-card"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4">
            <div class="card shadow-sm border-0 border-start border-4 border-info h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <small class="fw-bold  mb-1">Resultado</small>
                        <div class="text-muted small">
                            Acumulado general
                        </div>
                        <h6 class="text-primary fw-bold mb-0 mt-1">
                            ₡@String.Format("{0:N2}", ViewBag.ResultadoPeriodo)
                        </h6>
                    </div>

                    <i class="fas fa-chart-line fa-2x icono-card"></i>
                </div>
            </div>
        </div>

    </div>
    <!--FILTROS -->
    <div class="card shadow-sm mb-3">
        <div class="card-header text-white fw-bold"
             style="background-color:#0F5C64;">
            <i class="fas fa-filter me-2"></i>
            Filtros de búsqueda
        </div>

        <div class="card-body">
            <form asp-action="Index" method="get" id="formFiltrosMovimientos">
                <div class="row g-2">

                    <div class="col-md-2">
                        <label class="form-label fw-bold"><i class="fas fa-search text-muted me-1"></i> Buscar</label>
                        <input type="text"
                               name="buscar"
                               value="@ViewBag.Buscar"
                               class="form-control"
                               placeholder="Descripción, referencia, cuenta..." />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-bold"><i class="fas fa-book text-muted me-1"></i>Cuenta contable</label>
                        <select name="cuentaContableId"  class="form-select filtro-automatico">
                            <option value="">Todas</option>
                            @foreach (var cuenta in ViewBag.CuentasContables)
                            {
                                <option value="@cuenta.IdCuentaContable" selected="@(ViewBag.CuentaContableId == cuenta.IdCuentaContable)">
                                    @cuenta.Codigo - @cuenta.Nombre
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold"><i class="fas fa-project-diagram text-muted me-1"></i>Proyecto</label>
                        <select name="proyectoId" class="form-select filtro-automatico" >
                            <option value="">Todos</option>
                            @foreach (var proyecto in ViewBag.Proyectos)
                            {
                                <option value="@proyecto.IdProyecto" selected="@(ViewBag.ProyectoId == proyecto.IdProyecto)">
                                    @proyecto.Nombre
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-bold"><i class="fas fa-building text-muted me-1"></i> Centro de costo</label>
                        <select name="centroCostoId" class="form-select filtro-automatico">
                            <option value="">Todos</option>
                            @foreach (var centro in ViewBag.CentrosCosto)
                            {
                                <option value="@centro.IdCentroCosto" selected="@(ViewBag.CentroCostoId == centro.IdCentroCosto)">
                                    @centro.Nombre
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-1">
                        <label class="form-label fw-bold"> <i class="fas fa-tags text-muted me-1"></i>Tipo</label>
                        <select name="tipoMovimiento" class="form-select filtro-automatico" >
                            <option value="">Todos</option>
                            <option value="Debe" selected="@(ViewBag.TipoMovimiento == "Debe")">Debe</option>
                            <option value="Haber" selected="@(ViewBag.TipoMovimiento == "Haber")">Haber</option>
                        </select>
                    </div>

                    <div class="col-md-1">
                        <label class="form-label fw-bold"><i class="fas fa-random text-muted me-1"></i>Origen</label>
                        <select name="origenModulo" class="form-select filtro-automatico">
                            <option value="">Todos</option>
                            <option value="Ingresos" selected="@(ViewBag.OrigenModulo == "Ingresos")">Ingresos</option>
                            <option value="Gastos" selected="@(ViewBag.OrigenModulo == "Gastos")">Gastos</option>
                            <option value="Facturas" selected="@(ViewBag.OrigenModulo == "Facturas")">Facturas</option>
                            <option value="Pagos CxC" selected="@(ViewBag.OrigenModulo == "Pagos CxC")">Pagos CxC</option>
                            <option value="Pagos CxP" selected="@(ViewBag.OrigenModulo == "Pagos CxP")">Pagos CxP</option>
                        </select>
                    </div>

                    <div class="col-md-1">
                        <label class="form-label fw-bold"> <i class="fas fa-info-circle text-muted me-1"></i>Estado</label>
                        <select name="estado" class="form-select filtro-automatico">
                            <option value="">Todos</option>
                            <option value="Registrado" selected="@(ViewBag.Estado == "Registrado")">Registrado</option>
                            <option value="Anulado" selected="@(ViewBag.Estado == "Anulado")">Anulado</option>
                            <option value="Reversado" selected="@(ViewBag.Estado == "Reversado")">
                                Reversado
                            </option>
                        </select>
                    </div>

                    <div class="col-md-1">
                        <label class="form-label fw-bold"> <i class="fas fa-calendar-alt text-muted me-1"></i>Año</label>
                        <input type="number" name="anio" value="@ViewBag.Anio" class="form-control" placeholder="2026" />
                    </div>

                    <div class="col-md-1">
                        <label class="form-label fw-bold"> <i class="fas fa-calendar text-muted me-1"></i>Mes</label>
                        <select name="mes" class="form-select filtro-automatico ">
                            <option value="">Todos</option>
                            <option value="1" selected="@(ViewBag.Mes == 1)">Enero</option>
                            <option value="2" selected="@(ViewBag.Mes == 2)">Febrero</option>
                            <option value="3" selected="@(ViewBag.Mes == 3)">Marzo</option>
                            <option value="4" selected="@(ViewBag.Mes == 4)">Abril</option>
                            <option value="5" selected="@(ViewBag.Mes == 5)">Mayo</option>
                            <option value="6" selected="@(ViewBag.Mes == 6)">Junio</option>
                            <option value="7" selected="@(ViewBag.Mes == 7)">Julio</option>
                            <option value="8" selected="@(ViewBag.Mes == 8)">Agosto</option>
                            <option value="9" selected="@(ViewBag.Mes == 9)">Setiembre</option>
                            <option value="10" selected="@(ViewBag.Mes == 10)">Octubre</option>
                            <option value="11" selected="@(ViewBag.Mes == 11)">Noviembre</option>
                            <option value="12" selected="@(ViewBag.Mes == 12)">Diciembre</option>
                        </select>
                    </div>

                   

                    <div class="col-md-2">
                        <label class="form-label fw-bold"> <i class="fas fa-calendar-check text-muted me-1"></i> Desde</label>
                        <input type="date" name="desde" value="@ViewBag.Desde" class="form-control" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-bold"> <i class="fas fa-calendar-times text-muted me-1"></i>Hasta</label>
                        <input type="date" name="hasta" value="@ViewBag.Hasta" class="form-control" />
                    </div>

                    <div class="col-md-6 d-flex align-items-end ">
                        <div class="d-flex gap-2">
                        <button type="submit"
                                class="btn btn-primary px-5 btn-filtro">
                            <i class="fas fa-search me-1"></i>
                            Buscar
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary px-5 btn-filtro">
                            <i class="fas fa-eraser me-1"></i>
                            Limpiar
                        </a>
                    </div>
                    <div class="ms-auto d-flex gap-2">

                            <a asp-action="Reporte"
                               asp-route-buscar="@ViewBag.Buscar"
                               asp-route-cuentaContableId="@ViewBag.CuentaContableId"
                               asp-route-tipoMovimiento="@ViewBag.TipoMovimiento"
                               asp-route-origenModulo="@ViewBag.OrigenModulo"
                               asp-route-proyectoId="@ViewBag.ProyectoId"
                               asp-route-centroCostoId="@ViewBag.CentroCostoId"
                               asp-route-estado="@ViewBag.Estado"
                               asp-route-anio="@ViewBag.Anio"
                               asp-route-mes="@ViewBag.Mes"
                               asp-route-desde="@ViewBag.Desde"
                               asp-route-hasta="@ViewBag.Hasta"
                           class="btn btn-info ms-auto">
                                <i class="fas fa-file-pdf me-1"></i>
                                Vista previa PDF
                            </a>

                            <a asp-action="ExportarExcel"
                               asp-route-buscar="@ViewBag.Buscar"
                               asp-route-cuentaContableId="@ViewBag.CuentaContableId"
                               asp-route-tipoMovimiento="@ViewBag.TipoMovimiento"
                               asp-route-origenModulo="@ViewBag.OrigenModulo"
                               asp-route-proyectoId="@ViewBag.ProyectoId"
                               asp-route-centroCostoId="@ViewBag.CentroCostoId"
                               asp-route-estado="@ViewBag.Estado"
                               asp-route-anio="@ViewBag.Anio"
                               asp-route-mes="@ViewBag.Mes"
                               asp-route-desde="@ViewBag.Desde"
                               asp-route-hasta="@ViewBag.Hasta"
                               class="btn btn-success">
                                <i class="fas fa-file-excel me-1"></i>
                                Exportar Excel
                            </a>

                       
                    </div>

                </div>
            </form>
            

        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header text-white fw-bold"
             style="background-color:#0F5C64;">
            <i class="fas fa-book-open me-2"></i>
            Lista de movimientos contables
        </div>

        <div class="card-body">
            <div class="table-responsive">
           
                <table id="tablaMovimientosContables" class="table table-hover align-middle w-100 tabla-sistema">
                    <thead>
                        <tr>
                            <th>
                                <i class="fas fa-calendar-alt me-1"></i>
                                Fecha
                            </th>

                            <th>
                                <i class="fas fa-book me-1"></i>
                                Cuenta
                            </th>

                            <th>
                                <i class="fas fa-exchange-alt me-1"></i>
                                Tipo
                            </th>

                            <th>
                                <i class="fas fa-sitemap me-1"></i>
                                Origen
                            </th>

                            <th>
                                <i class="fas fa-hashtag me-1"></i>
                                Referencia
                            </th>

                            <th>
                                <i class="fas fa-project-diagram me-1"></i>
                                Proyecto
                            </th>

                            <th>
                                <i class="fas fa-building me-1"></i>
                                Centro de costo
                            </th>

                            <th class="text-end">
                                <i class="fas fa-arrow-down me-1"></i>
                                Debe
                            </th>

                            <th class="text-end">
                                <i class="fas fa-arrow-up me-1"></i>
                                Haber
                            </th>

                            <th class="text-center">
                                <i class="fas fa-info-circle me-1"></i>
                                Estado
                            </th>

                            <th>
                                <i class="fas fa-user me-1"></i>
                                Usuario
                            </th>

                            <th class="text-center">
                                <i class="fas fa-cogs me-1"></i>
                                Acciones
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            var claseTipo = item.TipoMovimiento switch
                            {
                                "Debe" => "bg-primary",
                                "Haber" => "bg-success",
                                "Ingreso" => "bg-success",
                                "Gasto" => "bg-danger",
                                "Cobro" => "bg-primary",
                                "Pago" => "bg-warning text-dark",
                                "Ajuste" => "bg-info text-dark",
                                "Reversión" => "bg-secondary",
                                _ => "bg-dark"
                            };

                            <tr>
                                <td data-order="@item.Fecha.ToString("yyyy-MM-dd")">
                                    @item.Fecha.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    <strong>@item.CuentaContable?.Codigo</strong><br />
                                    <small>@item.CuentaContable?.Nombre</small>
                                </td>

                                <td>
                                    <span class="badge @claseTipo">
                                        @item.TipoMovimiento
                                    </span>
                                </td>

                                <td>@(item.OrigenModulo ?? "Sin origen")</td>

                                <td>@(item.Referencia ?? "Sin referencia")</td>

                                <td>@(item.Proyecto?.Nombre ?? "Sin proyecto")</td>

                                <td>@(item.CentroCosto?.Nombre ?? "Sin centro")</td>

                                <td class="text-end text-primary">
                                    ₡@item.Debe.ToString("N2")
                                </td>

                                <td class="text-end text-success">
                                    ₡@item.Haber.ToString("N2")
                                </td>

                                <td class="text-center">
                                    @if (item.Anulado == true || item.Estado == "Anulado")
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="fas fa-ban me-1"></i>
                                            Anulado
                                        </span>
                                    }
                                    else if (item.TipoMovimiento == "Reversión")
                                    {
                                        <span class="badge bg-primary">
                                            <i class="fas fa-undo me-1"></i>
                                            Reversión
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            <i class="fas fa-check-circle me-1"></i>
                                            Registrado
                                        </span>
                                    }
                                </td>

                                <td>@(item.Usuario?.Nombre ?? "Sistema")</td>

                                <td class="col-acciones">
                                    <div class="acciones-botones">
                                        <a asp-action="Details"
                                           asp-route-id="@item.IdMovimientoContable"
                                           class="btn btn-primary btn-sm btn-accion">
                                            <i class="fas fa-eye"></i>
                                            Detalles
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                    @if (Model.Any())
                    {
                        <tfoot>
                            <tr class="fw-bold">
                                <td colspan="7" class="text-end">Totales del listado:</td>
                                <td class="text-end text-primary">₡@String.Format("{0:N2}", ViewBag.TotalDebe)</td>
                                <td class="text-end text-success">₡@String.Format("{0:N2}", ViewBag.TotalHaber)</td>
                                <td colspan="3" class="text-end">
                                    Diferencia Debe/Haber:
                                    ₡@String.Format("{0:N2}", ViewBag.Diferencia)
                                </td>
                            </tr>
                        </tfoot>
                    }
