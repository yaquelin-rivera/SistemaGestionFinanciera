@section Scripts {

    <script>
        $(document).ready(function () {

            const tabla = $('#tablaMovimientosContables');

            if ($.fn.DataTable.isDataTable('#tablaMovimientosContables')) {
                tabla.DataTable().destroy();
            }

            tabla.DataTable({
                pageLength: 10,

                lengthMenu: [
                    [10, 25, 50, 100],
                    [10, 25, 50, 100]
                ],

                order: [[0, 'desc']],

                autoWidth: false,
                responsive: false,

                columnDefs: [
                    {
                        targets: [11],
                        orderable: false,
                        searchable: false
                    }
                ],

                language: {
                    emptyTable: 'No hay movimientos contables para mostrar.',
                    info: 'Mostrando _START_ a _END_ de _TOTAL_ movimientos',
                    infoEmpty: 'Mostrando 0 a 0 de 0 movimientos',
                    infoFiltered: '(filtrado de _MAX_ movimientos totales)',
                    lengthMenu: 'Mostrar _MENU_ movimientos',
                    loadingRecords: 'Cargando...',
                    processing: 'Procesando...',
                    search: 'Buscar:',
                    searchPlaceholder: 'Buscar movimiento...',
                    zeroRecords: 'No se encontraron movimientos.',
                    paginate: {
                        first: 'Primero',
                        last: 'Último',
                        next: 'Siguiente',
                        previous: 'Anterior'
                    }
                }
            });


            let enviandoFormulario = false;

            $('.filtro-automatico').on('change', function () {

                if (enviandoFormulario) {
                    return;
                }

                const desde = $('input[name="desde"]').val();
                const hasta = $('input[name="hasta"]').val();

                if (desde && hasta && desde > hasta) {

                    Swal.fire({
                        icon: 'warning',
                        title: 'Rango de fechas inválido',
                        text: 'La fecha desde no puede ser mayor que la fecha hasta.',
                        confirmButtonText: 'Entendido'
                    });

                    return;
                }

                enviandoFormulario = true;

                $('#formFiltrosMovimientos').trigger('submit');
            });

        });
    </script>
}           