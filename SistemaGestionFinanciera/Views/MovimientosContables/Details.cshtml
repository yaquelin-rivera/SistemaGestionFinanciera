@model SistemaGestionFinanciera.Models.MovimientosContable

@{
    ViewData["Title"] = "Detalle de Movimiento Contable";

    var claseTipo = Model.TipoMovimiento switch
    {
        "Debe" => "bg-primary",
        "Haber" => "bg-success",
        "Ingreso" => "bg-success",
        "Gasto" => "bg-danger",
        "Cobro" => "bg-primary",
        "Pago" => "bg-warning text-dark",
        "Ajuste" => "bg-info text-dark",
        "Reversión" => "bg-secondary",
        _ => "bg-dark"
    };
}

<div class="container-fluid mt-4">

    <!-- =====================================================
         ENCABEZADO
    ====================================================== -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h2 class="fw-bold mb-0">
                Detalle de Movimiento Contable
            </h2>

            <small class="text-muted">
                Consulta detallada del movimiento generado automáticamente por el sistema
            </small>
        </div>

        <div>
            @if (ViewBag.VolverDetalleCuenta == true &&
            ViewBag.CuentaContableId != null)
            {
                <a asp-controller="CuentasContables"
                   asp-action="Details"
                   asp-route-id="@ViewBag.CuentaContableId"
                   class="btn btn-secondary">

                    <i class="fas fa-arrow-left me-1"></i>
                    Volver a detalle de cuenta
                </a>
            }
            else if ((ViewBag.VolverLibroMayor == true ||
            ViewBag.OrigenVista == "LibroMayor") &&
            ViewBag.CuentaContableId != null)
            {
                <a asp-controller="CuentasContables"
                   asp-action="LibroMayor"
                   asp-route-id="@ViewBag.CuentaContableId"
                   class="btn btn-secondary">

                    <i class="fas fa-arrow-left me-1"></i>
                    Volver al Libro Mayor
                </a>
            }
            else
            {
                <a asp-action="Index"
                   class="btn btn-secondary">

                    <i class="fas fa-arrow-left me-1"></i>
                    Volver al listado
                </a>
            }
        </div>

    </div>


    <!-- =====================================================
         INFORMACIÓN GENERAL
    ====================================================== -->
    <div class="card shadow-sm mb-3">

        <div class="card-header text-white fw-bold"
             style="background-color:#0F5C64;">

            <i class="fas fa-info-circle me-2"></i>
            Información general
        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-xl-3 col-md-6">
                    <div class="d-flex align-items-center">

                        <i class="fas fa-calendar-alt icono-detalle me-3"></i>

                        <div>
                            <small class="text-muted d-block">
                                Fecha
                            </small>

                            <strong>
                                @Model.Fecha.ToString("dd/MM/yyyy")
                            </strong>
                        </div>

                    </div>
                </div>


                <div class="col-xl-3 col-md-6">
                    <div class="d-flex align-items-center">

                        <i class="fas fa-exchange-alt icono-detalle me-3"></i>

                        <div>
                            <small class="text-muted d-block">
                                Tipo de movimiento
                            </small>

                            <span class="badge @claseTipo">
                                @Model.TipoMovimiento
                            </span>
                        </div>

                    </div>
                </div>


                <div class="col-xl-3 col-md-6">
                    <div class="d-flex align-items-center">

                        <i class="fas fa-info-circle icono-detalle me-3"></i>

                        <div>
                            <small class="text-muted d-block">
                                Estado
                            </small>

                            @if (Model.Anulado == true ||
                            Model.Estado == "Anulado")
                            {
                                <span class="badge bg-secondary">
                                    <i class="fas fa-ban me-1"></i>
                                    Anulado
                                </span>
                            }
                            else if (Model.TipoMovimiento == "Reversión")
                            {
                                <span class="badge bg-primary">
                                    <i class="fas fa-undo me-1"></i>
                                    Reversión
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    <i class="fas fa-check-circle me-1"></i>
                                    Registrado
                                </span>
                            }
                        </div>

                    </div>
                </div>


                <div class="col-xl-3 col-md-6">
                    <div class="d-flex align-items-center">

                        <i class="fas fa-cog icono-detalle me-3"></i>

                        <div>
                            <small class="text-muted d-block">
                                Generación automática
                            </small>

                            @if (Model.EsAutomatico)
                            {
                                <span class="badge bg-success">
                                    <i class="fas fa-check me-1"></i>
                                    Sí
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    <i class="fas fa-times me-1"></i>
                                    No
                                </span>
                            }
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>


    <!-- =====================================================
         CUENTA Y CLASIFICACIÓN CONTABLE
    ====================================================== -->
    <div class="card shadow-sm mb-3">

        <div class="card-header text-white fw-bold"
             style="background-color:#0F5C64;">

            <i class="fas fa-book me-2"></i>
            Cuenta y clasificación contable
        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-4">
                    <div class="d-flex align-items-start">

                        <i class="fas fa-file-invoice-dollar icono-detalle me-3"></i>

                        <div>
                            <small class="text-muted d-block">
                                Cuenta contable
                            </small>

                            <strong class="d-block">
                                @Model.CuentaContable?.Codigo
                            </strong>

                            <span>
                                @(Model.CuentaContable?.Nombre ?? "Sin cuenta")
                            </span>
                        </div>

                    </div>
                </div>


                <div class="col-md-4">
                    <div class="d-flex align-items-start">

                        <i class="fas fa-project-diagram icono-detalle me-3"></i>

                        <div>
                            <small class="text-muted d-block">
                                Proyecto
                            </small>

                            <strong>
                                @(Model.Proyecto?.Nombre ?? "Sin proyecto")
                            </strong>
                        </div>

                    </div>
                </div>


                <div class="col-md-4">
                    <div class="d-flex align-items-start">

                        <i class="fas fa-building icono-detalle me-3"></i>

                        <div>
                            <small class="text-muted d-block">
                                Centro de costo
                            </small>

                            <strong>
                                @(Model.CentroCosto?.Nombre ?? "Sin centro de costo")
                            </strong>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>


    <!-- =====================================================
         MONTOS CONTABLES
    ====================================================== -->
    <div class="card shadow-sm mb-3">

        <div class="card-header text-white fw-bold"
             style="background-color:#0F5C64;">

            <i class="fas fa-coins me-2"></i>
            Montos contables
        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">
                    <div class="card border-0 border-start border-4 border-dark shadow-sm h-100">

                        <div class="card-body d-flex justify-content-between align-items-center">

                            <div>
                                <small class="text-muted fw-semibold">
                                    Monto
                                </small>

                                <h5 class="fw-bold mb-0 mt-1">
                                    ₡@Model.Monto.ToString("N2")
                                </h5>
                            </div>

                            <i class="fas fa-wallet fa-2x icono-card"></i>
                        </div>

                    </div>
                </div>


                <div class="col-md-4">
                    <div class="card border-0 border-start border-4 border-primary shadow-sm h-100">

                        <div class="card-body d-flex justify-content-between align-items-center">

                            <div>
                                <small class="text-muted fw-semibold">
                                    Debe
                                </small>

                                <h5 class="fw-bold text-primary mb-0 mt-1">
                                    ₡@Model.Debe.ToString("N2")
                                </h5>
                            </div>

                            <i class="fas fa-arrow-down fa-2x icono-card"></i>
                        </div>

                    </div>
                </div>


                <div class="col-md-4">
                    <div class="card border-0 border-start border-4 border-success shadow-sm h-100">

                        <div class="card-body d-flex justify-content-between align-items-center">

                            <div>
                                <small class="text-muted fw-semibold">
                                    Haber
                                </small>

                                <h5 class="fw-bold text-success mb-0 mt-1">
                                    ₡@Model.Haber.ToString("N2")
                                </h5>
                            </div>

                            <i class="fas fa-arrow-up fa-2x icono-card"></i>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>


    <!-- =====================================================
         ORIGEN Y TRAZABILIDAD
    ====================================================== -->
    <div class="card shadow-sm mb-3">

        <div class="card-header text-white fw-bold"
             style="background-color:#0F5C64;">

            <i class="fas fa-route me-2"></i>
            Origen y trazabilidad
        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-xl-3 col-md-6">
                    <div class="dato-detalle">

                        <small class="text-muted d-block">
                            <i class="fas fa-sitemap me-1"></i>
                            Módulo origen
                        </small>

                        <strong>
                            @(Model.OrigenModulo ?? "Sin origen")
                        </strong>

                    </div>
                </div>


                <div class="col-xl-3 col-md-6">
                    <div class="dato-detalle">

                        <small class="text-muted d-block">
                            <i class="fas fa-fingerprint me-1"></i>
                            ID origen
                        </small>

                        <strong>
                            @(Model.OrigenId?.ToString() ?? "Sin ID")
                        </strong>

                    </div>
                </div>


                <div class="col-xl-3 col-md-6">
                    <div class="dato-detalle">

                        <small class="text-muted d-block">
                            <i class="fas fa-hashtag me-1"></i>
                            Referencia
                        </small>

                        <strong>
                            @(Model.Referencia ?? "Sin referencia")
                        </strong>

                    </div>
                </div>


                <div class="col-xl-3 col-md-6">
                    <div class="dato-detalle">

                        <small class="text-muted d-block">
                            <i class="fas fa-user me-1"></i>
                            Usuario
                        </small>

                        <strong>
                            @(Model.Usuario?.Nombre ?? "Sistema")
                        </strong>

                    </div>
                </div>


                <div class="col-md-6">
                    <div class="dato-detalle">

                        <small class="text-muted d-block">
                            <i class="fas fa-clock me-1"></i>
                            Fecha de creación
                        </small>

                        <strong>
                            @(Model.FechaCreacion?.ToString("dd/MM/yyyy HH:mm")
                                ?? "Sin fecha")
                        </strong>

                    </div>
                </div>


                <div class="col-md-6">
                    <div class="dato-detalle">

                        <small class="text-muted d-block">
                            <i class="fas fa-undo me-1"></i>
                            Movimiento de reversión
                        </small>

                        @if (Model.MovimientoReversionId != null)
                        {
                            <span class="badge bg-info text-dark">

                                <i class="fas fa-link me-1"></i>

                                Reversión del movimiento
                                #@Model.MovimientoReversionId
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">
                                No aplica
                            </span>
                        }

                    </div>
                </div>


                <div class="col-12">

                    <small class="text-muted d-block mb-2">
                        <i class="fas fa-align-left me-1"></i>
                        Descripción
                    </small>

                    <div class="descripcion-movimiento">
                        @(Model.Descripcion ?? "Sin descripción")
                    </div>

                </div>

            </div>
        </div>
    </div>


    <!-- =====================================================
         INFORMACIÓN DE ANULACIÓN
    ====================================================== -->
    @if (Model.Anulado == true || Model.Estado == "Anulado")
    {
        <div class="card shadow-sm mb-3 border-secondary">

            <div class="card-header bg-secondary text-white fw-bold">

                <i class="fas fa-ban me-2"></i>
                Información de anulación
            </div>

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-4">
                        <small class="text-muted d-block">
                            <i class="fas fa-calendar-times me-1"></i>
                            Fecha de anulación
                        </small>

                        <strong>
                            @(Model.FechaAnulacion?.ToString("dd/MM/yyyy HH:mm")
                                ?? "Sin fecha")
                        </strong>
                    </div>


                    <div class="col-md-8">
                        <small class="text-muted d-block">
                            <i class="fas fa-comment-alt me-1"></i>
                            Motivo
                        </small>

                        <strong>
                            @(Model.MotivoAnulacion
                                ?? "Sin motivo registrado")
                        </strong>
                    </div>

                </div>
            </div>
        </div>
    }

</div>


<style>
    .icono-card {
        color: rgba(108, 117, 125, 0.50);
    }

    .icono-detalle {
        width: 30px;
        text-align: center;
        font-size: 1.25rem;
        color: rgba(108, 117, 125, 0.75);
    }

    .dato-detalle {
        min-height: 55px;
    }

    .descripcion-movimiento {
        padding: 14px 16px;
        border: 1px solid #d9e2e5;
        border-radius: 6px;
        background-color: #f8f9fa;
        line-height: 1.5;
    }
</style>