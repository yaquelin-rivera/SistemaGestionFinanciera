@model IEnumerable<SistemaGestionFinanciera.Models.Usuario>

@{
    ViewData["Title"] = "Usuarios";

    var totalUsuarios = Model.Count();
    var usuariosActivos = Model.Count(u => u.Activo);
    var usuariosInactivos = Model.Count(u => !u.Activo);
    var administradores = Model.Count(u => u.Rol != null && u.Rol.Nombre == "Administrador");

   
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Gestión de Usuarios</h2>
            <small class="text-muted">Administración de usuarios del sistema financiero</small>
        </div>

        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="fas fa-plus-circle me-1"></i> Registrar
        </a>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card shadow-sm card-resumen border-0 border-start border-primary border-4">
                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <small class="fw-bold">Total usuarios</small>
                        <h3 class="fw-bold text-primary mb-0">@totalUsuarios</h3>
                    </div>

                    <i class="fas fa-users fa-2x text-secondary opacity-50"></i>

                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm card-resumen border-0 border-start border-success border-4">
                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <small class="fw-bold">Activos</small>
                        <h3 class="fw-bold text-success mb-0">@usuariosActivos</h3>
                    </div>

                    <i class="fas fa-user-check fa-2x text-secondary opacity-50"></i>

                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm card-resumen border-0 border-start border-info border-4">
                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <small class="fw-bold">Inactivos</small>
                        <h3 class="fw-bold text-info mb-0">@usuariosInactivos</h3>
                    </div>

                    <i class="fas fa-user-slash fa-2x text-secondary opacity-50"></i>

                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm card-resumen border-0 border-start border-warning border-4">
                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <small class="fw-bold">Administradores</small>
                        <h3 class="fw-bold text-warning mb-0">@administradores</h3>
                    </div>

                    <i class="fas fa-user-shield fa-2x text-secondary opacity-50"></i>

                </div>
            </div>
        </div>

    </div>
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-dark text-white fw-bold">

            <i class="fas fa-filter me-2"></i>
            Filtros de búsqueda

        </div>

        <div class="card-body">

            <form asp-action="Index"
                  method="get"
                  id="formFiltrosUsuarios"
                  class="row g-3 align-items-end">

                <!-- BUSCAR -->
                <div class="col-md-3">

                    <label class="form-label fw-bold">

                        <i class="fas fa-search text-muted me-1"></i>
                        Buscar

                    </label>

                    <input type="text"
                           id="filtroBuscar"
                           name="buscar"
                           value="@ViewBag.Buscar"
                           class="form-control"
                           placeholder="Nombre, correo o rol..." />

                </div>

                <!-- ROL -->
                <div class="col-md-2">

                    <label class="form-label fw-bold">

                        <i class="fas fa-user-shield text-muted me-1"></i>
                        Rol

                    </label>

                    <select id="filtroRol"
                            name="rolId"
                            class="form-select">

                        <option value="">
                            Todos
                        </option>

                        @foreach (var rol in ViewBag.Roles)
                        {
                            <option value="@rol.IdRol"
                                    selected="@(ViewBag.RolId != null &&
                                            Convert.ToInt32(ViewBag.RolId) == rol.IdRol)">
                                @rol.Nombre
                            </option>
                        }

                    </select>

                </div>

                <!-- ESTADO -->
                <div class="col-md-2">

                    <label class="form-label fw-bold">

                        <i class="fas fa-toggle-on text-muted me-1"></i>
                        Estado

                    </label>

                    <select id="filtroEstado"
                            name="estado"
                            class="form-select">

                        <option value="">
                            Todos
                        </option>

                        <option value="Activo"
                                selected="@(ViewBag.Estado == "Activo")">
                            Activo
                        </option>

                        <option value="Inactivo"
                                selected="@(ViewBag.Estado == "Inactivo")">
                            Inactivo
                        </option>

                    </select>

                </div>

                <!-- BOTONES -->
                <div class="col-md-5">

                    <div class="d-flex align-items-end gap-2 w-100">

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary px-5 ">

                                <i class="fas fa-search me-1"></i>
                                Buscar

                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary px-5 ">

                                <i class="fas fa-eraser me-1"></i>
                                Limpiar

                            </a>

                        </div>

                        <div class="d-flex gap-2 ms-auto">

                            <button type="button"
                                    id="btnReporteUsuarios"
                                    class="btn btn-info">

                                <i class="fas fa-file-pdf me-1"></i>
                                Vista previa PDF

                            </button>

                            <button type="button"
                                    id="btnExcelUsuarios"
                                    class="btn btn-success">

                                <i class="fas fa-file-excel me-1"></i>
                                Exportar Excel

                            </button>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white fw-bold">
            <i class="fas fa-users me-1"></i></i>Lista de usuarios registrados
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle w-100 tabla-sistema" id="tablaUsuarios">
                    <thead class="table-light">
                        <tr>
                            <th><i class="fas fa-user me-1"></i>Nombre</th>
                            <th><i class="fas fa-envelope me-1"></i>Email</th>
                            <th><i class="fas fa-user-shield me-1"></i>Rol</th>
                            <th><i class="fas fa-clock me-1"></i>Último acceso</th>
                            <th><i class="fas fa-calendar-alt me-1"></i>Fecha creación</th>
                            <th><i class="fas fa-toggle-on me-1"></i>Estado</th>
                            <th class="text-center"><i class="fas fa-cogs me-1"></i>Acciones</th>
                        </tr>
                    </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        var estado = item.Activo ? "Activo" : "Inactivo";

                        <tr data-rol="@item.Rol?.Nombre" data-estado="@estado">
                            <td class="fw-semibold">@item.Nombre</td>
                            <td>@item.Email</td>
                            <td class="text-secondary fw-semibold">
                                @(item.Rol?.Nombre ?? "Sin rol")
                            </td>
                           
                            <td>
                                @(item.UltimoAcceso.HasValue
                                    ? item.UltimoAcceso.Value.ToString("dd/MM/yyyy HH:mm")
                                    : "Sin acceso")
                            </td>
                            <td>
                                @(item.FechaCreacion.HasValue
                                    ? item.FechaCreacion.Value.ToString("dd/MM/yyyy")
                                    : "Sin fecha")
                            </td>

                            <td>
                                @if (item.Activo)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactivo</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.IdUsuario"
                                       class="btn btn-sm btn-primary text-white">
                                        <i class="fas fa-eye"></i>
                                    Detalles
                                </a>

                                @if (item.Activo)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.IdUsuario"
                                       class="btn btn-sm btn-warning">
                                            <i class="fas fa-edit"></i>  Modificar
                                    </a>

                                    <a asp-action="CambiarEstado" asp-route-id="@item.IdUsuario"
                                       class="btn btn-sm btn-danger btn-confirmar"
                                       data-mensaje="¿Desea desactivar este usuario?">
                                            <i class="fas fa-ban"></i>  Desactivar
                                    </a>
                                }
                                else
                                {
                                    <a asp-action="CambiarEstado" asp-route-id="@item.IdUsuario"
                                       class="btn btn-sm btn-success btn-confirmar"
                                       data-mensaje="¿Desea activar este usuario?">
                                            <i class="fas fa-check"></i> Activar
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
    @section Scripts {

        <script>

            document.addEventListener("DOMContentLoaded", function () {

                // =====================================================
                // DATATABLE
                // =====================================================
                if (typeof $ !== "undefined" &&
                    $.fn.DataTable &&
                    document.getElementById("tablaUsuarios")) {

                    if ($.fn.DataTable.isDataTable("#tablaUsuarios")) {
                        $("#tablaUsuarios").DataTable().destroy();
                    }

                    $("#tablaUsuarios").DataTable({

                        pageLength: 10,

                        lengthMenu: [
                            [10, 25, 50, 100],
                            [10, 25, 50, 100]
                        ],

                        ordering: true,

                        // Más recientes primero según el orden del controlador.
                        order: [],

                        searching: true,
                        paging: true,
                        info: true,
                        autoWidth: false,
                        responsive: false,

                        columnDefs: [
                            {
                                targets: [6],
                                orderable: false,
                                searchable: false
                            }
                        ],

                        language: {

                            lengthMenu:
                                "Mostrar _MENU_ registros",

                            search:
                                "Buscar en la tabla:",

                            searchPlaceholder:
                                "Buscar usuario...",

                            zeroRecords:
                                "No se encontraron usuarios.",

                            emptyTable:
                                "No hay usuarios registrados.",

                            info:
                                "Mostrando _START_ a _END_ de _TOTAL_ registros",

                            infoEmpty:
                                "Mostrando 0 registros",

                            infoFiltered:
                                "(filtrado de _MAX_ registros)",

                            paginate: {

                                first:
                                    "Primero",

                                last:
                                    "Último",

                                next:
                                    "Siguiente",

                                previous:
                                    "Anterior"
                            }
                        }
                    });
                }

                // =====================================================
                // ELEMENTOS DE LOS FILTROS
                // =====================================================
                const formFiltros =
                    document.getElementById("formFiltrosUsuarios");

                const filtroBuscar =
                    document.getElementById("filtroBuscar");

                const filtroRol =
                    document.getElementById("filtroRol");

                const filtroEstado =
                    document.getElementById("filtroEstado");

                // =====================================================
                // FILTROS AUTOMÁTICOS
                // =====================================================
                if (filtroRol && formFiltros) {

                    filtroRol.addEventListener(
                        "change",
                        function () {

                            formFiltros.submit();
                        });
                }

                if (filtroEstado && formFiltros) {

                    filtroEstado.addEventListener(
                        "change",
                        function () {

                            formFiltros.submit();
                        });
                }

                if (filtroBuscar && formFiltros) {

                    let temporizador;

                    filtroBuscar.addEventListener(
                        "input",
                        function () {

                            clearTimeout(temporizador);

                            temporizador = setTimeout(
                                function () {

                                    formFiltros.submit();
                                },
                                600
                            );
                        });
                }

                // =====================================================
                // OBTENER PARÁMETROS DE LOS FILTROS
                // =====================================================
                function obtenerParametrosUsuarios() {

                    return new URLSearchParams({

                        buscar:
                            filtroBuscar
                                ? filtroBuscar.value.trim()
                                : "",

                        rolId:
                            filtroRol
                                ? filtroRol.value
                                : "",

                        estado:
                            filtroEstado
                                ? filtroEstado.value
                                : ""
                    });
                }

                // =====================================================
                // VISTA PREVIA PDF
                // =====================================================
                const btnReporteUsuarios =
                    document.getElementById(
                        "btnReporteUsuarios"
                    );

                if (btnReporteUsuarios) {

                    btnReporteUsuarios.addEventListener(
                        "click",
                        function () {

                            const parametros =
                                obtenerParametrosUsuarios();

                            const url =
                                '@Url.Action(
                "Reporte",
                    "Usuarios"
                    )'
                                + "?"
                                + parametros.toString();

                            window.location.href = url;
                        });
                }

                // =====================================================
                // EXPORTAR EXCEL
                // =====================================================
                const btnExcelUsuarios =
                    document.getElementById(
                        "btnExcelUsuarios"
                    );

                if (btnExcelUsuarios) {

                    btnExcelUsuarios.addEventListener(
                        "click",
                        function () {

                            const parametros =
                                obtenerParametrosUsuarios();

                            const url =
                                '@Url.Action(
                "ExportarExcel",
                    "Usuarios"
                    )'
                                + "?"
                                + parametros.toString();

                            window.location.href = url;
                        });
                }

                // =====================================================
                // CONFIRMACIONES ACTIVAR / DESACTIVAR
                // =====================================================
                document
                    .querySelectorAll(".btn-confirmar")
                    .forEach(function (boton) {

                        boton.addEventListener(
                            "click",
                            async function (e) {

                                e.preventDefault();

                                const url =
                                    this.href;

                                const textoBoton =
                                    this.textContent.trim();

                                if (textoBoton.includes("Desactivar")) {

                                    const confirmado =
                                        await confirmarDesactivacion(
                                            "El usuario dejará de tener acceso al sistema."
                                        );

                                    if (confirmado) {

                                        window.location.href =
                                            url;
                                    }
                                }
                                else {

                                    const confirmado =
                                        await confirmarReactivacion(
                                            "El usuario volverá a tener acceso al sistema."
                                        );

                                    if (confirmado) {

                                        window.location.href =
                                            url;
                                    }
                                }
                            });
                    });

            });

        </script>
    }
   