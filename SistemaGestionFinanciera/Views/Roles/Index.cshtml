@model IEnumerable<SistemaGestionFinanciera.Models.Role>

@{
    ViewData["Title"] = "Roles";

    var totalRoles = Model.Count();
    var rolesActivos = Model.Count(r => r.Activo);
    var rolesInactivos = Model.Count(r => !r.Activo);
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold mb-0">Gestión de Roles</h2>
            <small class="text-muted">Administración de roles de acceso del sistema financiero</small>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus-circle me-1"></i> Registrar
        </a>
    </div>

    <div class="row g-3 mb-4">

        <!-- TOTAL DE ROLES -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 card-resumen
                    border-0 border-start border-primary border-4">

                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <small class="fw-bold">Total de roles</small>
                        <h3 class="fw-bold text-primary mb-0">
                            @totalRoles
                        </h3>
                    </div>

                    <i class="fas fa-user-tag fa-2x text-secondary opacity-50"></i>
                </div>

            </div>
        </div>

        <!-- ROLES ACTIVOS -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 card-resumen
                    border-0 border-start border-success border-4">

                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <small class="fw-bold">Roles activos</small>
                        <h3 class="fw-bold text-success mb-0">
                            @rolesActivos
                        </h3>
                    </div>

                    <i class="fas fa-user-check fa-2x text-secondary opacity-50"></i>
                </div>

            </div>
        </div>

        <!-- ROLES INACTIVOS -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 card-resumen
                    border-0 border-start border-warning border-4">

                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <small class="fw-bold">Roles inactivos</small>
                        <h3 class="fw-bold text-warning mb-0">
                            @rolesInactivos
                        </h3>
                    </div>

                    <i class="fas fa-user-slash fa-2x text-secondary opacity-50"></i>
                </div>

            </div>
        </div>

    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-dark text-white fw-bold">
            <i class="fas fa-filter me-2"></i>Filtros de búsqueda
        </div>

        <div class="card-body">
                <form asp-action="Index"
              method="get"
              id="formFiltrosRoles"
              class="row g-3 align-items-end">

            <!-- BUSCAR -->
            <div class="col-md-3">

                <label class="form-label fw-bold">

                    <i class="fas fa-search text-muted me-1"></i>
                    Buscar

                </label>

                <input type="text"
                       id="filtroBuscarRol"
                       name="buscar"
                       value="@ViewBag.Buscar"
                       class="form-control"
                       placeholder="Nombre o descripción..." />

            </div>

            <!-- ESTADO -->
            <div class="col-md-2">

                <label class="form-label fw-bold">

                    <i class="fas fa-toggle-on text-muted me-1"></i>
                    Estado

                </label>

                <select id="filtroEstadoRol"
                        name="estado"
                        class="form-select">

                    <option value="">
                        Todos
                    </option>

                    <option value="Activo"
                            selected="@(ViewBag.Estado == "Activo")">
                        Activos
                    </option>

                    <option value="Inactivo"
                            selected="@(ViewBag.Estado == "Inactivo")">
                        Inactivos
                    </option>

                </select>

            </div>

                <!-- BOTONES -->
                <div class="col-md-7">

                    <div class="d-flex align-items-end gap-2 w-100">

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary px-5">

                                <i class="fas fa-search me-1"></i>
                                Buscar

                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary px-5">

                                <i class="fas fa-eraser me-1"></i>
                                Limpiar

                            </a>

                        </div>

                        <div class="d-flex gap-2 ms-auto">

                            <button type="button"
                                    id="btnReporteRoles"
                                    class="btn btn-info">

                                <i class="fas fa-file-pdf me-1"></i>
                                Vista previa PDF

                            </button>

                            <button type="button"
                                    id="btnExcelRoles"
                                    class="btn btn-success">

                                <i class="fas fa-file-excel me-1"></i>
                                Exportar Excel

                            </button>

                        </div>

                    </div>

                </div>

            </form>

        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white fw-bold">
            <i class="fas fa-user-shield me-2"></i>Lista de roles registrados
        </div>

        <div class="card-body">

            <div class="table-responsive ">
                <table id="tablaRoles" class="table table-striped table-hover align-middle w-100 tabla-sistema">
                    <thead class="table-light">
                        <tr>
                            <th><i class="fas fa-user-shield me-1"></i>Nombre</th>
                            <th><i class="fas fa-align-left me-1"></i>Descripción</th>
                            <th><i class="fas fa-toggle-on me-1"></i>Estado</th>
                            <th><i class="fas fa-calendar-alt me-1"></i>Fecha creación</th>
                            <th class="text-end"><i class="fas fa-cogs me-1"></i>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                       
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.Nombre</td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.Descripcion))
                                        {
                                            @item.Descripcion
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sin descripción</span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.Activo)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactivo</span>
                                        }
                                    </td>

                                    <td>
                                        @(item.FechaCreacion.HasValue
                                            ? item.FechaCreacion.Value.ToString("dd/MM/yyyy HH:mm")
                                            : "Sin fecha")
                                    </td>

                                    <td class="col-acciones text-end">
                                        <div class="acciones-botones justify-content-end">

                                            <a asp-action="Details"
                                               asp-route-id="@item.IdRol"
                                               class="btn btn-primary btn-sm btn-accion">
                                                <i class="fas fa-eye"></i> Detalles
                                            </a>

                                            @if (item.Activo)
                                            {
                                                <a asp-action="Edit"
                                                   asp-route-id="@item.IdRol"
                                                   class="btn btn-warning btn-sm btn-accion">
                                                    <i class="fas fa-edit"></i> Modificar
                                                </a>

                                                <form asp-action="Delete"
                                                      asp-route-id="@item.IdRol"
                                                      method="post"
                                                      class="d-inline form-desactivar">
                                                    @Html.AntiForgeryToken()

                                                    <button type="submit" class="btn btn-danger btn-sm btn-accion">
                                                        <i class="fas fa-ban"></i> Desactivar
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="Activar"
                                                      asp-route-id="@item.IdRol"
                                                      method="post"
                                                      class="d-inline form-activar">
                                                    @Html.AntiForgeryToken()

                                                    <button type="submit" class="btn btn-success btn-sm btn-accion">
                                                        <i class="fas fa-check"></i> Activar
                                                    </button>
                                                </form>
                                            }

                                        </div>
                                    </td>
                                </tr>
                            }
                        
                    </tbody>
                </table>
            </div>

        </div>
    </div>

</div>

@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            // =====================================================
            // DATATABLE
            // =====================================================
            if (typeof $ !== "undefined" &&
                $.fn.DataTable &&
                document.getElementById("tablaRoles")) {

                if ($.fn.DataTable.isDataTable("#tablaRoles")) {
                    $("#tablaRoles").DataTable().destroy();
                }

                $("#tablaRoles").DataTable({

                    pageLength: 10,

                    lengthMenu: [
                        [10, 25, 50, 100],
                        [10, 25, 50, 100]
                    ],

                    ordering: true,

                    // Se conserva el orden recibido desde el controlador.
                    order: [],

                    searching: true,
                    paging: true,
                    info: true,
                    autoWidth: false,
                    responsive: false,
                    scrollX: false,

                    columnDefs: [
                        {
                            targets: -1,
                            orderable: false,
                            searchable: false
                        }
                    ],

                    language: {

                        lengthMenu:
                            "Mostrar _MENU_ registros",

                        search:
                            "Buscar en la tabla:",

                        searchPlaceholder:
                            "Buscar rol...",

                        zeroRecords:
                            "No se encontraron roles.",

                        emptyTable:
                            "No hay roles registrados.",

                        info:
                            "Mostrando _START_ a _END_ de _TOTAL_ registros",

                        infoEmpty:
                            "Mostrando 0 registros",

                        infoFiltered:
                            "(filtrado de _MAX_ registros)",

                        paginate: {

                            first:
                                "Primero",

                            last:
                                "Último",

                            next:
                                "Siguiente",

                            previous:
                                "Anterior"
                        }
                    }
                });
            }

            // =====================================================
            // ELEMENTOS DE FILTROS
            // =====================================================
            const formFiltrosRoles =
                document.getElementById("formFiltrosRoles");

            const filtroBuscarRol =
                document.getElementById("filtroBuscarRol");

            const filtroEstadoRol =
                document.getElementById("filtroEstadoRol");

            // =====================================================
            // FILTROS AUTOMÁTICOS
            // =====================================================
            if (filtroEstadoRol && formFiltrosRoles) {

                filtroEstadoRol.addEventListener(
                    "change",
                    function () {

                        formFiltrosRoles.submit();
                    });
            }

            if (filtroBuscarRol && formFiltrosRoles) {

                let temporizadorBusqueda;

                filtroBuscarRol.addEventListener(
                    "input",
                    function () {

                        clearTimeout(temporizadorBusqueda);

                        temporizadorBusqueda = setTimeout(
                            function () {

                                formFiltrosRoles.submit();
                            },
                            600
                        );
                    });
            }

            // =====================================================
            // OBTENER PARÁMETROS DEL REPORTE
            // =====================================================
            function obtenerParametrosRoles() {

                return new URLSearchParams({

                    buscar:
                        filtroBuscarRol
                            ? filtroBuscarRol.value.trim()
                            : "",

                    estado:
                        filtroEstadoRol
                            ? filtroEstadoRol.value
                            : ""
                });
            }

            // =====================================================
            // VISTA PREVIA PDF
            // =====================================================
            const btnReporteRoles =
                document.getElementById("btnReporteRoles");

            if (btnReporteRoles) {

                btnReporteRoles.addEventListener(
                    "click",
                    function () {

                        const parametros =
                            obtenerParametrosRoles();

                        const url =
                            '@Url.Action(
            "Reporte",
                "Roles"
                )'
                            + "?"
                            + parametros.toString();

                        window.location.href = url;
                    });
            }

            // =====================================================
            // EXPORTAR EXCEL
            // =====================================================
            const btnExcelRoles =
                document.getElementById("btnExcelRoles");

            if (btnExcelRoles) {

                btnExcelRoles.addEventListener(
                    "click",
                    function () {

                        const parametros =
                            obtenerParametrosRoles();

                        const url =
                            '@Url.Action(
            "ExportarExcel",
                "Roles"
                )'
                            + "?"
                            + parametros.toString();

                        window.location.href = url;
                    });
            }

            // =====================================================
            // CONFIRMACIÓN PARA DESACTIVAR
            // =====================================================
            document
                .querySelectorAll(".form-desactivar")
                .forEach(function (formulario) {

                    formulario.addEventListener(
                        "submit",
                        async function (evento) {

                            evento.preventDefault();

                            const confirmado =
                                await confirmarDesactivacion(
                                    "El rol dejará de estar disponible para nuevas asignaciones."
                                );

                            if (confirmado) {

                                formulario.submit();
                            }
                        });
                });

            // =====================================================
            // CONFIRMACIÓN PARA ACTIVAR
            // =====================================================
            document
                .querySelectorAll(".form-activar")
                .forEach(function (formulario) {

                    formulario.addEventListener(
                        "submit",
                        async function (evento) {

                            evento.preventDefault();

                            const confirmado =
                                await confirmarReactivacion(
                                    "El rol volverá a estar disponible dentro del sistema."
                                );

                            if (confirmado) {

                                formulario.submit();
                            }
                        });
                });

        });

    </script>
}