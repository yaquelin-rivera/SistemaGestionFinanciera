@section Scripts {
    <script>
        $(document).ready(function () {

            if ($.fn.DataTable.isDataTable('#tablaPagosCxC')) {
                $('#tablaPagosCxC').DataTable().destroy();
            }

            $('#tablaPagosCxC').DataTable({
                pageLength: 10,

                lengthMenu: [
                    [10, 25, 50, 100],
                    [10, 25, 50, 100]
                ],

                order: [],

                columnDefs: [
                    {
                        targets: [10],
                        orderable: false,
                        searchable: false
                    }
                ],

                language: {
                    decimal: ",",
                    thousands: ".",
                    lengthMenu: "Mostrar _MENU_ registros",
                    zeroRecords: "No se encontraron pagos para mostrar",
                    info: "Mostrando _START_ a _END_ de _TOTAL_ registros",
                    infoEmpty: "No hay pagos registrados",
                    infoFiltered: "(filtrado de _MAX_ registros totales)",
                    search: "Buscar en resultados:",
                    loadingRecords: "Cargando...",
                    processing: "Procesando...",
                    emptyTable: "No hay pagos registrados",
                    paginate: {
                        first: "Primero",
                        previous: "Anterior",
                        next: "Siguiente",
                        last: "Último"
                    }
                }
            });

        });
    </script>
}