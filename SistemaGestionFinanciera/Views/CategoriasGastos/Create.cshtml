@model SistemaGestionFinanciera.Models.CategoriasGasto

@{
    ViewData["Title"] = "Crear categoría de gasto";
}

<div class="container-fluid mt-4">

    <div class="mb-3">
        <h2 class="fw-bold mb-0">Crear categoría de gasto</h2>
        <small class="text-muted">
            Registre una categoría para clasificar los gastos, controlar límites mensuales y asociarla a una cuenta contable.
        </small>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white fw-bold">
            Datos de la categoría de gasto
        </div>

        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="Nombre" class="form-label fw-semibold">
                            Nombre <span class="text-danger">*</span>
                        </label>

                        <input asp-for="Nombre"
                               class="form-control"
                               maxlength="100"
                               autocomplete="off"
                               placeholder="Ejemplo: Servicios públicos" />

                        <small class="text-muted">
                            Solo letras y espacios. Mínimo 3 caracteres.
                        </small>

                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CuentaContableId" class="form-label fw-semibold">
                            Cuenta contable <span class="text-danger">*</span>
                        </label>

                        <select asp-for="CuentaContableId"
                                class="form-select"
                                asp-items="ViewBag.CuentaContableId">
                            <option value="">-- Seleccione la cuenta contable --</option>
                        </select>

                        <small class="text-muted">
                            Esta cuenta se utilizará para la integración contable de los gastos.
                        </small>

                        <span asp-validation-for="CuentaContableId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LimiteMensual" class="form-label fw-semibold">
                            Límite mensual <span class="text-danger">*</span>
                        </label>

                        <input asp-for="LimiteMensual"
                               class="form-control"
                               type="number"
                               min="0"
                               step="0.01"
                               placeholder="Ejemplo: ₡5000" />

                        <small class="text-muted">
                            Ingrese 0 si la categoría no tendrá límite mensual definido.
                        </small>

                        <span asp-validation-for="LimiteMensual" class="text-danger"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Descripcion" class="form-label fw-semibold">
                            Descripción
                        </label>

                        <textarea asp-for="Descripcion"
                                  class="form-control"
                                  rows="3"
                                  maxlength="250"
                                  autocomplete="off"
                                  placeholder="Describa brevemente el uso de esta categoría..."></textarea>

                        <small class="text-muted">
                            Campo opcional. Permite letras, números, espacios y signos básicos: . , ; : ( ) / $ # ° -
                        </small>

                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>

                </div>

                <div class="alert alert-info mt-4 mb-0">
                   
                    La categoría se creará activa. Si el límite mensual es ₡0.00, se interpreta como categoría sin límite definido.
                </div>

                <div class="mt-4 d-flex gap-2">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Volver al listado
                    </a>

                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Guardar
                    </button>

                   
                </div>

            </form>
        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const nombre = document.getElementById("Nombre");
            const descripcion = document.getElementById("Descripcion");
            const limiteMensual = document.getElementById("LimiteMensual");

            if (nombre) {
                nombre.addEventListener("input", function () {
                    this.value = this.value.replace(/[^A-Za-zÁÉÍÓÚáéíóúÑñ\s]/g, "");
                });
            }

            if (descripcion) {
                descripcion.addEventListener("input", function () {
                    this.value = this.value.replace(/[^A-Za-zÁÉÍÓÚáéíóúÑñ0-9\s.,;:()\/$#°-]/g, "");
                });
            }

            if (limiteMensual) {
                limiteMensual.addEventListener("input", function () {
                    if (parseFloat(this.value) < 0) {
                        this.value = 0;
                    }
                });
            }
        });
    </script>
}