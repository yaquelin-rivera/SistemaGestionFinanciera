@{
    ViewData["Title"] = "Roles - Permisos";

    var permisos = ViewBag.Permisos as List<SistemaGestionFinanciera.Models.Permiso>;
    var permisosAsignados = ViewBag.PermisosAsignados as int[] ?? new int[0];

    int? rolIdSeleccionado = ViewBag.RolId as int?;
    int totalRoles = ViewBag.TotalRoles ?? 0;
    int totalPermisos = ViewBag.TotalPermisos ?? 0;
    int totalAsignados = ViewBag.TotalAsignados ?? 0;

    string nombreRolSeleccionado = ViewBag.NombreRolSeleccionado ?? "";
}



<div class="container-fluid mt-4">

    <div class="mb-3">
        <h2 class="fw-bold mb-0">Asignación de Permisos por Rol</h2>
        <small class="text-muted">
            Administración de permisos asociados a los roles activos del sistema financiero.
        </small>
    </div>

    <div class="row g-3 mb-4">

        <!-- ROLES ACTIVOS -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 card-resumen
                    border-0 border-start border-primary border-4">

                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <small class="fw-bold">Roles activos</small>

                        <h3 class="fw-bold text-primary mb-0">
                            @totalRoles
                        </h3>
                    </div>

                    <i class="fas fa-user-shield fa-2x text-muted opacity-50"></i>

                </div>
            </div>
        </div>

        <!-- PERMISOS ACTIVOS -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 card-resumen
                    border-0 border-start border-success border-4">

                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <small class="fw-bold">Permisos activos</small>

                        <h3 class="fw-bold text-success mb-0">
                            @totalPermisos
                        </h3>
                    </div>

                    <i class="fas fa-key fa-2x text-muted opacity-50"></i>

                </div>
            </div>
        </div>

        <!-- PERMISOS ASIGNADOS -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 card-resumen
                    border-0 border-start border-warning border-4">

                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <small class="fw-bold">
                            Permisos asignados al rol
                        </small>

                        <h3 class="fw-bold text-warning mb-0">
                            @totalAsignados
                        </h3>
                    </div>

                    <i class="fas fa-link fa-2x text-muted opacity-50"></i>

                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-dark text-white fw-bold">
            <i class="fas fa-user-shield me-2"></i>Seleccionar rol
        </div>

        <div class="card-body">

            <form asp-action="Index" method="get" class="row g-3">

                <div class="col-md-4">
                    <label class="form-label fw-bold"><i class="fas fa-user-shield text-muted  me-1"></i>Rol</label>
                    <select name="rolId"
                            class="form-select"
                            onchange="this.form.submit()"
                            asp-items="ViewBag.Roles">
                        <option value="">Seleccione un rol...</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex align-items-end">
                    <a asp-action="Index" class="btn btn-secondary w-100">
                        <i class="fas fa-eraser me-1"></i> Limpiar
                    </a>
                </div>

            </form>

        </div>

    </div>
    @if (rolIdSeleccionado.HasValue)
    {
        <div class="alert alert-primary d-flex justify-content-between align-items-center">
            <div>
                <i class="fas fa-user-shield me-2"></i>
                <strong>Rol seleccionado:</strong> @nombreRolSeleccionado
            </div>

            <div>
                <strong id="contadorSeleccionados">@totalAsignados</strong> / @totalPermisos permisos seleccionados
            </div>
        </div>
    }
    @if (rolIdSeleccionado.HasValue)
    {
        <form asp-action="Guardar" method="post" class="form-guardar-permisos">
            @Html.AntiForgeryToken()

            <input type="hidden" name="rolId" value="@rolIdSeleccionado.Value" />

            <div class="card shadow-sm border-0">

                <div class="card-header bg-dark text-white fw-bold d-flex justify-content-between align-items-center">
                    <span>
                        <i class="fas fa-key me-2"></i>Permisos disponibles
                    </span>

                    <span class="badge bg-light text-dark">
                        Seleccione los permisos que aplican al rol
                    </span>
                </div>

                <div class="card-body">

                    @if (permisos == null || !permisos.Any())
                    {
                        <div class="alert alert-warning mb-0">
                            No existen permisos activos disponibles para asignar.
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold"><i class="fas fa-search text-muted  me-1"></i>Buscar permiso</label>
                            <input type="text"
                                   id="buscarPermiso"
                                   class="form-control"
                                   placeholder="Buscar por nombre o descripción del permiso..." />
                        </div>

                        <div class="mb-3 d-flex gap-2">
                            <button type="button" class="btn btn-outline-primary btn-sm" id="btnSeleccionarTodo">
                                <i class="fas fa-check-double me-1"></i> Seleccionar todo
                            </button>

                            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnQuitarTodo">
                                <i class="fas fa-times me-1"></i> Quitar todo
                            </button>
                        </div>

                        <div class="table-responsive tabla-scroll">
                            <table class="table table-striped table-hover align-middle w-100 tabla-sistema">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:80px;" class="text-center"><i class="fas fa-user-shield me-1"></i>Asignar</th>
                                        <th><i class="fas fa-key me-1"></i>Permiso</th>
                                        <th><i class="fas fa-align-left me-1"></i>Descripción</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var permiso in permisos)
                                    {
                                        var marcado = permisosAsignados.Contains(permiso.IdPermiso);

                                        <tr class="fila-permiso">
                                            <td class="text-center">
                                                <input type="checkbox"
                                                       class="form-check-input permiso-check"
                                                       name="permisosSeleccionados"
                                                       value="@permiso.IdPermiso"
                                                @(marcado ? "checked" : "") />
                                            </td>

                                            <td class="fw-semibold">
                                                @permiso.Nombre
                                            </td>

                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(permiso.Descripcion))
                                                {
                                                    @permiso.Descripcion
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Sin descripción</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="mt-4 d-flex gap-2">

                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save me-1"></i> Guardar asignación
                            </button>

                            <a asp-controller="Roles" asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i> Volver a roles
                            </a>

                        </div>
                    }

                </div>
            </div>
        </form>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>
            Seleccione un rol para visualizar y modificar sus permisos asignados.
        </div>
    }

</div>

@section Scripts {
    <script>
        const btnSeleccionarTodo = document.getElementById("btnSeleccionarTodo");
        const btnQuitarTodo = document.getElementById("btnQuitarTodo");
        const buscarPermiso = document.getElementById("buscarPermiso");
        const contadorSeleccionados = document.getElementById("contadorSeleccionados");

        function actualizarContador() {
            const seleccionados = document.querySelectorAll(".permiso-check:checked").length;

            if (contadorSeleccionados) {
                contadorSeleccionados.textContent = seleccionados;
            }
        }

        if (btnSeleccionarTodo) {
            btnSeleccionarTodo.addEventListener("click", function () {
                document.querySelectorAll(".permiso-check").forEach(check => check.checked = true);
                actualizarContador();
            });
        }

        if (btnQuitarTodo) {
            btnQuitarTodo.addEventListener("click", function () {
                document.querySelectorAll(".permiso-check").forEach(check => check.checked = false);
                actualizarContador();
            });
        }

        document.querySelectorAll(".permiso-check").forEach(check => {
            check.addEventListener("change", actualizarContador);
        });

        if (buscarPermiso) {
            buscarPermiso.addEventListener("keyup", function () {
                const texto = this.value.toLowerCase();

                document.querySelectorAll(".fila-permiso").forEach(fila => {
                    const contenido = fila.textContent.toLowerCase();
                    fila.style.display = contenido.includes(texto) ? "" : "none";
                });
            });
        }

        document.querySelectorAll(".form-guardar-permisos").forEach(form => {
            form.addEventListener("submit", function (e) {
                e.preventDefault();

                Swal.fire({
                    title: "¿Guardar permisos?",
                    text: "Se actualizarán los permisos asignados al rol seleccionado.",
                    icon: "success",
                    showCancelButton: true,
                    confirmButtonText: "Sí, guardar",
                    cancelButtonText: "Cancelar",
                    confirmButtonColor: "#198754",
                    cancelButtonColor: "#6c757d"
                }).then((result) => {
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });
        });

        actualizarContador();
    </script>
}