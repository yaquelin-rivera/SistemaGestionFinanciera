@model IEnumerable<SistemaGestionFinanciera.Models.CategoriasIngreso>

@{
    ViewData["Title"] = "Categorías de ingresos";

    var totalCategorias = Model.Count();
    var totalActivas = Model.Count(c => c.Activo);
    var totalInactivas = Model.Count(c => !c.Activo);
}


<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold mb-0">Gestión de categorías de ingresos</h2>
            <small class="text-muted">
                Catálogo utilizado para clasificar los ingresos y asociarlos a cuentas contables.
            </small>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus-circle me-1"></i> Registrar
        </a>
    </div>

    <div class="row g-3 mb-3">

        <div class="col-md-4">
            <div class="card card-resumen shadow-sm border-0 border-start border-primary border-4 h-100">
                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <small class="fw-bold mb-1">Categorías registradas</small>
                        <h5 class="fw-bold text-primary mb-0">
                            @totalCategorias
                        </h5>
                    </div>

                    <i class="fas fa-tags fa-2x text-muted opacity-50"></i>

                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card card-resumen shadow-sm border-0 border-start border-success border-4 h-100">
                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <small class="fw-bold mb-1">Categorías activas</small>
                        <h5 class="fw-bold text-success mb-0">
                            @totalActivas
                        </h5>
                    </div>

                    <i class="fas fa-check-circle fa-2x text-muted opacity-50"></i>

                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card card-resumen shadow-sm border-0 border-start border-danger border-4 h-100">
                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <small class="fw-bold mb-1">Categorías inactivas</small>
                        <h5 class="fw-bold text-secondary mb-0">
                            @totalInactivas
                        </h5>
                    </div>

                    <i class="fas fa-ban fa-2x text-muted opacity-50"></i>

                </div>
            </div>
        </div>

    </div>
    <div class="card shadow-sm border-0 mb-3">

        <div class="card-header text-white fw-bold">
            <i class="fas fa-filter me-2"></i>
            Filtros de búsqueda
        </div>

        <div class="card-body">

            <div class="row g-3 align-items-end">

                <!-- BUSCAR -->
                <div class="col-md-3">

                    <label class="form-label fw-bold">

                        <i class="fas fa-search text-muted me-1"></i>
                        Buscar

                    </label>

                    <input type="text"
                           id="filtroTexto"
                           class="form-control"
                           placeholder="Nombre o descripción..." />

                </div>

                <!-- CUENTA CONTABLE -->
                <div class="col-md-3">

                    <label class="form-label fw-bold">

                        <i class="fas fa-book text-muted me-1"></i>
                        Cuenta contable

                    </label>

                    <input type="text"
                           id="filtroCuenta"
                           class="form-control"
                           placeholder="Código o nombre de la cuenta..." />

                </div>

                <!-- ESTADO -->
                <div class="col-md-1">

                    <label class="form-label fw-bold">

                        <i class="fas fa-info-circle text-muted me-1"></i>
                        Estado

                    </label>

                    <select id="filtroEstado"
                            class="form-select">

                        <option value="">Todos</option>
                        <option value="Activo">Activo</option>
                        <option value="Inactivo">Inactivo</option>

                    </select>

                </div>

                <!-- BOTONES -->
                <div class="col-md-5">

                    <div class="d-flex align-items-end gap-2 w-100">

                        <div class="d-flex gap-2">

                            <button type="button"
                                    id="btnBuscar"
                                    class="btn btn-primary btn-filtro px-5">

                                <i class="fas fa-search me-1"></i>
                                Buscar

                            </button>

                            <button type="button"
                                    id="btnLimpiar"
                                    class="btn btn-secondary btn-filtro px-5">

                                <i class="fas fa-eraser me-1"></i>
                                Limpiar

                            </button>

                        </div>

                        <div class="d-flex gap-2 ms-auto">

                            <button type="button"
                                    id="btnReporteCategoriasIngresos"
                                    class="btn btn-info btn-filtro px-4">

                                <i class="fas fa-file-pdf me-1"></i>
                                Vista previa PDF

                            </button>

                            <button type="button"
                                    id="btnExcelCategoriasIngresos"
                                    class="btn btn-success btn-filtro px-4 ">

                                <i class="fas fa-file-excel me-1"></i>
                                Exportar Excel

                            </button>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header text-white fw-bold">
            <i class="fas fa-list me-2"></i>
            Lista de categorías de ingresos registradas
        </div>
        <div class="card-body">

            <div class="table-responsive">
                <table id ="tablaCategoriasIngresos" class="table table-hover align-middle w-100 tabla-sistema">
                    <thead class="table-light">
                        <tr>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Cuenta contable</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            var estadoTexto = item.Activo ? "Activo" : "Inactivo";
                            var cuentaTexto = item.CuentaContable != null
                                ? item.CuentaContable.Codigo + " - " + item.CuentaContable.Nombre
                                : "Sin cuenta asociada";

                            <tr data-estado="@estadoTexto"
                                data-cuenta="@cuentaTexto"
                                data-texto="@($"{item.Nombre} {item.Descripcion}")">

                                <td class="fw-semibold">
                                    @item.Nombre
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Descripcion))
                                    {
                                        @item.Descripcion
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin descripción</span>
                                    }
                                </td>

                                <td>
                                    @if (item.CuentaContable != null)
                                    {
                                        <span class="badge bg-light text-dark border">
                                            @item.CuentaContable.Codigo - @item.CuentaContable.Nombre
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Sin cuenta asociada
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (item.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </td>

                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">

                                        <a asp-action="Details"
                                           asp-route-id="@item.IdCategoriaIngreso"
                                           class="btn btn-sm btn-primary">
                                            <i class="fas fa-eye me-1"></i> Detalles
                                        </a>

                                        @if (item.Activo)
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@item.IdCategoriaIngreso"
                                               class="btn btn-sm btn-warning">
                                                <i class="fas fa-pen-to-square me-1"></i> Modificar
                                            </a>

                                            <form asp-action="Delete"
                                                  asp-route-id="@item.IdCategoriaIngreso"
                                                  method="post"
                                                  class="d-inline form-desactivar-categoria-ingreso"
                                                  data-nombre="@item.Nombre">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger">
                                                    <i class="fas fa-ban me-1"></i> Desactivar
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-warning"
                                                    disabled
                                                    title="Primero debe activar la categoría para poder modificarla.">
                                                <i class="fas fa-pen-to-square me-1"></i> Modificar
                                            </button>

                                            <form asp-action="Activar"
                                                  asp-route-id="@item.IdCategoriaIngreso"
                                                  method="post"
                                                  class="d-inline form-activar-categoria-ingreso"
                                                  data-nombre="@item.Nombre">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-success">
                                                    <i class="fas fa-check me-1"></i> Activar
                                                </button>
                                            </form>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>


            @if (!Model.Any())
            {
                <div class="alert alert-info mt-3 mb-0">
                    No existen categorías de ingresos registradas.
                </div>
            }

        </div>
    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            const tabla = $('#tablaCategoriasIngresos').DataTable({
                pageLength: 10,

                lengthMenu: [
                    [10, 25, 50, 100],
                    [10, 25, 50, 100]
                ],

                order: [[0, 'asc']],

                columnDefs: [
                    {
                        targets: [4],
                        orderable: false,
                        searchable: false
                    }
                ],

                language: {
                    emptyTable: "No existen categorías de ingresos registradas",
                    zeroRecords: "No se encontraron categorías de ingresos",
                    info: "Mostrando _START_ a _END_ de _TOTAL_ categorías",
                    infoEmpty: "No hay categorías para mostrar",
                    infoFiltered: "(filtrado de _MAX_ categorías totales)",
                    lengthMenu: "Mostrar _MENU_ categorías",
                    search: "Buscar:",
                    loadingRecords: "Cargando...",
                    processing: "Procesando...",
                    paginate: {
                        first: "Primero",
                        previous: "Anterior",
                        next: "Siguiente",
                        last: "Último"
                    }
                }
            });

            function aplicarFiltros() {

                const texto = $('#filtroTexto').val().trim();
                const cuenta = $('#filtroCuenta').val().trim();
                const estado = $('#filtroEstado').val();

                tabla.column(0).search(texto);
                tabla.column(1).search(texto);
                tabla.column(2).search(cuenta);

                tabla.column(3).search(
                    estado
                        ? '^\\s*' +
                        $.fn.dataTable.util.escapeRegex(estado) +
                        '\\s*$'
                        : '',
                    true,
                    false
                );

                tabla.draw();
            }

            $('#btnBuscar').on('click', aplicarFiltros);

            $('#btnLimpiar').on('click', function () {

                $('#filtroTexto').val('');
                $('#filtroCuenta').val('');
                $('#filtroEstado').val('');

                tabla.search('');
                tabla.columns().search('');
                tabla.draw();
            });

            $('#filtroTexto').on('keyup', aplicarFiltros);
            $('#filtroCuenta').on('keyup', aplicarFiltros);
            $('#filtroEstado').on('change', aplicarFiltros);

            // =====================================================
            // REPORTE PDF Y EXCEL
            // =====================================================
            function obtenerFiltrosReporteCategoriasIngresos() {

                const buscar =
                    document
                        .getElementById("filtroTexto")
                        .value
                        .trim();

                const cuenta =
                    document
                        .getElementById("filtroCuenta")
                        .value
                        .trim();

                const estado =
                    document
                        .getElementById("filtroEstado")
                        .value;

                return new URLSearchParams({
                    buscar: buscar,
                    cuenta: cuenta,
                    estado: estado
                });
            }

            document
                .getElementById("btnReporteCategoriasIngresos")
                .addEventListener("click", function () {

                    const parametros =
                        obtenerFiltrosReporteCategoriasIngresos();

                    const url =
                        '@Url.Action("Reporte", "CategoriasIngresos")'
                        + "?"
                        + parametros.toString();

                    window.location.href = url;
                });

            document
                .getElementById("btnExcelCategoriasIngresos")
                .addEventListener("click", function () {

                    const parametros =
                        obtenerFiltrosReporteCategoriasIngresos();

                    const url =
                        '@Url.Action("ExportarExcel", "CategoriasIngresos")'
                        + "?"
                        + parametros.toString();

                    window.location.href = url;
                }); 

            document
                .querySelectorAll(".form-desactivar-categoria-ingreso")
                .forEach(form => {

                    form.addEventListener("submit", function (e) {
                        e.preventDefault();

                        const nombre = form.dataset.nombre;

                        Swal.fire({
                            title: "¿Desactivar categoría de ingreso?",
                            html: `La categoría <strong>${nombre}</strong> quedará inactiva.<br><br>
                                           No será eliminada y ya no estará disponible para registrar nuevos ingresos.`,
                            icon: "warning",
                            showCancelButton: true,
                            confirmButtonText: "Sí, desactivar",
                            cancelButtonText: "Cancelar",
                            confirmButtonColor: "#dc3545",
                            cancelButtonColor: "#6c757d"
                        }).then((result) => {

                            if (result.isConfirmed) {
                                form.submit();
                            }

                        });
                    });

                });


            document
                .querySelectorAll(".form-activar-categoria-ingreso")
                .forEach(form => {

                    form.addEventListener("submit", function (e) {
                        e.preventDefault();

                        const nombre = form.dataset.nombre;

                        Swal.fire({
                            title: "¿Activar categoría de ingreso?",
                            html: `La categoría <strong>${nombre}</strong> volverá a estar disponible para registrar ingresos.`,
                            icon: "question",
                            showCancelButton: true,
                            confirmButtonText: "Sí, activar",
                            cancelButtonText: "Cancelar",
                            confirmButtonColor: "#198754",
                            cancelButtonColor: "#6c757d"
                        }).then((result) => {

                            if (result.isConfirmed) {
                                form.submit();
                            }

                        });
                    });

                });

        });
    </script>
}