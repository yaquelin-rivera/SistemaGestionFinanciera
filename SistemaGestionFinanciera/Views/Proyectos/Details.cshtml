@model SistemaGestionFinanciera.Models.Proyecto

@{
    ViewData["Title"] = "Detalles del proyecto";
}

<div class="container-fluid mt-4">

    <div class="mb-1">
        <h2 class="fw-bold mb-0">Detalles del proyecto</h2>
        <small class="text-muted">
            Información general y resumen financiero del proyecto.
        </small>
    </div>

    <!-- Cards resumen -->

    <div class="row mb-3">

        <div class="col-md-3">
            <div class="card shadow-sm border-start border-primary border-4 text-center">
                <div class="card-body">
                    <small>Ingresos asociados</small>
                    <h5 class="text-primary">
                        ₡@(((decimal?)ViewBag.TotalIngresos ?? 0).ToString("N2"))
                    </h5>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-start border-success border-4 text-center">
                <div class="card-body">
                    <small>Gastos asociados</small>
                    <h5 class="text-success">
                        ₡@(((decimal?)ViewBag.TotalGastos ?? 0).ToString("N2"))
                    </h5>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-start border-info border-4 text-center">
                <div class="card-body">
                    <small>Facturas</small>
                    <h5 class="text-info">
                        @(ViewBag.TotalFacturas ?? 0)
                    </h5>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-start border-warning border-4 text-center">
                <div class="card-body">
                    <small>Movimientos contables</small>
                    <h5 class="text-warning">
                        @(ViewBag.TotalMovimientos ?? 0)
                    </h5>
                </div>
            </div>
        </div>

    </div>


    <div class="card shadow-sm border-0">

        <div class="card-header text-white fw-bold"
             style="background-color:#0F5C64;">
            Información del proyecto
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4 mb-3">
                    <label class="fw-bold">Nombre</label>

                    <div class="form-control bg-light">
                        @Model.Nombre
                    </div>
                </div>

              
                <div class="col-md-2 mb-3">

                    <label class="fw-bold">
                        Fecha de inicio
                    </label>

                    <div class="form-control bg-light">
                        @Model.FechaInicio?.ToString("dd/MM/yyyy")
                    </div>

                </div>

                <div class="col-md-2 mb-3">

                    <label class="fw-bold">
                        Fecha de fiN
                    </label>

                    <div class="form-control bg-light">

                        @(Model.FechaFin?.ToString("dd/MM/yyyy")
                            ?? "Sin fecha")

                    </div>

                </div>
                <div class="col-md-2 mb-3">

                    <label class="fw-bold">
                        Presupuesto asignado
                    </label>

                    <div class="form-control bg-light">

                        ₡@((Model.PresupuestoAsignado ?? 0).ToString("N2"))

                    </div>

                </div>


                <div class="col-md-1 mb-3">

                    <label class="fw-bold">Estado</label>

                    <div>

                        @if (Model.Activo)
                        {
                            <span class="badge bg-success fs-6">
                                Activo
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary fs-6">
                                Inactivo
                            </span>
                        }

                    </div>

                </div>
                <div class="col-md-10 mb-3">

                    <label class="fw-bold">
                        Descripción
                    </label>

                    <div class="form-control bg-light"
                         style="min-height:90px;">

                        @(string.IsNullOrWhiteSpace(Model.Descripcion)
                            ? "Sin descripción registrada."
                            : Model.Descripcion)

                    </div>

                </div>

               


              
            </div>

        </div>

    </div>


    <div class="card shadow-sm border-0 mt-3">

        <div class="card-header text-white fw-bold"
             style="background-color:#0F5C64;">
            Resumen de relaciones
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4">
                    <div class="d-flex mb-3">
                        <span class="fw-bold me-3">Cuentas por Cobrar:</span>
                        <span>@(ViewBag.TotalCxC ?? 0)</span>
                    </div>

                    <div class="d-flex mb-3">
                        <span class="fw-bold me-3">Cuentas por Pagar:</span>
                        <span>@(ViewBag.TotalCxP ?? 0)</span>
                    </div>
                </div>

                <div class="col-md-4">
                        <div class="d-flex mb-3">
                            <span class="fw-bold me-3">Facturas asociadas:</span>
                            <span>@(ViewBag.TotalFacturas ?? 0)</span>
                        </div>

                        <div class="d-flex  mb-3">
                            <span class="fw-bold me-3">Movimientos contables:</span>
                            <span>@(ViewBag.TotalMovimientos ?? 0)</span>
                        </div>
                
                </div>
                <div class="col-md-4">
                        <div class="d-flex  mb-3">
                            <span class="fw-bold me-3">Presupuestos mensuales:</span>
                            <span>@(ViewBag.TotalPresupuestos ?? 0)</span>
                        </div>
                </div>
            </div>

        </div>

    </div>

    <div class="alert alert-info mt-3">
        <i class="fas fa-info-circle"></i>
        Este proyecto forma parte del sistema financiero de la asociación.
        Los ingresos, gastos, cuentas por cobrar, cuentas por pagar,
        presupuestos y movimientos contables pueden asociarse a este proyecto
        para mantener la trazabilidad financiera.
    </div>

    <div class="mt-3">
        <a asp-action="Index"
           class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i> Volver al listado
        </a>
        @if (Model.Activo)
        {
            <a asp-action="Edit"
               asp-route-id="@Model.IdProyecto"
               class="btn btn-warning">

                <i class="fas fa-edit"></i>

                Modificar

            </a>
        }

       

    </div>

</div>