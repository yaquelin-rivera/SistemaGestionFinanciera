@model SistemaGestionFinanciera.Models.CuentasPorCobrar
@{
    ViewData["Title"] = "Modificar Cuenta por Cobrar";
    var tienePagos = (Model.MontoPagado ?? 0) > 0;
}
<div class="container-fluid mt-4">

    <div class="mb-3">
        <h2 class="mb-0">Modificar Cuenta por Cobrar</h2>
        <small class="text-muted">Actualización de datos del cobro pendiente</small>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-header bg-dark text-white fw-bold">
            Complete la información que desea modificar
        </div>

        <div class="card-body">

            <div class="alert alert-secondary mb-4">
                El número de documento, saldos y estado son controlados automáticamente por el sistema.
            </div>
           
            @if (tienePagos)
            {
                <div class="alert alert-warning mb-4">
                    Esta cuenta ya registra pagos. Solo se permite modificar la observación para mantener la información financiera correcta.
                </div>
            }
            <form asp-action="Edit"
                  asp-route-id="@Model.IdCuentaPorCobrar"
                  method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="IdCuentaPorCobrar" />
                @if (tienePagos)
                {
                    <input type="hidden" asp-for="ClienteBeneficiarioId" />
                    <input type="hidden" asp-for="ProyectoId" />
                    <input type="hidden" asp-for="PresupuestoMensualId" />
                    <input type="hidden" asp-for="TipoDocumento" />
                    <input type="hidden" asp-for="DiasCredito" />
                    <input type="hidden" asp-for="Concepto" />
                    <input type="hidden" asp-for="MontoOriginal" />
                }

                <p class="text-primary fw-bold mb-2">Información general</p>
                <hr />

                <div class="row mb-3">

                    <div class="col-md-4 mb-3">
                        <label asp-for="ClienteBeneficiarioId" class="form-label">Cliente / Beneficiario</label>
                        <select asp-for="ClienteBeneficiarioId"
                                class="form-control"
                                asp-items="ViewBag.ClienteBeneficiarioId"
                                disabled="@tienePagos">
                            <option value="">-- Seleccione un cliente --</option>
                        </select>
                        <span asp-validation-for="ClienteBeneficiarioId" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">

                        <label class="form-label">
                            Proyecto / período presupuestario
                        </label>

                        <select id="SeleccionProyectoPeriodoCxC"
                                name="SeleccionProyectoPeriodoCxC"
                                class="form-control"
                                asp-items="ViewBag.OpcionesProyectoPeriodoCxC"
                                disabled="@tienePagos">

                            <option value="">
                                -- Seleccione proyecto y período --
                            </option>

                        </select>

                        <span asp-validation-for="ProyectoId"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="TipoDocumento" class="form-label">Tipo de documento</label>
                        <select asp-for="TipoDocumento"
                                class="form-control"
                                asp-items="ViewBag.TiposDocumento"
                                disabled="disabled">
                            <option value="">-- Seleccione el tipo --</option>
                        </select>

                        <input type="hidden" asp-for="TipoDocumento" />
                        <span asp-validation-for="TipoDocumento" class="text-danger"></span>
                    </div>

                </div>

                <p class="text-primary fw-bold mt-4 mb-2">Datos del crédito</p>
                <hr />

                <div class="row mb-3">

                    <div class="col-md-3 mb-3">
                        <label class="form-label">N° Documento</label>
                        <input value="@Model.NumeroDocumento" class="form-control" readonly />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label asp-for="DiasCredito" class="form-label">Días de crédito</label>
                        <select asp-for="DiasCredito"
                                id="DiasCredito"
                                class="form-control"
                                asp-items="ViewBag.DiasCredito"
                                disabled="@tienePagos">
                            <option value="">-- Seleccione días --</option>
                        </select>
                        <span asp-validation-for="DiasCredito" class="text-danger"></span>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">Fecha de emisión</label>
                        <input value="@Model.FechaEmision.ToString("dd/MM/yyyy")" class="form-control" readonly />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">Fecha de vencimiento</label>
                        <input id="fechaVencimientoVista"
                               value="@Model.FechaVencimiento.ToString("dd/MM/yyyy")"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label asp-for="MontoOriginal" class="form-label">Monto original</label>
                        <input asp-for="MontoOriginal"
                               type="text"
                               class="form-control"
                               placeholder="Ej: 500000.50"
                               oninput="this.value = this.value.replace(',', '.')" disabled="@tienePagos" />
                        <span asp-validation-for="MontoOriginal" class="text-danger"></span>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">Monto pagado</label>
                        <input value="₡@((Model.MontoPagado ?? 0).ToString("N2"))"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">Saldo pendiente</label>
                        <input value="₡@Model.SaldoPendiente.ToString("N2")"
                               class="form-control text-danger fw-bold"
                               readonly />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">Estado</label>
                        <input value="@Model.Estado"
                               class="form-control"
                               readonly />
                    </div>

                </div>

                <p class="text-primary fw-bold mt-4 mb-2">Detalle del cobro</p>
                <hr />

                <div class="row mb-3">

                    <div class="col-md-5 mb-3">
                        <label asp-for="Concepto" class="form-label">Concepto</label>
                        <input asp-for="Concepto"
                               class="form-control"
                               placeholder="Ej: Donación pendiente para actividad comunal" disabled="@tienePagos" />
                        <span asp-validation-for="Concepto" class="text-danger"></span>
                    </div>

                    <div class="col-md-7 mb-3">
                        <label asp-for="Observacion" class="form-label">Observación</label>
                        <textarea asp-for="Observacion"
                                  class="form-control"
                                  rows="2"
                                  placeholder="Observaciones del registro"></textarea>
                        <span asp-validation-for="Observacion" class="text-danger"></span>
                        <small class="text-muted">
                            Puede anotar acuerdos de pago, notas o información adicional.
                        </small>
                    </div>

                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Volver al listado
                    </a>

                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Guardar
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>
<style>
    select:disabled,
    input:disabled,
    textarea:disabled,
    input[readonly] {
        background-color: #e5e7eb !important;
        color: #374151 !important;
        cursor: not-allowed;
    }
</style>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const diasCredito = document.getElementById("DiasCredito");
            const fechaVencimiento = document.getElementById("fechaVencimientoVista");

            function calcularFechaVencimiento() {

                if (!diasCredito.value) {
                    fechaVencimiento.value = "Se calculará automáticamente";
                    return;
                }

                const fechaTexto = "@Model.FechaEmision.ToString("yyyy-MM-dd")";
                const fechaBase = new Date(fechaTexto + "T00:00:00");

                fechaBase.setDate(fechaBase.getDate() + parseInt(diasCredito.value));

                const dia = String(fechaBase.getDate()).padStart(2, "0");
                const mes = String(fechaBase.getMonth() + 1).padStart(2, "0");
                const anio = fechaBase.getFullYear();

                fechaVencimiento.value = `${dia}/${mes}/${anio}`;
            }

            diasCredito.addEventListener("change", calcularFechaVencimiento);
        });
    </script>
}