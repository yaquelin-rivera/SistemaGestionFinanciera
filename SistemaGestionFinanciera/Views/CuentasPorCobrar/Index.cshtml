@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const existenRegistros =
        @Html.Raw(Model.Any().ToString().ToLower());

            if (existenRegistros &&
                typeof $ !== "undefined" &&
                $.fn.DataTable) {

                if ($.fn.DataTable.isDataTable('#tablaCuentasCobrar')) {
                    $('#tablaCuentasCobrar').DataTable().destroy();
                }

                $('#tablaCuentasCobrar').DataTable({

                    pageLength: 10,

                    lengthMenu: [
                        [10, 25, 50, 100],
                        [10, 25, 50, 100]
                    ],

                    //RESPETA EL ORDEN Q LE DICTA EL CONTROLADOR 
                    order: [],

                    autoWidth: false,
                    responsive: false,

                    columnDefs: [
                        {
                            targets: [12],
                            orderable: false,
                            searchable: false
                        }
                    ],

                    language: {
                        info: 'Mostrando _START_ a _END_ de _TOTAL_ cuentas por cobrar',
                        infoEmpty: 'Mostrando 0 a 0 de 0 cuentas por cobrar',
                        infoFiltered: '(filtrado de _MAX_ cuentas totales)',
                        lengthMenu: 'Mostrar _MENU_ cuentas por cobrar',
                        loadingRecords: 'Cargando...',
                        processing: 'Procesando...',
                        search: 'Buscar:',
                        searchPlaceholder: 'Buscar cuenta...',
                        zeroRecords: 'No se encontraron cuentas por cobrar.',
                        paginate: {
                            first: 'Primero',
                            last: 'Último',
                            next: 'Siguiente',
                            previous: 'Anterior'
                        }
                    }

                });
            }

        });
    </script>
}