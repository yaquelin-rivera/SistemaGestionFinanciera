@model SistemaGestionFinanciera.Models.Permiso

@{
    ViewData["Title"] = "Crear Permiso";
}

<div class="container-fluid mt-4">

    <div class="mb-3">
        <h2 class="fw-bold mb-0">Crear Permiso</h2>
        <small class="text-muted">
            Registro de un nuevo permiso para el sistema financiero.
        </small>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-header bg-dark text-white fw-bold">
            <i class="fas fa-key me-2"></i>
            Datos del permiso
        </div>

        <div class="card-body">

            <form asp-action="Create" method="post" novalidate>

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>

                <div class="row g-3">

                    <div class="col-md-6">

                        <label asp-for="Nombre"
                               class="form-label fw-semibold"></label>

                        <input asp-for="Nombre"
                               class="form-control"
                               maxlength="100"
                               placeholder="Ejemplo: Gestionar Usuarios" />

                        <span asp-validation-for="Nombre"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-6">

                        <label class="form-label fw-semibold">
                            Estado
                        </label>

                        <div class="mt-1">
                            <span class="badge bg-success fs-6 px-3 py-2">
                                <i class="fas fa-check-circle me-1"></i>
                                Activo
                            </span>
                        </div>

                        <small class="text-muted d-block mt-2">
                            Todo permiso nuevo se registra activo automáticamente.
                        </small>

                    </div>

                    <div class="col-md-12">

                        <label asp-for="Descripcion"
                               class="form-label fw-semibold"></label>

                        <textarea asp-for="Descripcion"
                                  class="form-control"
                                  rows="4"
                                  maxlength="250"
                                  placeholder="Describa brevemente la finalidad del permiso..."></textarea>

                        <span asp-validation-for="Descripcion"
                              class="text-danger"></span>

                    </div>

                </div>

                <div class="mt-4 d-flex gap-2">
                    <a asp-action="Index"
                       class="btn btn-secondary">

                        <i class="fas fa-arrow-left me-1"></i>
                        Volver al listado

                    </a>

                    <button type="submit"
                            class="btn btn-success">

                        <i class="fas fa-save me-1"></i>
                        Guardar

                    </button>

                    

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}