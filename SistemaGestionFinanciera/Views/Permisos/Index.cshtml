@model IEnumerable<SistemaGestionFinanciera.Models.Permiso>

@{
    ViewData["Title"] = "Permisos";

    var totalPermisos = Model.Count();
    var permisosActivos = Model.Count(p => p.Activo);
    var permisosInactivos = Model.Count(p => !p.Activo);
}



<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold mb-0">Gestión de Permisos</h2>
            <small class="text-muted">Administración de permisos disponibles para los roles del sistema</small>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus-circle me-1"></i> Registrar
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-start border-primary border-4 card-resumen h-100">
                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <small class="fw-bold">Total de permisos</small>
                        <h3 class="fw-bold text-primary mb-0">@totalPermisos</h3>
                    </div>

                    <i class="fas fa-key fa-2x text-muted opacity-50"></i>

                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-start border-success border-4 card-resumen h-100">
                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <small class="fw-bold">Permisos activos</small>
                        <h3 class="fw-bold text-success mb-0">@permisosActivos</h3>
                    </div>

                    <i class="fas fa-lock-open fa-2x text-muted opacity-50"></i>

                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-start border-warning border-4 card-resumen h-100">
                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <small class="fw-bold">Permisos inactivos</small>
                        <h3 class="fw-bold text-warning mb-0">@permisosInactivos</h3>
                    </div>

                    <i class="fas fa-lock fa-2x text-muted opacity-50"></i>

                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-dark text-white fw-bold">

            <i class="fas fa-filter me-2"></i>
            Filtros de búsqueda

        </div>

        <div class="card-body">

            <form id="formFiltrosPermisos"
                  method="get"
                  asp-action="Index">

                <div class="d-flex align-items-end gap-2 w-100 flex-wrap">

                    <!-- BUSCAR -->
                    <div class="col-md-3">

                        <label class="form-label fw-bold">

                            <i class="fas fa-search text-muted me-1"></i>
                            Buscar

                        </label>

                        <input type="text"
                               id="filtroBuscarPermiso"
                               name="buscar"
                               value="@ViewBag.Buscar"
                               class="form-control"
                               placeholder="Nombre o descripción..." />

                    </div>

                    <!-- ESTADO -->
                    <div class="col-md-2">

                        <label class="form-label fw-bold">

                            <i class="fas fa-toggle-on text-muted me-1"></i>
                            Estado

                        </label>

                        <select id="filtroEstadoPermiso"
                                name="estado"
                                class="form-select">

                            <option value="">
                                Todos
                            </option>

                            <option value="Activo"
                                    selected="@(ViewBag.Estado == "Activo")">

                                Activos

                            </option>

                            <option value="Inactivo"
                                    selected="@(ViewBag.Estado == "Inactivo")">

                                Inactivos

                            </option>

                        </select>

                    </div>

                    <!-- BOTONES DE FILTRO -->
                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="fas fa-search me-1"></i>
                            Buscar

                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">

                            <i class="fas fa-eraser me-1"></i>
                            Limpiar

                        </a>

                    </div>

                    <!-- BOTONES DE REPORTE -->
                    <div class="d-flex gap-2 ms-auto">

                        <button type="button"
                                id="btnReportePermisos"
                                class="btn btn-info">

                            <i class="fas fa-file-pdf me-1"></i>
                            Vista previa PDF

                        </button>

                        <button type="button"
                                id="btnExcelPermisos"
                                class="btn btn-success">

                            <i class="fas fa-file-excel me-1"></i>
                            Exportar Excel

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white fw-bold">
            <i class="fas fa-key me-2"></i>Lista de permisos registrados
        </div>

        <div class="card-body">

            <div class="table-responsive">
                <table id="tablaPermisos" class="table table-striped table-hover align-middle w-100 tabla-sistema">
                    <thead class="table-light">
                        <tr>
                            <th><i class="fas fa-key me-1"></i>Nombre</th>
                            <th><i class="fas fa-align-left me-1"></i>Descripción</th>
                            <th><i class="fas fa-toggle-on me-1"></i>Estado</th>
                            <th><i class="fas fa-calendar-alt me-1"></i>Fecha creación</th>
                            <th class="text-end"><i class="fas fa-cogs me-1"></i>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                      
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.Nombre</td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.Descripcion))
                                        {
                                            @item.Descripcion
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sin descripción</span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.Activo)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactivo</span>
                                        }
                                    </td>

                                    <td>
                                        @(item.FechaCreacion.HasValue
                                            ? item.FechaCreacion.Value.ToString("dd/MM/yyyy HH:mm")
                                            : "Sin fecha")
                                    </td>

                                    <td class="col-acciones text-end">
                                        <div class="acciones-botones justify-content-end">

                                            <a asp-action="Details"
                                               asp-route-id="@item.IdPermiso"
                                               class="btn btn-primary btn-sm btn-accion">
                                                <i class="fas fa-eye"></i> Detalles
                                            </a>

                                            @if (item.Activo)
                                            {
                                                <a asp-action="Edit"
                                                   asp-route-id="@item.IdPermiso"
                                                   class="btn btn-warning btn-sm btn-accion">
                                                    <i class="fas fa-edit"></i> Modificar
                                                </a>

                                                <form asp-action="Delete"
                                                      asp-route-id="@item.IdPermiso"
                                                      method="post"
                                                      class="d-inline form-desactivar">
                                                    @Html.AntiForgeryToken()

                                                    <button type="submit" class="btn btn-danger btn-sm btn-accion">
                                                        <i class="fas fa-ban"></i> Desactivar
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="Activar"
                                                      asp-route-id="@item.IdPermiso"
                                                      method="post"
                                                      class="d-inline form-activar">
                                                    @Html.AntiForgeryToken()

                                                    <button type="submit" class="btn btn-success btn-sm btn-accion">
                                                        <i class="fas fa-check"></i> Activar
                                                    </button>
                                                </form>
                                            }

                                        </div>
                                    </td>
                                </tr>
                            }
                        
                    </tbody>
                </table>
            </div>

        </div>
    </div>

</div>

@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            // =====================================================
            // DATATABLE
            // =====================================================

            if (typeof $ !== "undefined" &&
                $.fn.DataTable &&
                document.getElementById("tablaPermisos")) {

                if ($.fn.DataTable.isDataTable("#tablaPermisos")) {

                    $("#tablaPermisos").DataTable().destroy();

                }

                $("#tablaPermisos").DataTable({

                    pageLength: 10,

                    lengthMenu: [
                        [10, 25, 50, 100],
                        [10, 25, 50, 100]
                    ],

                    ordering: true,

                    // Mantener el orden recibido del controlador
                    order: [],

                    searching: true,
                    paging: true,
                    info: true,
                    autoWidth: false,
                    responsive: false,
                    scrollX: false,

                    columnDefs: [
                        {
                            targets: -1,
                            orderable: false,
                            searchable: false
                        }
                    ],

                    language: {

                        lengthMenu:
                            "Mostrar _MENU_ registros",

                        search:
                            "Buscar en la tabla:",

                        searchPlaceholder:
                            "Buscar permiso...",

                        zeroRecords:
                            "No se encontraron permisos.",

                        emptyTable:
                            "No hay permisos registrados.",

                        info:
                            "Mostrando _START_ a _END_ de _TOTAL_ registros",

                        infoEmpty:
                            "Mostrando 0 registros",

                        infoFiltered:
                            "(filtrado de _MAX_ registros)",

                        paginate: {

                            first:
                                "Primero",

                            last:
                                "Último",

                            next:
                                "Siguiente",

                            previous:
                                "Anterior"
                        }
                    }
                });

            }

            // =====================================================
            // FILTROS
            // =====================================================

            const formFiltrosPermisos =
                document.getElementById("formFiltrosPermisos");

            const filtroBuscarPermiso =
                document.getElementById("filtroBuscarPermiso");

            const filtroEstadoPermiso =
                document.getElementById("filtroEstadoPermiso");

            // =====================================================
            // FILTRO ESTADO
            // =====================================================

            if (filtroEstadoPermiso && formFiltrosPermisos) {

                filtroEstadoPermiso.addEventListener(
                    "change",
                    function () {

                        formFiltrosPermisos.submit();

                    });

            }

            // =====================================================
            // BUSCADOR AUTOMÁTICO
            // =====================================================

            if (filtroBuscarPermiso && formFiltrosPermisos) {

                let temporizadorBusqueda;

                filtroBuscarPermiso.addEventListener(
                    "input",
                    function () {

                        clearTimeout(temporizadorBusqueda);

                        temporizadorBusqueda =
                            setTimeout(function () {

                                formFiltrosPermisos.submit();

                            }, 600);

                    });

            }

            // =====================================================
            // OBTENER PARÁMETROS
            // =====================================================

            function obtenerParametrosPermisos() {

                return new URLSearchParams({

                    buscar:
                        filtroBuscarPermiso
                            ? filtroBuscarPermiso.value.trim()
                            : "",

                    estado:
                        filtroEstadoPermiso
                            ? filtroEstadoPermiso.value
                            : ""

                });

            }

            // =====================================================
            // REPORTE PDF
            // =====================================================

            const btnReportePermisos =
                document.getElementById("btnReportePermisos");

            if (btnReportePermisos) {

                btnReportePermisos.addEventListener(
                    "click",
                    function () {

                        const parametros =
                            obtenerParametrosPermisos();

                        const url =
                            '@Url.Action("Reporte", "Permisos")'
                            + "?"
                            + parametros.toString();

                        window.location.href = url;

                    });

            }

            // =====================================================
            // EXCEL
            // =====================================================

            const btnExcelPermisos =
                document.getElementById("btnExcelPermisos");

            if (btnExcelPermisos) {

                btnExcelPermisos.addEventListener(
                    "click",
                    function () {

                        const parametros =
                            obtenerParametrosPermisos();

                        const url =
                            '@Url.Action("ExportarExcel", "Permisos")'
                            + "?"
                            + parametros.toString();

                        window.location.href = url;

                    });

            }

            // =====================================================
            // DESACTIVAR
            // =====================================================

            document
                .querySelectorAll(".form-desactivar")
                .forEach(function (formulario) {

                    formulario.addEventListener(
                        "submit",
                        async function (evento) {

                            evento.preventDefault();

                            const confirmado =
                                await confirmarDesactivacion(
                                    "El permiso dejará de estar disponible para asignarse a los roles del sistema."
                                );

                            if (confirmado) {

                                formulario.submit();

                            }

                        });

                });

            // =====================================================
            // ACTIVAR
            // =====================================================

            document
                .querySelectorAll(".form-activar")
                .forEach(function (formulario) {

                    formulario.addEventListener(
                        "submit",
                        async function (evento) {

                            evento.preventDefault();

                            const confirmado =
                                await confirmarReactivacion(
                                    "El permiso volverá a estar disponible para asignarse a los roles del sistema."
                                );

                            if (confirmado) {

                                formulario.submit();

                            }

                        });

                });

        });

    </script>

}