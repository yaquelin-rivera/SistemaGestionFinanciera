@model SistemaGestionFinanciera.Models.Proveedore

@{
    ViewData["Title"] = "Desactivar proveedor";
}

<div class="container-fluid mt-4">

    <div class="mb-3">
        <h2 class="fw-bold mb-0">Desactivar proveedor</h2>
        <small class="text-muted">
            Confirmación para desactivar el proveedor del sistema.
        </small>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-header bg-danger text-white fw-bold">
            <i class="fas fa-ban me-1"></i>
            Confirmación
        </div>

        <div class="card-body">

            <div class="alert alert-warning shadow-sm">
                <i class="fas fa-exclamation-triangle me-1"></i>
                ¿Está seguro que desea desactivar este proveedor?
                El proveedor dejará de estar disponible para nuevos registros,
                pero se conservará para mantener la trazabilidad del sistema.
            </div>

            <div class="row g-3">

                <div class="col-md-6">
                    <div class="border rounded p-3 bg-light h-100">
                        <small class="text-muted">Nombre</small>
                        <div class="fw-semibold">@Model.Nombre</div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="border rounded p-3 bg-light h-100">
                        <small class="text-muted">Identificación</small>
                        <div class="fw-semibold">@Model.Identificacion</div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="border rounded p-3 bg-light h-100">
                        <small class="text-muted">Estado</small>
                        <div>
                            @if (Model.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="border rounded p-3 bg-light h-100">
                        <small class="text-muted">Teléfono</small>
                        <div class="fw-semibold">
                            @(string.IsNullOrWhiteSpace(Model.Telefono) ? "No registrado" : Model.Telefono)
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="border rounded p-3 bg-light h-100">
                        <small class="text-muted">Correo electrónico</small>
                        <div class="fw-semibold">
                            @(string.IsNullOrWhiteSpace(Model.Email) ? "No registrado" : Model.Email)
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="border rounded p-3 bg-light h-100">
                        <small class="text-muted">Dirección</small>
                        <div class="fw-semibold">
                            @(string.IsNullOrWhiteSpace(Model.Direccion) ? "No registrada" : Model.Direccion)
                        </div>
                    </div>
                </div>

            </div>

            <form asp-action="Delete" method="post" class="mt-4">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="IdProveedor" />

                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-ban me-1"></i> Desactivar proveedor
                </button>

                <a asp-action="Details"
                   asp-route-id="@Model.IdProveedor"
                   class="btn btn-info">
                    <i class="fas fa-eye me-1"></i> Ver detalles
                </a>

                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-1"></i> Volver al listado
                </a>

            </form>

        </div>

    </div>

</div>