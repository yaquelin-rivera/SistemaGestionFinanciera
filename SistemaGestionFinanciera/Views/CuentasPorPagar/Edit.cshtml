@model SistemaGestionFinanciera.Models.CuentasPorPagar

@{
    ViewData["Title"] = "Modificar Cuenta por Pagar";
    var tienePagos = (Model.MontoPagado ?? 0) > 0;
}

<div class="container-fluid mt-4">

    <div class="mb-3">
        <h2 class="mb-0">Modificar Cuenta por Pagar</h2>
        <small class="text-muted">Actualización de datos del pago pendiente</small>
    </div>
    @if (Model.EstadoAutorizacion == "Rechazado")
    {
        <div class="alert alert-danger mb-3">

            <div class="fw-bold mb-2">
                <i class="fas fa-circle-exclamation me-1"></i>
                Esta cuenta por pagar fue rechazada por el Contador.
            </div>

            @if (!string.IsNullOrWhiteSpace(ViewBag.MotivoRechazo as string))
            {
                <div class="mb-2">
                    <strong>Motivo del rechazo:</strong>
                    @ViewBag.MotivoRechazo
                </div>
            }

            <div>
                Corrija la información indicada y guarde nuevamente.
                La cuenta por pagar volverá al estado
                <strong>Pendiente de autorización</strong>
                para una nueva revisión.
            </div>

        </div>
    }
    <div class="card shadow-sm border-0">

        <div class="card-header bg-dark text-white fw-bold">
            Complete la información que desea modificar
        </div>

        <div class="card-body">

            <div class="alert alert-secondary mb-4">
                El número de documento, fechas, saldos y estado son controlados automáticamente por el sistema.
            </div>

            @if (tienePagos)
            {
                <div class="alert alert-warning mb-4">
                    Esta cuenta ya registra pagos. Solo se permite modificar la observación para mantener la información financiera correcta.
                </div>
                
            }

            <form asp-action="Edit"
                  asp-route-id="@Model.IdCuentaPorPagar"
                  method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="IdCuentaPorPagar" />

                @if (tienePagos)
                {
                    <input type="hidden" asp-for="ProveedorId" />
                    <input type="hidden" asp-for="ProyectoId" />
                    <input type="hidden" asp-for="CategoriaGastoId" />
                    <input type="hidden" asp-for="CentroCostoId" />
                    <input type="hidden" asp-for="TipoDocumento" />
                    <input type="hidden" asp-for="DiasCredito" />
                    <input type="hidden" asp-for="TipoImpuesto" />
                    <input type="hidden" asp-for="NumeroFactura" />
                    <input type="hidden" asp-for="Concepto" />
                }
                <p class="text-primary fw-bold mb-2">Información general</p>
                <hr />
                <div class="row mb-3">

                    <div class="col-md-3 mb-3">
                        <label asp-for="ProveedorId" class="form-label">Proveedor / Acreedor</label>
                        <select asp-for="ProveedorId"
                                class="form-control"
                                asp-items="ViewBag.ProveedorId"
                                disabled="@tienePagos">
                            <option value="">-- Seleccione un proveedor --</option>
                        </select>
                        <span asp-validation-for="ProveedorId" class="text-danger"></span>
                    </div>

                    <div class="col-md-2 mb-3">
                        <label asp-for="CategoriaGastoId" class="form-label">Categoría de gasto</label>
                        <select asp-for="CategoriaGastoId"
                                class="form-control"
                                asp-items="ViewBag.CategoriaGastoId"
                                disabled="@tienePagos">
                            <option value="">-- Seleccione una categoría --</option>
                        </select>
                        <span asp-validation-for="CategoriaGastoId" class="text-danger"></span>
                    </div>

                    <div class="col-md-2 mb-3">
                        <label asp-for="CentroCostoId" class="form-label">Centro de costo</label>
                        <select asp-for="CentroCostoId"
                                class="form-control"
                                asp-items="ViewBag.CentroCostoId"
                                disabled="@tienePagos">
                            <option value="">-- Seleccione un centro --</option>
                        </select>
                        <span asp-validation-for="CentroCostoId" class="text-danger"></span>
                    </div>

                    <div class="col-md-3 mb-3">

                        <label asp-for="PresupuestoMensualId"
                               class="form-label">
                            Proyecto / período presupuestario
                        </label>

                        <select asp-for="PresupuestoMensualId"
                                class="form-control"
                                asp-items="ViewBag.PresupuestosMensualId">

                            <option value="">
                                -- Seleccione un proyecto y período --
                            </option>

                        </select>

                        <span asp-validation-for="PresupuestoMensualId"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-2 mb-3">
                        <label asp-for="TipoDocumento" class="form-label">Tipo de documento</label>

                        <select asp-for="TipoDocumento"
                                class="form-control"
                                asp-items="ViewBag.TiposDocumento"
                                disabled="disabled">
                        </select>

                        <input type="hidden" asp-for="TipoDocumento" />

                        <span asp-validation-for="TipoDocumento" class="text-danger"></span>
                    </div>

                </div>

                <p class="text-primary fw-bold mt-4 mb-2">Datos del crédito</p>
                <hr />

                <div class="row mb-3">

                    <div class="col-md-2 mb-3">
                        <label class="form-label">N° Documento</label>
                        <input value="@Model.NumeroDocumento" class="form-control" readonly />
                    </div>

                    <div class="col-md-2 mb-3">
                        <label asp-for="DiasCredito" class="form-label">Días de crédito</label>
                        <select asp-for="DiasCredito"
                                class="form-control"
                                asp-items="ViewBag.DiasCredito"
                                id="DiasCredito"
                                disabled="@tienePagos">
                            <option value="">-- Seleccione días --</option>
                        </select>
                        <span asp-validation-for="DiasCredito" class="text-danger"></span>
                    </div>

                    <div class="col-md-2 mb-3">
                        <label class="form-label">Fecha de emisión</label>
                        <input value="@Model.FechaEmision.ToString("dd/MM/yyyy")" class="form-control" readonly />
                    </div>

                    <div class="col-md-2 mb-3">
                        <label class="form-label">Fecha de vencimiento</label>
                        <input id="fechaVencimientoVista"
                               value="@Model.FechaVencimiento.ToString("dd/MM/yyyy")"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="col-md-2 mb-3">
                        <label asp-for="NumeroFactura" class="form-label">N° factura proveedor</label>
                        <input asp-for="NumeroFactura"
                               class="form-control"
                               placeholder="Ej: FAC-45879"
                               disabled="@tienePagos" />
                        <span asp-validation-for="NumeroFactura" class="text-danger"></span>
                        <small class="text-muted">Opcional.</small>
                    </div>

                </div>

                <p class="text-primary fw-bold mt-4 mb-2">Resumen financiero</p>
                <hr />

                <div class="row mb-3">

                    <div class="col-md-3 mb-3">
                        <label asp-for="MontoOriginal" class="form-label">Monto original</label>
                        <input asp-for="MontoOriginal"
                               id="MontoOriginal"
                               type="text"
                               class="form-control"
                               placeholder="Ej: 500000.50"
                               oninput="this.value = this.value.replace(',', '.')"
                               disabled="@tienePagos" />
                        <span asp-validation-for="MontoOriginal" class="text-danger"></span>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label asp-for="Descuento" class="form-label">Descuento</label>
                        <input asp-for="Descuento"
                               id="Descuento"
                               type="text"
                               class="form-control"
                               placeholder="Ej: 10000"
                               oninput="this.value = this.value.replace(',', '.')"
                               disabled="@tienePagos" />
                        <span asp-validation-for="Descuento" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="TipoImpuesto" class="form-label">Tipo de impuesto</label>

                        <select asp-for="TipoImpuesto"
                                id="TipoImpuesto"
                                class="form-control"
                                asp-items="ViewBag.TiposImpuesto"
                                disabled="@tienePagos">
                        </select>

                        <span asp-validation-for="TipoImpuesto"
                              class="text-danger"></span>
                    </div>
                    <div class="col-md-2 mb-3">
                        <label class="form-label">Impuesto</label>

                        <input id="ImpuestoVista"
                               value="₡@((Model.Impuesto ?? 0).ToString("N2"))"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="col-md-2 mb-3">
                        <label class="form-label">Subtotal</label>
                        <input id="SubTotalVista"
                               value="₡@((Model.SubTotal ?? 0).ToString("N2"))"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="col-md-2 mb-3">
                        <label class="form-label">Monto pagado</label>
                        <input value="₡@((Model.MontoPagado ?? 0).ToString("N2"))"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="col-md-2 mb-3">
                        <label class="form-label">Anticipo aplicado</label>
                        <input value="₡@((Model.AnticipoAplicado ?? 0).ToString("N2"))"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="col-md-2 mb-3">
                        <label class="form-label">Saldo pendiente</label>
                        <input id="SaldoPendienteVista"
                               value="₡@Model.SaldoPendiente.ToString("N2")"
                               class="form-control text-danger fw-bold"
                               readonly />
                    </div>

                    <div class="col-md-2 mb-3">
                        <label class="form-label">Estado</label>
                        <input value="@Model.Estado"
                               class="form-control"
                               readonly />
                    </div>

                </div>

                <p class="text-primary fw-bold mt-4 mb-2">Detalle del pago pendiente</p>
                <hr />

                <div class="row mb-3">

                    <div class="col-md-4 mb-3">
                        <label asp-for="Concepto" class="form-label">Concepto</label>
                        <input asp-for="Concepto"
                               class="form-control"
                               placeholder="Ej: Compra de materiales de oficina pendiente de pago"
                               disabled="@tienePagos" />
                        <span asp-validation-for="Concepto" class="text-danger"></span>
                    </div>

                    <div class="col-md-5 mb-3">
                        <label asp-for="Observacion" class="form-label">Observación</label>
                        <textarea asp-for="Observacion"
                                  class="form-control"
                                  rows="2"
                                  placeholder="Observaciones del registro"></textarea>
                        <span asp-validation-for="Observacion" class="text-danger"></span>
                        <small class="text-muted">
                            Puede anotar acuerdos de pago, referencia de factura, notas o información adicional.
                        </small>
                    </div>

                </div>

                <div class="d-flex  mt-4 gap-3">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Volver al listado
                    </a>

                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Guardar 
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

<style>
    select:disabled,
    input:disabled,
    textarea:disabled,
    input[readonly] {
        background-color: #e5e7eb !important;
        color: #374151 !important;
        cursor: not-allowed;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const montoOriginal = document.getElementById("MontoOriginal");
            const descuento = document.getElementById("Descuento");
            const tipoImpuesto = document.getElementById("TipoImpuesto");

            const impuestoVista = document.getElementById("ImpuestoVista");
            const subtotalVista = document.getElementById("SubTotalVista");
            const saldoPendienteVista = document.getElementById("SaldoPendienteVista");

            const diasCredito = document.getElementById("DiasCredito");
            const fechaVencimiento = document.getElementById("fechaVencimientoVista");

            function formatoColones(valor) {
                return "₡" + valor.toLocaleString("es-CR", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
            }

            function valorDecimal(input) {
                if (!input) return 0;
                const valor = parseFloat((input.value || "0").replace(",", "."));
                return isNaN(valor) ? 0 : valor;
            }

            function calcularFechaVencimiento() {

                if (!diasCredito || !diasCredito.value) {
                    return;
                }

                const fechaTexto = "@Model.FechaEmision.ToString("yyyy-MM-dd")";
                const fechaBase = new Date(fechaTexto + "T00:00:00");

                fechaBase.setDate(fechaBase.getDate() + parseInt(diasCredito.value));

                const dia = String(fechaBase.getDate()).padStart(2, "0");
                const mes = String(fechaBase.getMonth() + 1).padStart(2, "0");
                const anio = fechaBase.getFullYear();

                fechaVencimiento.value = `${dia}/${mes}/${anio}`;
            }
            function calcularTotales() {

                const monto = valorDecimal(montoOriginal);
                const desc = valorDecimal(descuento);

                const subtotal = monto - desc;

                let porcentaje = 0;

                switch (tipoImpuesto.value) {
                    case "IVA 13%":
                        porcentaje = 0.13;
                        break;
                    case "IVA 4%":
                        porcentaje = 0.04;
                        break;
                    case "IVA 2%":
                        porcentaje = 0.02;
                        break;
                    case "IVA 1%":
                        porcentaje = 0.01;
                        break;
                    default:
                        porcentaje = 0;
                        break;
                }

                const impuesto = subtotal * porcentaje;
                const saldo = subtotal + impuesto;

                impuestoVista.value = formatoColones(impuesto);
                subtotalVista.value = formatoColones(subtotal);
                saldoPendienteVista.value = formatoColones(saldo);
            }

            if (diasCredito) {
                diasCredito.addEventListener("change", calcularFechaVencimiento);
            }

            if (montoOriginal) {
                montoOriginal.addEventListener("input", calcularTotales);
            }

            if (descuento) {
                descuento.addEventListener("input", calcularTotales);
            }

            if (tipoImpuesto) {
                tipoImpuesto.addEventListener("change", calcularTotales);
            }

            calcularFechaVencimiento();
            calcularTotales();
        });
    </script>
}

