@model SistemaGestionFinanciera.Models.Factura

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
   
    <meta charset="utf-8" />
    <title>Factura @Model.NumeroFactura</title>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f4f4f4;
            margin: 0;
            padding: 30px;
            color: #111;
        }

        .acciones {
            width: 850px;
            margin: 0 auto 15px auto;
            text-align: right;
        }

        .btn {
            padding: 8px 14px;
            border-radius: 4px;
            border: none;
            text-decoration: none;
            font-weight: bold;
            cursor: pointer;
            font-size: 14px;
        }

        .btn-imprimir {
            background: #0F7C90;
            color: white;
        }

        .btn-volver {
            background: #2F3B52;
            color: white;
        }

        .factura {
            width: 850px;
            
            margin: auto;
            background: white;
            padding: 25px;
            box-shadow: 0 0 8px rgba(0,0,0,0.15);
        }

        .encabezado {
            text-align: center;
            border-bottom: 3px solid #0F7C90;
            padding-bottom: 15px;
            margin-bottom: 12px;
        }

        .empresa {
            font-size: 28px;
            font-weight: bold;
        }

        .subtitulo {
            font-size: 14px;
            margin-top: 3px;
        }

        .titulo-factura {
            margin-top: 18px;
            font-size: 22px;
            font-weight: bold;
            color: #0F7C90;
        }

        .datos-empresa {
            font-size: 13px;
            margin-top: 8px;
            color: #444;
        }

        .info {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px 40px;
            margin-bottom: 25px;
            font-size: 14px;
        }

            .info div {
                padding: 4px 0;
            }

        .numero {
            color: #0059ff;
            font-size: 18px;
            font-weight: bold;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 8px;
            font-size: 14px;
        }

        th {
            background: #0F7C90;
            color: white;
            padding: 10px;
            border: 1px solid #0F7C90;
        }

        td {
            border: 1px solid #ccc;
            padding: 10px;
        }

        .text-end {
            text-align: right;
        }

        .totales {
            width: 42%;
            margin-left: auto;
            margin-top: 8px;
        }

        .total-final {
            font-size: 16px;
            font-weight: bold;
            background: #f1f1f1;
        }

        .observacion {
            margin-top: 15px;
            border: 1px solid #ddd;
            padding: 8px;
            min-height: 30px;
            background: #fafafa;
            font-size: 14px;
        }

        .pie {
            margin-top: 10px;
            text-align: center;
            font-size: 13px;
            color: #555;
            border-top: 1px solid #ccc;
            padding-top: 8px;
        }
        @@media print {
            body {
                background: white;
                padding: 0;
            }

            .acciones {
                display: none;
            }

            .factura {
                box-shadow: none;
                width: auto;
                min-height: auto;
                margin: 0;
            }

            .tabla-detalle {
                margin-top: 15px;
                font-size: 12px;
            }

                .tabla-detalle th {
                    padding: 8px;
                }

                .tabla-detalle td {
                    padding: 7px;
                }

        }
    </style>
</head>

<body>

    <div class="acciones">
        <a asp-action="Details"
           asp-route-id="@Model.IdFactura"
           class="btn btn-volver">
            <i class="fas fa-arrow-left me-1"></i>  Volver al detalle
        </a>
        <button onclick="window.print()" class="btn btn-imprimir">
            <i class="fas fa-print me-1" style="margin-right:6px;"></i>Imprimir / Guardar PDF
        </button>

  
    </div>

    <div class="factura">

        <div class="encabezado">
            <div class="empresa">UCADSA</div>

            <div class="subtitulo">
                Unión Cantonal de Asociaciones de Desarrollo de Santa Ana
            </div>

            <div class="datos-empresa">
                Santa Ana, San José, Costa Rica<br />
                Teléfono: 2582 2397 | Correo: unioncantonal@gmail.com<br />
                Cédula jurídica: 3101803815
            </div>

            <div class="titulo-factura">
                FACTURA DE VENTA
            </div>
        </div>

        <div class="info">

            <div>
                <strong>Número de factura:</strong><br />
                <span class="numero">@Model.NumeroFactura</span>
            </div>

            <div>
                <strong>Fecha de emisión:</strong><br />
                @Model.FechaEmision.ToString("dd/MM/yyyy")
            </div>

            <div>
                <strong>Cliente:</strong><br />
                @Model.ClienteBeneficiario?.Nombre
            </div>

            <div>
                <strong>Fecha de vencimiento:</strong><br />
                @(Model.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "No aplica")
            </div>

            <div>
                <strong>Condición de pago:</strong><br />
                @Model.CondicionPago
            </div>

            <div>
                <strong>Días de crédito:</strong><br />
                @(Model.DiasCredito.HasValue ? Model.DiasCredito + " días" : "No aplica")
            </div>

            <div>
                <strong>Estado:</strong><br />
                @Model.Estado
            </div>

            <div>
                <strong>Tipo de impuesto:</strong><br />
                @(Model.TipoImpuesto ?? "Sin impuesto")
            </div>

        </div>

        <table class="tabla-detalle">
            <thead>
                <tr>
                    <th style="width: 36%;">Detalle</th>
                    <th style="width: 10%; text-align:center;">Cantidad</th>
                    <th style="width: 14%; text-align:right;">Precio</th>
                    <th style="width: 13%; text-align:right;">Descuento</th>
                    <th style="width: 13%; text-align:right;">Impuesto</th>
                    <th style="width: 14%; text-align:right;">Total línea</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.FacturaDetalles != null && Model.FacturaDetalles.Any(d => d.Activo))
                {
                    foreach (var item in Model.FacturaDetalles.Where(d => d.Activo))
                    {
                        <tr>
                            <td>@item.Descripcion</td>
                            <td style="text-align:center;">
                                @item.Cantidad.ToString("N2")
                            </td>
                            <td style="text-align:right;">
                                ₡@item.PrecioUnitario.ToString("N2")
                            </td>
                            <td style="text-align:right;">
                                ₡@item.Descuento.ToString("N2")
                            </td>
                            <td style="text-align:right;">
                                ₡@item.Impuesto.ToString("N2")
                            </td>
                            <td style="text-align:right; font-weight:bold;">
                                ₡@item.TotalLinea.ToString("N2")
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="text-align:center; color:#666;">
                            No hay líneas registradas para esta factura.
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <table class="totales">
            <tr>
                <td><strong>Subtotal</strong></td>
                <td class="text-end">₡@Model.SubTotal.ToString("N2")</td>
            </tr>

            <tr>
                <td><strong>Descuento</strong></td>
                <td class="text-end">₡@((Model.DescuentoTotal ?? 0).ToString("N2"))</td>
            </tr>

            <tr>
                <td><strong>Impuesto</strong></td>
                <td class="text-end">₡@Model.ImpuestoTotal.ToString("N2")</td>
            </tr>

            <tr class="total-final">
                <td><strong>Total</strong></td>
                <td class="text-end">₡@Model.Total.ToString("N2")</td>
            </tr>

            <tr>
                <td><strong>Monto pagado</strong></td>
                <td class="text-end">₡@Model.MontoPagado.ToString("N2")</td>
            </tr>

            <tr>
                <td><strong>Saldo pendiente</strong></td>
                <td class="text-end">₡@Model.SaldoPendiente.ToString("N2")</td>
            </tr>
        </table>

        <div class="observacion">
            <strong>Observación:</strong><br />
            @(string.IsNullOrWhiteSpace(Model.Observacion)
                ? "Sin observaciones registradas."
                : Model.Observacion)
        </div>

        <div class="pie">
            Documento generado por el Sistema Web de Gestión Financiera UCADSA.<br />
            Gracias por su preferencia.
        </div>

    </div>

</body>
</html>