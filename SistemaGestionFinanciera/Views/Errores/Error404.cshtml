@{
    ViewData["Title"] = "Página no encontrada";
}

<div class="container text-center mt-5">
    <div class="card shadow border-0 p-5">
        <div class="card-body">
            <h1 class="display-6 text-danger">404</h1>
            <h3 class="fw-bold">Página no encontrada</h3>
            <p class="text-muted">
                La página que intenta abrir no existe o la dirección no fue escrita correctamente.
            </p>

            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">
                Volver al inicio
            </a>
        </div>
    </div>
</div>