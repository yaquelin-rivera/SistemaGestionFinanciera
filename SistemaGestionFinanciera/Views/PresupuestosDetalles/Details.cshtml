@model SistemaGestionFinanciera.Models.PresupuestoDetalle

@{
    ViewData["Title"] = "Detalle de Presupuesto";

    var categoria = Model.Tipo == "Ingreso"
        ? Model.CategoriaIngreso?.Nombre
        : Model.CategoriaGasto?.Nombre;

    var diferencia = Model.Diferencia ?? 0;
}

<div class="container-fluid mt-4">

    <h2 class="fw-bold">Detalle de Presupuesto</h2>
    <p class="text-muted">
        Consulta del detalle presupuestario por categoría.
    </p>

    <div class="card shadow-sm border-0">

        <div class="card-header text-white fw-bold" style="background-color:#0F5C64;">
            Información del detalle presupuestario
        </div>

        <div class="card-body">

            <p class="text-primary fw-bold mb-2">Información general</p>
            <hr />

            <div class="row mb-3">

                <div class="col-md-4">
                    <strong>Tipo</strong>
                    <div>
                        @if (Model.Tipo == "Ingreso")
                        {
                            <span class="badge bg-success">Ingreso</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Gasto</span>
                        }
                    </div>
                </div>

                <div class="col-md-4">
                    <strong>Categoría</strong>
                    <div>@(categoria ?? "Sin categoría")</div>
                </div>

                <div class="col-md-4">
                    <strong>Presupuesto mensual</strong>
                    <div>
                        @(Model.PresupuestoMensual != null
                            ? $"{Model.PresupuestoMensual.Mes}/{Model.PresupuestoMensual.Anio}"
                            : "Sin presupuesto")
                    </div>
                </div>

            </div>

            <p class="text-primary fw-bold mt-4 mb-2">Resumen financiero</p>
            <hr />

            <div class="row mb-3">

                <div class="col-md-4">
                    <strong>Monto planificado</strong>
                    <div>₡@Model.MontoPlanificado.ToString("N2")</div>
                </div>

                <div class="col-md-4">
                    <strong>Monto ejecutado</strong>
                    <div>₡@((Model.MontoEjecutado ?? 0).ToString("N2"))</div>
                </div>

                <div class="col-md-4">
                    <strong>Diferencia</strong>

                    @if (diferencia < 0)
                    {
                        <div class="text-danger fw-bold">
                            ₡@diferencia.ToString("N2")
                        </div>
                    }
                    else
                    {
                        <div class="text-success fw-bold">
                            ₡@diferencia.ToString("N2")
                        </div>
                    }
                </div>

            </div>

            <div class="alert alert-secondary mt-4">
                La diferencia representa el monto planificado que queda disponible o excedido para la categoría seleccionada.
            </div>

            <div class="d-flex justify-content-between mt-4">

                <a asp-action="Index" class="btn btn-secondary">
                    Volver al listado
                </a>

                <a asp-action="Edit"
                   asp-route-id="@Model.IdPresupuestoDetalle"
                   class="btn btn-warning">
                    Modificar
                </a>

            </div>

        </div>
    </div>
</div>