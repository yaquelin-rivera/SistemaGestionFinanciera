@model IEnumerable<SistemaGestionFinanciera.Models.ViewModels.MovimientoPresupuestoViewModel>

@{
    ViewData["Title"] = "Movimientos del Presupuesto";

    decimal totalIngresos = ViewBag.TotalIngresos ?? 0;
    decimal totalGastos = ViewBag.TotalGastos ?? 0;
    decimal balance = ViewBag.Balance ?? 0;
}

<div class="container-fluid mt-4">

    <h2 class="fw-bold">Movimientos del Presupuesto</h2>
    <p class="text-muted">
        Consulta automática de ingresos y gastos registrados para el proyecto, año y mes seleccionados.
    </p>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header text-white fw-bold" style="background-color:#0F5C64;">
            Información del presupuesto
        </div>

        <div class="card-body">

            <div class="row mb-3">

                <div class="col-md-4">
                    <strong>Proyecto</strong>
                    <div>@ViewBag.Proyecto</div>
                </div>

                <div class="col-md-4">
                    <strong>Año</strong>
                    <div>@ViewBag.Anio</div>
                </div>

                <div class="col-md-4">
                    <strong>Mes</strong>
                    <div>
                        @{
                            int numeroMes = Convert.ToInt32(ViewBag.Mes);

                            string nombreMes = new DateTime(
                            2000,
                            numeroMes,
                            1
                            ).ToString(
                            "MMMM",
                            new System.Globalization.CultureInfo("es-CR")
                            );

                            nombreMes =
                            char.ToUpper(nombreMes[0]) +
                            nombreMes.Substring(1);
                        }

                        @nombreMes
                    </div>
                </div>

            </div>

            <hr />

            <div class="row">

                <div class="col-md-4">
                    <div class="alert alert-success">
                        <strong>Total ingresos</strong>
                        <div>₡@totalIngresos.ToString("N2")</div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="alert alert-danger">
                        <strong>Total gastos</strong>
                        <div>₡@totalGastos.ToString("N2")</div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="alert alert-info">
                        <strong>Balance del período</strong>
                        <div>₡@balance.ToString("N2")</div>
                    </div>
                </div>

            </div>

        </div>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-header text-white fw-bold" style="background-color:#0F5C64;">
            Movimientos encontrados
        </div>

        <div class="card-body">

            <table class="table table-hover align-middle w-100 tabla-sistema">

                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th>Categoría</th>
                        <th>Documento</th>
                        <th>Descripción</th>
                        <th>Monto</th>
                        <th>Origen</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Fecha</td>

                                <td>
                                    @if (item.Tipo == "Ingreso")
                                    {
                                        <span class="badge bg-success">Ingreso</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Gasto</span>
                                    }
                                </td>

                                <td>@item.Categoria</td>
                                <td>@item.Documento</td>
                                <td>@item.Descripcion</td>

                                <td class="fw-bold">
                                    ₡@item.Monto.ToString("N2")
                                </td>

                                <td>@item.Origen</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                No existen movimientos registrados para este presupuesto.
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
            <div class="mt-4">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        @if (ViewBag.Origen == "DetallePresupuestoMensual")
                        {
                            <a asp-controller="PresupuestosMensuales"
                               asp-action="Details"
                               asp-route-id="@ViewBag.IdPresupuesto"
                               class="btn btn-secondary px-4">

                                <i class="fas fa-arrow-left me-1"></i>
                                Regresar al detalle

                            </a>
                        }
                        else if (ViewBag.Origen == "PresupuestoMensual")
                        {
                            <a asp-controller="PresupuestosMensuales"
                               asp-action="Index"
                               class="btn btn-secondary px-4">

                                <i class="fas fa-arrow-left me-1"></i>
                                Regresar a presupuesto mensual

                            </a>
                        }
                        else
                        {
                            <a asp-action="Index"
                               class="btn btn-secondary px-4">

                                <i class="fas fa-arrow-left me-1"></i>
                                Volver al listado

                            </a>
                        }

                    </div>

                    <div class="d-flex gap-2">

                        <a asp-action="ReporteMovimientos"
                           asp-route-id="@ViewBag.IdPresupuesto"
                           asp-route-origen="@ViewBag.Origen"
                           class="btn btn-info px-4">
                        

                            <i class="fas fa-file-pdf me-1"></i>
                            Vista previa PDF

                        </a>

                        <a asp-action="ExportarMovimientosExcel"
                           asp-route-id="@ViewBag.IdPresupuesto"
                           asp-route-origen="@ViewBag.Origen"
                           class="btn btn-success px-4">

                            <i class="fas fa-file-excel me-1"></i>
                            Exportar Excel

                        </a>

                    </div>

                </div>

            </div>

        </div>
    </div>

</div>