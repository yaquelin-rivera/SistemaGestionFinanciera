@model SistemaGestionFinanciera.Models.Gasto

@{
    ViewData["Title"] = "Anular Gasto";
}

<div class="container-fluid mt-4 px-4">

    <div class="card shadow-sm border-0 w-100">
        <div class="card-header text-white fw-bold"
             style="background-color:#0F5C64;">
            <i class="fas fa-ban me-2"></i>
            Anular gasto
        </div>

        <div class="card-body p-4">

            <div class="alert alert-warning">
                ¿Está seguro que desea anular este gasto? El registro no será eliminado de la base de datos; quedará marcado como anulado para mantener el historial financiero.
            </div>

            <div class="row">

                <div class="col-md-6">
                    <h5 class="text-primary">Información General</h5>
                    <hr />

                    <p><strong>Fecha:</strong> @Model.Fecha.ToString("dd/MM/yyyy")</p>
                    <p><strong>Concepto:</strong> @Model.Concepto</p>
                    <p><strong>Observación:</strong> @(string.IsNullOrWhiteSpace(Model.Observacion) ? "Sin observación" : Model.Observacion)</p>
                    <p><strong>Estado actual:</strong> <span class="badge bg-warning text-dark">@Model.Estado</span></p>
                </div>

                <div class="col-md-6">
                    <h5 class="text-primary">Información Financiera</h5>
                    <hr />

                    <p><strong>Subtotal:</strong> ₡@String.Format("{0:N2}", Model.Subtotal)</p>
                    <p><strong>Impuesto:</strong> ₡@String.Format("{0:N2}", Model.Impuesto)</p>
                    <p><strong>Tipo impuesto:</strong> @Model.TipoImpuesto</p>
                    <p><strong>Descuento:</strong> ₡@String.Format("{0:N2}", Model.Descuento)</p>
                    <p><strong>Monto total:</strong> ₡@String.Format("{0:N2}", Model.MontoTotal)</p>
                </div>

            </div>

            <hr />

            <div class="row">

                <div class="col-md-6">
                    <h5 class="text-primary">Clasificación</h5>
                    <hr />

                    <p><strong>Categoría:</strong> @Model.CategoriaGasto?.Nombre</p>
                    <p><strong>Proveedor:</strong> @Model.Proveedor?.Nombre</p>
                    <p><strong>Proyecto:</strong> @(Model.Proyecto?.Nombre ?? "No asignado")</p>
                    <p>
                        <strong>Período presupuestario:</strong>

                        @if (Model.PresupuestoMensualRegistro != null)
                        {
                            @(
                                new DateTime(
                                Model.PresupuestoMensualRegistro.Anio,
                                Model.PresupuestoMensualRegistro.Mes,
                                1
                                ).ToString(
                                "MMMM yyyy",
                                new System.Globalization.CultureInfo("es-CR"))
                                )
                        }
                        else
                        {
                            <span class="text-muted">
                                Sin período asociado
                            </span>
                        }
                    </p>
                </div>

                <div class="col-md-6">
                    <h5 class="text-primary">Control Presupuestario</h5>
                    <hr />

                    @if (Model.SuperaPresupuesto)
                    {
                        <p><strong>Estado presupuesto:</strong> <span class="badge bg-danger">Excedido</span></p>
                    }
                    else
                    {
                        <p><strong>Estado presupuesto:</strong> <span class="badge bg-success">Dentro del límite</span></p>
                    }

                    <p class="text-muted">
                        Al anular el gasto, dejará de considerarse activo y se revertirán los movimientos contables asociados, manteniendo el historial para control y auditoría.
                    </p>
                </div>
              
            </div>

        </div>
        <div class="card-footer bg-white ">
            <form asp-action="Delete"
                  asp-route-id="@Model.IdGasto"
                  method="post"
                  id="formAnularGasto"
                  data-concepto="@Model.Concepto">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="IdGasto" />

                <div class="mt-3 mb-3">
                    <label for="motivoAnulacion" class="form-label fw-bold">
                        Motivo de anulación
                    </label>

                    <textarea id="motivoAnulacion"
                              name="motivoAnulacion"
                              class="form-control"
                              rows="3"
                              maxlength="500"
                              placeholder="Explique el motivo por el cual se anula este gasto..."></textarea>

                    <div id="errorMotivoAnulacion"
                         class="text-danger small mt-1 d-none">
                        Debe ingresar el motivo de anulación.
                    </div>

                    <div class="form-text">
                        El motivo quedará guardado para control y auditoría.
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center w-100">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i>
                        Volver al listado
                    </a>

                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-1"></i>
                        Anular gasto
                    </button>
                </div>
                
            </form>

              @*  <a asp-action="Details" asp-route-id="@Model.IdGasto" class="btn btn-info" class="btn btn-primary btn-sm btn-accion">
                    <i class="fas fa-eye"></i>
                    Ver detalle
                </a> *@
        </div>

    </div>
</div>


@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const form = document.getElementById("formAnularGasto");
            const campoMotivo = document.getElementById("motivoAnulacion");
            const errorMotivo = document.getElementById("errorMotivoAnulacion");

            if (!form || !campoMotivo) {
                return;
            }

            form.addEventListener("submit", function (event) {
                event.preventDefault();

                const motivo = campoMotivo.value.trim();
                const concepto =
                    form.dataset.concepto || "Gasto seleccionado";

                // Limpia la validación anterior.
                campoMotivo.classList.remove("is-invalid");

                if (errorMotivo) {
                    errorMotivo.classList.add("d-none");
                }

                if (!motivo) {
                    campoMotivo.classList.add("is-invalid");

                    if (errorMotivo) {
                        errorMotivo.textContent =
                            "Debe ingresar el motivo de anulación.";

                        errorMotivo.classList.remove("d-none");
                    }

                    campoMotivo.focus();
                    return;
                }

                if (motivo.length < 5) {
                    campoMotivo.classList.add("is-invalid");

                    if (errorMotivo) {
                        errorMotivo.textContent =
                            "El motivo debe contener al menos 5 caracteres.";

                        errorMotivo.classList.remove("d-none");
                    }

                    campoMotivo.focus();
                    return;
                }

                if (!/[A-Za-zÁÉÍÓÚáéíóúÑñ0-9]/.test(motivo)) {
                    campoMotivo.classList.add("is-invalid");

                    if (errorMotivo) {
                        errorMotivo.textContent =
                            "El motivo no puede contener únicamente símbolos.";

                        errorMotivo.classList.remove("d-none");
                    }

                    campoMotivo.focus();
                    return;
                }

                Swal.fire({
                    title: "¿Anular gasto?",
                    html: `
                                <div class="mb-2">
                                    El gasto <strong>${concepto}</strong> será anulado.
                                </div>

                                <div class="mb-2">
                                    También se revertirán los movimientos contables
                                    asociados, si existen.
                                </div>
                            `,
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonText: "Sí, anular",
                    cancelButtonText: "Cancelar",
                    confirmButtonColor: "#dc3545",
                    cancelButtonColor: "#6c757d",
                    reverseButtons: true,
                    focusCancel: true,
                    allowOutsideClick: false
                }).then((result) => {
                    if (result.isConfirmed) {
                        // submit() nativo evita ejecutar otra vez el listener.
                        HTMLFormElement.prototype.submit.call(form);
                    }
                });
            });

            campoMotivo.addEventListener("input", function () {
                if (campoMotivo.value.trim()) {
                    campoMotivo.classList.remove("is-invalid");

                    if (errorMotivo) {
                        errorMotivo.classList.add("d-none");
                    }
                }
            });
        });
    </script>
}


