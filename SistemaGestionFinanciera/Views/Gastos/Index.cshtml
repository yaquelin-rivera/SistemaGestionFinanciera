</style>
                @section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

        
            // DATATABLES: SOLO SI EXISTEN REGISTROS
        
            const existenRegistros =
                        @Html.Raw(Model.Any().ToString().ToLower());

            if (existenRegistros &&
                typeof $ !== "undefined" &&
                $.fn.DataTable) {

                if ($.fn.DataTable.isDataTable('#tablaGastos')) {
                    $('#tablaGastos').DataTable().destroy();
                }

                $('#tablaGastos').DataTable({
                    pageLength: 10,

                    lengthMenu: [
                        [10, 25, 50, 100],
                        [10, 25, 50, 100]
                    ],

                    // Columna 0 = Fecha. DESC = último registro primero.
                    order: [],

                    autoWidth: false,
                    responsive: false,

                    columnDefs: [
                        {
                            targets: [15],
                            orderable: false,
                            searchable: false
                        }
                    ],

                    language: {
                        info: 'Mostrando _START_ a _END_ de _TOTAL_ gastos',
                        infoEmpty: 'Mostrando 0 a 0 de 0 gastos',
                        infoFiltered: '(filtrado de _MAX_ gastos totales)',
                        lengthMenu: 'Mostrar _MENU_ gastos',
                        loadingRecords: 'Cargando...',
                        processing: 'Procesando...',
                        search: 'Buscar:',
                        searchPlaceholder: 'Buscar gasto...',
                        zeroRecords: 'No se encontraron gastos.',
                        paginate: {
                            first: 'Primero',
                            last: 'Último',
                            next: 'Siguiente',
                            previous: 'Anterior'
                        }
                    }
                });
            }
            // =====================================================
            // SWEETALERT APROBAR GASTO
            // =====================================================
            document.querySelectorAll(".form-aprobar-gasto")
                .forEach(form => {

                    form.addEventListener("submit", function (e) {
                        e.preventDefault();

                        const descripcion =
                            form.dataset.descripcion || "Gasto seleccionado";

                        const superaPresupuesto =
                            form.dataset.superaPresupuesto === "true";

                        const limiteCategoria =
                            form.dataset.limiteCategoria || "0.00";

                        const aprobadoCategoria =
                            form.dataset.aprobadoCategoria || "0.00";

                        const montoGasto =
                            form.dataset.montoGasto || "0.00";

                        const totalProyectado =
                            form.dataset.totalProyectado || "0.00";

                        const excesoCategoria =
                            form.dataset.excesoCategoria || "0.00";

                

                        if (!superaPresupuesto) {

                            Swal.fire({
                                title: "¿Aprobar gasto?",
                                html: `
                                El gasto <strong>${descripcion}</strong>
                                será aprobado.
                                <br><br>
                                Esta acción generará los movimientos contables
                                correspondientes y actualizará la ejecución presupuestaria.
                            `,
                                icon: "question",
                                showCancelButton: true,
                                confirmButtonText: "Sí, aprobar",
                                cancelButtonText: "Cancelar",
                                confirmButtonColor: "#198754",
                                cancelButtonColor: "#6c757d",
                                reverseButtons: true
                            }).then((result) => {

                                if (result.isConfirmed) {
                                    form.submit();
                                }

                            });

                            return;
                        }

                        Swal.fire({
                            title: "¿Aprobar gasto excedido?",
                            html: `
                <div class="text-start">

                    <p class="mb-3">
                        El gasto <strong>${descripcion}</strong>
                        supera el límite mensual de su categoría.
                    </p>

                    <div class="border rounded p-3 bg-light">

                        <div class="d-flex justify-content-between mb-2">
                            <span>Límite de la categoría:</span>
                            <strong>₡${limiteCategoria}</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Aprobado previamente:</span>
                            <strong>₡${aprobadoCategoria}</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Monto por aprobar:</span>
                            <strong>₡${montoGasto}</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Total proyectado:</span>
                            <strong>₡${totalProyectado}</strong>
                        </div>

                        <hr>

                        <div class="d-flex justify-content-between">
                            <span>Exceso de la categoría:</span>
                            <strong class="text-danger">
                                ₡${excesoCategoria}
                            </strong>
                        </div>

                    </div>

                    <p class="text-danger fw-bold mt-3 mb-0">
                        Si continúa, el gasto será aprobado y contabilizado
                        a pesar de exceder el límite mensual de la categoría.
                    </p>

                </div>
            `,
                            icon: "warning",
                            showCancelButton: true,
                            confirmButtonText: "Sí, aprobar de todas formas",
                            cancelButtonText: "Cancelar",
                            confirmButtonColor: "#dc3545",
                            cancelButtonColor: "#6c757d",
                            reverseButtons: true,
                            focusCancel: true,
                            allowOutsideClick: false,
                            width: 560
                        }).then((result) => {
                            if (result.isConfirmed) {
                                form.submit();
                            }
                        });
                    });

                });

            // =====================================================
            // SWEETALERT RECHAZAR GASTO CON MOTIVO OBLIGATORIO
            // =====================================================
            document.querySelectorAll(".form-rechazar-gasto")
                .forEach(form => {

                    form.addEventListener("submit", function (e) {
                        e.preventDefault();

                        const descripcion =
                            form.dataset.descripcion || "Gasto seleccionado";

                        const monto =
                            form.dataset.monto || "0.00";

                        Swal.fire({
                            title: "Rechazar gasto",
                            html: `
                            <div class="mb-2">
                                <strong>${descripcion}</strong>
                            </div>

                            <div class="text-muted mb-3">
                                Monto: ₡${monto}
                            </div>

                            <div>
                                Indique el motivo del rechazo.
                            </div>
                        `,
                            input: "textarea",
                            inputPlaceholder:
                                "Escriba una observación clara y específica...",
                            inputAttributes: {
                                maxlength: 500,
                                "aria-label": "Motivo del rechazo"
                            },
                            inputValidator: (value) => {
                                const motivo = value ? value.trim() : "";

                                if (!motivo) {
                                    return "Debe indicar el motivo del rechazo.";
                                }

                                if (motivo.length < 5) {
                                    return "El motivo debe contener al menos 5 caracteres.";
                                }

                                if (motivo.length > 500) {
                                    return "El motivo no puede superar los 500 caracteres.";
                                }

                                if (!/[A-Za-zÁÉÍÓÚáéíóúÑñ0-9]/.test(motivo)) {
                                    return "El motivo no puede contener únicamente símbolos.";
                                }

                                return null;
                            },
                            icon: "warning",
                            showCancelButton: true,
                            confirmButtonText: "Confirmar rechazo",
                            cancelButtonText: "Cancelar",
                            confirmButtonColor: "#dc3545",
                            cancelButtonColor: "#6c757d",
                            reverseButtons: true,
                            focusCancel: true
                        }).then((result) => {

                            if (!result.isConfirmed) {
                                return;
                            }

                            const campoMotivo =
                                form.querySelector(".motivo-rechazo");

                            campoMotivo.value = result.value.trim();

                            form.submit();
                        });
                    });
                });

        });
    </script>
                }