@model IEnumerable<SistemaGestionFinanciera.Models.Gasto>

@{
    ViewData["Title"] = "Gastos";

    int cantidadPendientes =
        Convert.ToInt32(
            ViewBag.CantidadPendientesAutorizacion ?? 0);

    decimal montoPendientes =
        Convert.ToDecimal(
            ViewBag.MontoPendientesAutorizacion ?? 0m);

    int cantidadExcedidos =
        Convert.ToInt32(
            ViewBag.CantidadExcedidos ?? 0);

    decimal montoExcedidos =
        Convert.ToDecimal(
            ViewBag.MontoExcedidos ?? 0m);

    int cantidadAlertas =
        (cantidadPendientes > 0 ? 1 : 0) +
        (cantidadExcedidos > 0 ? 1 : 0);

    string columnaAlerta =
        cantidadAlertas == 1
            ? "col-lg-12"
            : "col-lg-6";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0">Gestionar Gastos</h2>
            <small class="text-muted">Administración de gastos  del sistema financiero</small>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus-circle me-1"></i> Registrar
        </a>
    </div>
    @if (cantidadAlertas > 0)
    {
        <div class="row g-2 mb-3">

            <!-- GASTOS PENDIENTES DE AUTORIZACIÓN -->
            @if (cantidadPendientes > 0)
            {
                <div class="@columnaAlerta">

                    <div class="alert alerta-pendiente-autorizacion
                            d-flex flex-wrap
                            justify-content-between
                            align-items-center
                            h-100 mb-0 py-2 px-3"
                         role="alert">

                        <div class="me-2">

                            <div>
                                <i class="fas fa-user-clock me-2"></i>

                                <strong>
                                    @cantidadPendientes
                                    @(cantidadPendientes == 1
                                        ? " gasto pendiente de autorización"
                                        : " gastos pendientes de autorización")
                                </strong>
                            </div>

                            <small class="d-block fw-semibold mt-1">
                                Monto pendiente:
                                @montoPendientes.ToString(
                                         "C2",
                                         new System.Globalization.CultureInfo("es-CR"))
                            </small>

                        </div>

                        <a asp-action="Index"
                           asp-route-estado="Pendiente de autorización"
                           class="btn btn-alerta-pendiente btn-sm fw-bold">

                            <i class="fas fa-search me-1"></i>
                            Revisar
                        </a>

                    </div>

                </div>
            }

            <!-- GASTOS CON LÍMITE EXCEDIDO -->
            @if (cantidadExcedidos > 0)
            {
                <div class="@columnaAlerta">

                    <div class="alert alert-danger
                            d-flex flex-wrap
                            justify-content-between
                            align-items-center
                            h-100 mb-0 py-2 px-3"
                         role="alert">

                        <div class="me-2">

                            <div>
                                <i class="fas fa-exclamation-triangle me-2"></i>

                                <strong>
                                    @cantidadExcedidos
                                    @(cantidadExcedidos == 1
                                        ? " gasto supera el límite de su categoría"
                                        : " gastos superan el límite de su categoría")
                                </strong>
                            </div>

                            <small class="d-block fw-semibold mt-1">
                                Monto involucrado:
                                @montoExcedidos.ToString(
                                         "C2",
                                         new System.Globalization.CultureInfo("es-CR"))
                            </small>

                        </div>

                        <a asp-action="Index"
                           asp-route-excedido="true"
                           class="btn btn-danger btn-sm fw-bold">

                            <i class="fas fa-eye me-1"></i>
                            Ver excedidos
                        </a>

                    </div>

                </div>
            }

        </div>
    }
    <div class="row row-cols-1 row-cols-md-4 g-2 mb-3">

        <div class="col">
            <div class="card shadow-sm border-0 border-start card-resumen border-4 border-primary h-100">
                <div class="card-body card-body-resumen d-flex justify-content-between align-items-center">
                    <div>
                        <small class=" fw-bold  mb-1">
                            Total gasto registrado
                        </small>

                        <div class="text-muted small">
                            @ViewBag.TipoResumen
                        </div>

                        <h5 class="fw-bold text-primary mb-0 mt-1">
                            ₡@String.Format("{0:N2}", ViewBag.TotalRegistrado)
                        </h5>
                    </div>

                    <i class="fas fa-money-bill-wave fa-lg icono-card"></i>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card shadow-sm border-0 border-start card-resumen border-4 border-success h-100">
                <div class="card-body card-body-resumen d-flex justify-content-between align-items-center">
                    <div>
                        <small class=" fw-bold  mb-1">
                            Total gasto aprobado
                        </small>

                        <div class="text-muted small">
                            @ViewBag.TipoResumen
                        </div>

                        <h5 class="fw-bold text-success mb-0 mt-1">
                            ₡@String.Format("{0:N2}", ViewBag.TotalAprobado)
                        </h5>
                    </div>

                    <i class="fas fa-check-circle fa-lg icono-card"></i>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card shadow-sm border-0 border-start card-resumen border-4 border-warning h-100">
                <div class="card-body card-body-resumen d-flex justify-content-between align-items-center">
                    <div>
                        <small class=" fw-bold  mb-1">
                            Total gasto pendiente autorización
                        </small>

                        <div class="text-muted small">
                            @ViewBag.TipoResumen
                        </div>

                        <h5 class="fw-bold text-warning mb-0 mt-1">
                            ₡@String.Format("{0:N2}", ViewBag.TotalPendiente)
                        </h5>
                    </div>

                    <i class="fas fa-clock fa-lg icono-card"></i>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card shadow-sm border-0 border-start card-resumen border-4 border-danger h-100">
                <div class="card-body card-body-resumen d-flex justify-content-between align-items-center">
                    <div>
                        <small class=" fw-bold  mb-1">
                            Total no válido
                        </small>

                        <div class="text-muted small">
                            @ViewBag.TipoResumen
                        </div>

                        <h5 class="fw-bold text-danger mb-0 mt-1">
                            ₡@String.Format("{0:N2}", ViewBag.TotalNoValido)
                        </h5>
                    </div>

                    <i class="fas fa-ban fa-lg icono-card"></i>
                </div>
            </div>
        </div>
        @*card con filtro
        <div class="col">
            <a asp-action="Index"
               asp-route-buscar="@ViewBag.Buscar"
               asp-route-estado="@ViewBag.Estado"
