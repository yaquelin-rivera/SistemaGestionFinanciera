    </div>


    <div class="card shadow-sm border-0 mb-3">
        <div class="card-header text-white fw-bold"
             style="background-color:#0F5C64;">
            <i class="fas fa-filter me-2"></i>
            Filtros de búsqueda
        </div>

        <div class="card-body">
            <form action="/Gastos/Index" method="get" class="row g-3" autocomplete="off">
                @if (ViewBag.Excedido == true)
                {
                    <input type="hidden" name="excedido" value="true" />
                }
                <div class="col-md-3">
                    <label class="form-label fw-bold >
                        <i class="fas fa-search text-muted me-1"></i>
                        Buscar
                    </label>
                    <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control"
                           placeholder="Concepto, factura, proveedor..." />
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-bold">
                        <i class="fas fa-info-circle text-muted me-1"></i>
                        Estado
                    </label>
                    <select name="estado" class="form-select">
                        <option value="">Todos</option>
                        <option value="Pendiente de autorización">Pendiente</option>
                        <option value="Aprobado">Aprobado</option>
                        <option value="Rechazado">Rechazado</option>
                        <option value="Anulado">Anulado</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-bold">
                        <i class="fas fa-sitemap text-muted me-1"></i>
                        Origen
                    </label>
                    <select name="origen" class="form-select">
                        <option value="">Todos</option>
                        <option value="Manual">Manual</option>
                        <option value="CxP">CxP</option>
                        <option value="Factura">Factura</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">
                        <i class="fas fa-project-diagram text-muted me-1"></i>
                        Proyecto
                    </label>
                    <select name="proyectoId" class="form-select" asp-items="ViewBag.Proyectos">
                        <option value="">Todos</option>
                    </select>
                </div>

                <div class="col-md-1">
                    <label class="form-label fw-bold">
                        <i class="fas fa-calendar-alt text-muted me-1"></i>
                        Año
                    </label>
                    <select name="anio" class="form-select">
                        <option value="">Todos</option>
                        @foreach (var anioItem in ViewBag.Anios)
                        {
                            <option value="@anioItem"
                                    selected="@(ViewBag.Anio?.ToString() == anioItem.ToString())">
                                @anioItem
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-1">
                    <label class="form-label fw-bold">
                        <i class="fas fa-calendar text-muted me-1"></i>
                        Mes
                    </label>
                    <select name="mes" class="form-select">
                        <option value="">Todos</option>
                        <option value="1" selected="@(ViewBag.Mes?.ToString() == "1")">Enero</option>
                        <option value="2" selected="@(ViewBag.Mes?.ToString() == "2")">Febrero</option>
                        <option value="3" selected="@(ViewBag.Mes?.ToString() == "3")">Marzo</option>
                        <option value="4" selected="@(ViewBag.Mes?.ToString() == "4")">Abril</option>
                        <option value="5" selected="@(ViewBag.Mes?.ToString() == "5")">Mayo</option>
                        <option value="6" selected="@(ViewBag.Mes?.ToString() == "6")">Junio</option>
                        <option value="7" selected="@(ViewBag.Mes?.ToString() == "7")">Julio</option>
                        <option value="8" selected="@(ViewBag.Mes?.ToString() == "8")">Agosto</option>
                        <option value="9" selected="@(ViewBag.Mes?.ToString() == "9")">Septiembre</option>
                        <option value="10" selected="@(ViewBag.Mes?.ToString() == "10")">Octubre</option>
                        <option value="11" selected="@(ViewBag.Mes?.ToString() == "11")">Noviembre</option>
                        <option value="12" selected="@(ViewBag.Mes?.ToString() == "12")">Diciembre</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">
                        <i class="fas fa-calendar-day text-muted me-1"></i>
                        Desde
                    </label>
                    <input type="date" name="fechaInicio" value="@ViewBag.FechaInicio" class="form-control" />
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-bold">
                        <i class="fas fa-calendar-check text-muted me-1"></i>
                        Hasta
                    </label>
                    <input type="date" name="fechaFin" value="@ViewBag.FechaFin" class="form-control" />
                </div>

                <div class="col-md-8 d-flex align-items-end ">
                    <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-5"><i class="fas fa-search me-1"></i> Buscar</button>

                    <a href="/Gastos/Index" class="btn btn-secondary px-5">
                        <i class="fas fa-eraser me-1"></i> Limpiar
                    </a>
                    </div>
                <!-- ==========================================================
                          ACCIONES DEL REPORTE
                          Conserva todos los filtros actualmente aplicados.
                          ========================================================== -->
                    <div class="ms-auto d-flex gap-2">

                    <a asp-action="Reporte"
                       asp-route-buscar="@ViewBag.Buscar"
                       asp-route-estado="@ViewBag.Estado"
                       asp-route-origen="@ViewBag.Origen"
                       asp-route-proyectoId="@ViewBag.ProyectoId"
                       asp-route-anio="@ViewBag.Anio"
                       asp-route-mes="@ViewBag.Mes"
                       asp-route-fechaInicio="@ViewBag.FechaInicio"
                       asp-route-fechaFin="@ViewBag.FechaFin"
                       asp-route-excedido="@ViewBag.Excedido"
                       class="btn btn-info px-4 ms-auto">

                            <i class="fas fa-file-pdf me-1"></i>
                        Vista previa PDF

                    </a>
                        <a asp-action="ExportarExcel"
                           asp-route-buscar="@ViewBag.Buscar"
                           asp-route-estado="@ViewBag.Estado"
                           asp-route-origen="@ViewBag.Origen"
                           asp-route-proyectoId="@ViewBag.ProyectoId"
                           asp-route-anio="@ViewBag.Anio"
                           asp-route-mes="@ViewBag.Mes"
                           asp-route-fechaInicio="@ViewBag.FechaInicio"
                           asp-route-fechaFin="@ViewBag.FechaFin"
                           asp-route-excedido="@ViewBag.Excedido"
                           class="btn btn-success px-5">

                            <i class="fas fa-file-excel me-1"></i>
                            Exportar Excel

                        </a>
                    </div>
                </div>
            </form>
          
        </div>

    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header text-white fw-bold"
             style="background-color:#0F5C64;">
            <i class="fas fa-list me-2"></i>
            Lista de gastos registrados
        </div>
        <div class="card-body">
            <div class="table-responsive">

                <table id="tablaGastos" class="table table-hover align-middle tabla-sistema">
                    <thead>
                        <tr>
                            <th>
                                <i class="fas fa-calendar-alt me-1"></i>
                                Fecha
                            </th>

                            <th>
                                <i class="fas fa-file-signature me-1"></i>
                                Concepto
                            </th>

                            <th>
                                <i class="fas fa-file-invoice me-1"></i>
                                Factura
                            </th>

                            <th>
                                <i class="fas fa-building me-1"></i>
                                Centro de costo
                            </th>

                            <th>
                                <i class="fas fa-coins me-1"></i>
                                Subtotal
                            </th>

                            <th>
                                <i class="fas fa-percent me-1"></i>
                                Impuesto
                            </th>

                            <th>
                                <i class="fas fa-receipt me-1"></i>
                                Tipo impuesto
                            </th>

                            <th>
                                <i class="fas fa-tag me-1"></i>
                                Descuento
                            </th>

                            <th>
                                <i class="fas fa-money-bill-wave me-1"></i>
                                Monto total
                            </th>

                            <th>
                                <i class="fas fa-comment-alt me-1"></i>
                                Observación
                            </th>

                            <th>
                                <i class="fas fa-layer-group me-1"></i>
                                Categoría
                            </th>

                            <th>
                                <i class="fas fa-truck me-1"></i>
                                Proveedor
                            </th>

                            <th>
                                <i class="fas fa-project-diagram me-1"></i>
                                Proyecto
                            </th>

                            <th>
                                <i class="fas fa-sitemap me-1"></i>
                                Origen
                            </th>

                            <th>
                                <i class="fas fa-info-circle me-1"></i>
                                Estado
                            </th>
                @*
                            <th style="min-width: 220px; max-width: 300px;">
                            Control Presupuestario por Categoria
                            </th>
                            *@
                            <th class="col-acciones text-center">
                                <i class="fas fa-cogs me-1"></i>
                                Acciones
                            </th>
                        </tr>
                    </thead>
                    
                    <tbody>

                        @if (!Model.Any())
                        {
                            <tr><td colspan="16" class="text-center text-muted py-4">No hay registros para mostrar en esta búsqueda.</td></tr>
                        }
                        else
                        {

                            foreach (var item in Model)
                            {

                                <tr>
                                    <td>
                                        @item.Fecha.ToString("dd/MM/yyyy")
                                    </td>
                                    <td>@Html.DisplayFor(modelItem => item.Concepto) </td>
                                    <td>
                                        @(string.IsNullOrWhiteSpace(item.NumeroFactura)
                                            ? "Sin factura"
                                            : item.NumeroFactura)
                                    </td>
                                    <td>@(item.CentroCosto?.Nombre ?? "Sin centro")</td>
                                    <td class="text-center">
                                        ₡@String.Format("{0:N2}", item.Subtotal)
                                    </td>
                                    <td class="text-center">
                                        ₡@String.Format("{0:N2}", item.Impuesto)
                                    </td>
                                    <td class="text-center">
                                        @item.TipoImpuesto
                                    </td>
                                    <td class="text-center">
                                        ₡@String.Format("{0:N2}", item.Descuento)
                                    </td>
                                    <td class="text-center">
                                        ₡@String.Format("{0:N2}", item.MontoTotal)
                                    </td>
                                    <td title="@item.Observacion">
                                        @(item.Observacion?.Length > 30
                                            ? item.Observacion.Substring(0, 30) + "..."
                                            : item.Observacion)
                                    </td>
                                    <td>@item.CategoriaGasto?.Nombre</td>
                                    <td>@item.Proveedor?.Nombre</td>
                                    <td>
                                        @if (item.Proyecto != null)
                                        {
                                            <div>@item.Proyecto.Nombre</div>

                                            @if (item.PresupuestoMensualRegistro != null)
                                            {
                                                <small class="text-muted">
                                                    @(
                                                        new DateTime(
                                                        item.PresupuestoMensualRegistro.Anio,
                                                        item.PresupuestoMensualRegistro.Mes,
                                                        1
                                                        ).ToString("MMMM yyyy",
                                                        new System.Globalization.CultureInfo("es-CR"))
                                                        )
                                                </small>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sin proyecto</span>
                                        }
                                    </td>

                                    <td>
                                        @* Detecta el origen funcional del gasto.
                                Manual: creado directamente desde el módulo Gastos.
                                CxP: generado automáticamente desde una cuenta por pagar manual.
                                Factura: generado automáticamente desde una factura de compra.*@

                                        @{
                                            bool esGastoDesdeCxP =
                                            !string.IsNullOrWhiteSpace(item.NumeroFactura) &&
                                            item.Concepto != null &&
                                            item.Concepto.ToLower().Contains("cuenta por pagar");

                                            bool esGastoDesdeFactura =
                                            !string.IsNullOrWhiteSpace(item.NumeroFactura) &&
                                            item.Concepto != null &&
                                            item.Concepto.ToLower().Contains("factura");

                                            bool esGastoManual =
                                            !esGastoDesdeCxP &&
                                            !esGastoDesdeFactura;
                                        }

                                        @if (esGastoDesdeCxP)
                                        {
                                            <span class="badge bg-warning text-dark">CxP</span>
                                        }
                                        else if (esGastoDesdeFactura)
                                        {
                                            <span class="badge bg-info text-dark">Factura</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Manual</span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.Estado == "Pendiente de autorización")
                                        {
                                            <span class="badge bg-warning text-dark">Pendiente de autorización</span>
                                        }
                                        else if (item.Estado == "Aprobado")
                                        {
                                            <span class="badge bg-success">Aprobado</span>
                                        }
                                        else if (item.Estado == "Rechazado")
                                        {
                                            <span class="badge bg-danger">Rechazado</span>
                                        }
                                        else if (item.Estado == "Anulado")
                                        {
                                            <span class="badge bg-secondary">Anulado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-dark">@item.Estado</span>
                                        }
                                        @if (item.SuperaPresupuesto &&
                                       item.Estado != "Anulado" &&
                                       item.Estado != "Rechazado")
                                        {
                                            <span class="badge bg-danger mt-1 badge-accion-doble opacity-85">
                                                <span>
                                                    <i class="fas fa-exclamation-triangle me-1"></i>
                                                    Límite de categoría 
                                                </span>
                                                <span> excedido</span>
                                            </span>
                                        }
                                    </td>
                                    @* ocultado 1 de julio <td>
                            @if (!item.Activo || item.Estado == "Anulado")
                            {
                            <span class="badge bg-secondary">No aplica</span>
                            }
                            else
                            {
                            <div style="min-width:300px; class=" small">
                            <div><strong>Presupuesto Categoria:</strong> ₡@String.Format("{0:N2}", item.PresupuestoMensual ?? 0)</div>
                            <div><strong>Gastado Mes:</strong> ₡@String.Format("{0:N2}", item.GastadoAcumulado ?? 0)</div>
                            <div><strong>Disponible:</strong> ₡@String.Format("{0:N2}", item.SaldoDisponible ?? 0)</div>

                            @if ((item.PresupuestoMensual ?? 0) <= 0)
                            {
                            <span class="badge bg-secondary mt-1">Sin presupuesto asignado</span>
                            }
                            else if ((item.SaldoDisponible ?? 0) < 0)
                            {
                            <span class="badge bg-danger mt-1">Excedido</span>
                            }
                            else
                            {
                            <span class="badge bg-success mt-1">Dentro del límite</span>
                            }
                            </div>
                            }
                            </td>   *@

                                    <td class="col-acciones">
                                        <div class="acciones-botones">

                                            @{
                                                // Solo Administrador y Contador pueden aprobar o rechazar.
                                                bool puedeAutorizar =
                                                Context.Session.GetString("Rol") == "Administrador" ||
                                                Context.Session.GetString("Rol") == "Contador";

                                                // Estados cerrados: no permiten acciones de edición.
                                                bool estadoCerrado =
                                                item.Estado == "Aprobado" ||
                                               // item.Estado == "Rechazado" ||
                                                item.Estado == "Anulado";

                                                // Aprobar/Rechazar aplica para:
                                                // - Gasto manual pendiente.
                                                // - Gasto automático desde CxP manual pendiente.
                                                // No aplica para gastos nacidos desde factura, porque la factura es el documento origen.
                                                bool puedeAprobarRechazar =
                                                item.Activo &&
                                                item.Estado == "Pendiente de autorización" &&
                                                puedeAutorizar &&
                                                (esGastoManual || esGastoDesdeCxP);

                                                // Modificar solo aplica para gastos manuales pendientes.
                                                // Los gastos automáticos no se modifican desde Gastos; se corrigen desde su origen.
                                                bool puedeModificar =
                                                item.Activo &&
                                                esGastoManual &&
                                                (
                                                item.Estado == "Pendiente de autorización" ||
                                                item.Estado == "Rechazado"
                                                );

                                                // Anular solo aplica para gastos manuales pendientes.
                                                // Los gastos automáticos se anulan desde Factura o CxP, según su origen.
                                                bool puedeAnular =
                                                item.Activo &&
                                                esGastoManual &&
                                                (
                                                item.Estado == "Pendiente de autorización" ||
                                                item.Estado == "Aprobado");

                                            }
                                            @{
                                                decimal limiteCategoriaGasto =
                                                item.PresupuestoMensual ?? 0m;

                                                decimal aprobadoAnteriorCategoria =
                                                item.GastadoAcumulado ?? 0m;

                                                decimal montoGastoEvaluado =
                                                item.MontoTotal ?? 0m;

                                                decimal totalProyectadoCategoria =
                                                aprobadoAnteriorCategoria + montoGastoEvaluado;

                                                decimal excesoCategoria =
                                                Math.Max(
                                                0m,
                                                totalProyectadoCategoria - limiteCategoriaGasto
                                                );
                                            }
                                            @if (puedeAprobarRechazar)
                                            {
                                                @if (puedeAprobarRechazar)
                                                {
                                                    <form asp-action="Aprobar"
                                                          asp-route-id="@item.IdGasto"
                                                          method="post"
                                                          class="d-inline form-aprobar-gasto"
                                                          data-descripcion="@item.Concepto"
                                                          data-supera-presupuesto="@item.SuperaPresupuesto.ToString().ToLower()"
                                                          data-limite-categoria="@limiteCategoriaGasto.ToString("N2")"
                                                          data-aprobado-categoria="@aprobadoAnteriorCategoria.ToString("N2")"
                                                          data-monto-gasto="@montoGastoEvaluado.ToString("N2")"
                                                          data-total-proyectado="@totalProyectadoCategoria.ToString("N2")"
                                                          data-exceso-categoria="@excesoCategoria.ToString("N2")">

                                                        @Html.AntiForgeryToken()

                                                        <button type="submit"
                                                                class="btn btn-aprobar btn-sm btn-accion">
                                                            <i class="fas fa-check"></i> Aprobar
                                                        </button>
                                                    </form>

                                                    <form asp-action="Rechazar"
                                                          asp-route-id="@item.IdGasto"
                                                          method="post"
                                                          class="d-inline form-rechazar-gasto"
                                                          data-descripcion="@item.Concepto"
                                                          data-monto="@((item.MontoTotal ?? 0).ToString("N2"))">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="motivoRechazo"
                                                               class="motivo-rechazo" />

                                                        <button type="submit"
                                                                class="btn btn-rechazar btn-sm btn-accion">
                                                            <i class="fas fa-times"></i> Rechazar
                                                        </button>
                                                    </form>
                                                }
                                            }

                                            @if (puedeModificar)
                                            {
                                                <a asp-action="Edit"
                                                   asp-route-id="@item.IdGasto"
                                                   class="btn btn-warning btn-sm btn-accion">
                                                    <i class="fas fa-edit"></i> Modificar
                                                </a>
                                            }

                                            <a asp-action="Details"
                                               asp-route-id="@item.IdGasto"
                                               class="btn btn-primary btn-sm btn-accion">
                                                <i class="fas fa-eye"></i> Detalles
                                            </a>

                                            @if (puedeAnular)
                                            {
                                                <a asp-action="Delete"
                                                   asp-route-id="@item.IdGasto"
                                                   class="btn btn-danger btn-sm btn-accion">
                                                    <i class="fas fa-trash"></i> Anular
                                                </a>
                                            }


                                        </div>
                                    </td>
                                </tr>
                            }

                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>
<style>
