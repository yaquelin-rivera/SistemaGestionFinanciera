@model IEnumerable<SistemaGestionFinanciera.Models.Gasto>

@{
    // La vista no utiliza el menú lateral ni el Layout general,
    // porque está diseñada para imprimir o guardar como PDF.
    Layout = null;

    ViewData["Title"] = "Reporte de gastos";

    // ===========================================================
    // TOTALES RECIBIDOS DESDE GASTOSCONTROLLER
    // ===========================================================

    decimal totalRegistrado = ViewBag.TotalRegistrado ?? 0m;
    decimal totalAprobado = ViewBag.TotalAprobado ?? 0m;
    decimal totalPendiente = ViewBag.TotalPendiente ?? 0m;
    decimal totalNoValido = ViewBag.TotalNoValido ?? 0m;

    // Detecta si el usuario aplicó algún filtro.
    bool hayFiltros =
        !string.IsNullOrWhiteSpace(ViewBag.Buscar as string) ||
        !string.IsNullOrWhiteSpace(ViewBag.Estado as string) ||
        !string.IsNullOrWhiteSpace(ViewBag.Origen as string) ||
        ViewBag.ProyectoId != null ||
        ViewBag.Anio != null ||
        ViewBag.Mes != null ||
        !string.IsNullOrWhiteSpace(ViewBag.FechaInicio as string) ||
        !string.IsNullOrWhiteSpace(ViewBag.FechaFin as string) ||
        ViewBag.Excedido == true;

    // Convierte el número del mes a su nombre.
    string nombreMes = "";

    if (ViewBag.Mes != null)
    {
        int numeroMes = Convert.ToInt32(ViewBag.Mes);

        nombreMes = new DateTime(2000, numeroMes, 1)
            .ToString(
                "MMMM",
                new System.Globalization.CultureInfo("es-CR"));

        nombreMes =
            char.ToUpper(nombreMes[0]) +
            nombreMes.Substring(1);
    }
}

<link rel="stylesheet"
      href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

<link rel="stylesheet"
      href="~/css/site.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<div class="container-fluid reporte-contenedor">

    <!-- ======================================================
         BOTONES DE CONTROL
         No aparecen cuando el reporte se imprime.
         ====================================================== -->
    <div class="d-flex justify-content-end gap-2 mb-3 no-imprimir">

        <button type="button"
                class="btn btn-info btn-lg px-4 shadow-sm"
                onclick="window.print();">

            <i class="fas fa-file-pdf me-2"></i>
            Imprimir / Guardar PDF

        </button>

        <button type="button"
                class="btn btn-secondary btn-lg px-4 shadow-sm"
                onclick="history.back();">

            <i class="fas fa-arrow-left me-2"></i>
            Volver

        </button>

    </div>

    <!-- ======================================================
         ENCABEZADO DEL REPORTE
         ====================================================== -->
    <div class="encabezado-reporte text-center">

        <h2>
            <i class="fas fa-chart-pie me-2"></i>
            Unión Cantonal de Asociaciones de Desarrollo de Santa Ana
        </h2>

        <h4>
            <i class="fas fa-file-invoice-dollar me-1"></i>
            Reporte de Gastos
        </h4>

        <div class="fecha-generacion">
            <i class="fas fa-calendar-alt me-1"></i>
            Fecha de generación:

            <strong>
                @(((DateTime)ViewBag.FechaGeneracion)
                    .ToString("dd/MM/yyyy HH:mm"))
            </strong>
        </div>

    </div>

    <!-- ======================================================
         FILTROS APLICADOS
         ====================================================== -->
    <div class="seccion-reporte">

        <div class="titulo-seccion">
            <i class="fas fa-filter me-1"></i>
            Filtros aplicados
        </div>

        @if (hayFiltros)
        {
            <div class="row g-2 small">

                @if (!string.IsNullOrWhiteSpace(ViewBag.Buscar as string))
                {
                    <div class="col-md-4">
                        <strong>Búsqueda:</strong>
                        @ViewBag.Buscar
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(ViewBag.Estado as string))
                {
                    <div class="col-md-4">
                        <strong>Estado:</strong>
                        @ViewBag.Estado
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(ViewBag.Origen as string))
                {
                    <div class="col-md-4">
                        <strong>Origen:</strong>
                        @ViewBag.Origen
                    </div>
                }

                @if (ViewBag.ProyectoId != null)
                {
                    <div class="col-md-4">
                        <strong>Proyecto:</strong>
                        Código @ViewBag.ProyectoId
                    </div>
                }

                @if (ViewBag.Anio != null)
                {
                    <div class="col-md-4">
                        <strong>Año:</strong>
                        @ViewBag.Anio
                    </div>
                }

                @if (ViewBag.Mes != null)
                {
                    <div class="col-md-4">
                        <strong>Mes:</strong>
                        @nombreMes
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(
               ViewBag.FechaInicio as string))
                {
                    <div class="col-md-4">
                        <strong>Desde:</strong>
                        @ViewBag.FechaInicio
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(
               ViewBag.FechaFin as string))
                {
                    <div class="col-md-4">
                        <strong>Hasta:</strong>
                        @ViewBag.FechaFin
                    </div>
                }

                @if (ViewBag.Excedido == true)
                {
                    <div class="col-md-4">
                        <strong>Control presupuestario:</strong>
                        Límite de categoría excedido
                    </div>
                }

            </div>
        }
        else
        {
            <span class="text-muted">
                No se aplicaron filtros. El reporte muestra todos los gastos registrados.
            </span>
        }

    </div>

    <!-- ======================================================
         RESUMEN DEL REPORTE
         ====================================================== -->
    <div class="row g-2 mb-3 cards-reporte">

        <div class="col">
            <div class="resumen-reporte card-registros">

                <div class="icono">
                    <i class="fas fa-file-invoice"></i>
                </div>

                <small>Total de registros</small>

                <div class="fw-bold">
                    @ViewBag.TotalRegistros
                </div>

            </div>
        </div>

        <div class="col">
            <div class="resumen-reporte card-registrado">

                <div class="icono">
                    <i class="fas fa-coins"></i>
                </div>

                <small>Total registrado</small>

                <div class="fw-bold">
                    ₡@totalRegistrado.ToString("N2")
                </div>

            </div>
        </div>

        <div class="col">
            <div class="resumen-reporte card-aprobado">

                <div class="icono">
                    <i class="fas fa-circle-check"></i>
                </div>

                <small>Total aprobado</small>

                <div class="fw-bold">
                    ₡@totalAprobado.ToString("N2")
                </div>

            </div>
        </div>

        <div class="col">
            <div class="resumen-reporte card-pendiente">

                <div class="icono">
                    <i class="fas fa-clock"></i>
                </div>

                <small>Total pendiente</small>

                <div class="fw-bold">
                    ₡@totalPendiente.ToString("N2")
                </div>

            </div>
        </div>

        <div class="col">
            <div class="resumen-reporte card-excedido">

                <div class="icono">
                    <i class="fas fa-triangle-exclamation"></i>
                </div>

                <small>Límite excedido</small>

                <div class="fw-bold">
                    @ViewBag.CantidadExcedidos
                </div>

            </div>
        </div>

    </div>

    <!-- ======================================================
         TABLA DE GASTOS
         ====================================================== -->
    <div class="table-responsive">

        <table class="table table-bordered table-sm tabla-reporte">

            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Concepto</th>
                    <th>Factura</th>
                    <th>Categoría</th>
                    <th>Proveedor</th>
                    <th class="solo-pantalla">Proyecto</th>
                    <th class="solo-pantalla">Centro de costo</th>
                    <th>Origen</th>
                    <th>Estado</th>
                    <th class="text-end">Monto total</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        // ===================================================
                        // DETERMINAR ORIGEN FUNCIONAL DEL GASTO
                        // ===================================================

                        bool esGastoDesdeCxP =
                        !string.IsNullOrWhiteSpace(item.NumeroFactura) &&
                        item.Concepto != null &&
                        item.Concepto.ToLower()
                        .Contains("cuenta por pagar");

                        bool esGastoDesdeFactura =
                        !string.IsNullOrWhiteSpace(item.NumeroFactura) &&
                        item.Concepto != null &&
                        item.Concepto.ToLower()
                        .Contains("factura");

                        string origenGasto;

                        if (esGastoDesdeCxP)
                        {
                            origenGasto = "CxP";
                        }
                        else if (esGastoDesdeFactura)
                        {
                            origenGasto = "Factura";
                        }
                        else
                        {
                            origenGasto = "Manual";
                        }
                        string claseFila = "";

                        if (item.Estado == "Anulado")
                        {
                            claseFila = "fila-anulada";
                        }
                        else if (item.Estado == "Pendiente de autorización")
                        {
                            claseFila = "fila-pendiente";
                        }
                        <tr class="@claseFila">

                            <td>
                                @item.Fecha.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @(item.Concepto ?? "Sin concepto")
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.NumeroFactura)
                                    ? "Sin factura"
                                    : item.NumeroFactura)
                            </td>

                            <td>
                                @(item.CategoriaGasto?.Nombre
                                    ?? "Sin categoría")
                            </td>

                            <td>
                                @(item.Proveedor?.Nombre
                                    ?? "Sin proveedor")
                            </td>

                            <td class="solo-pantalla">
                                @(item.Proyecto?.Nombre
                                    ?? "Sin proyecto")
                            </td>

                            <td class="solo-pantalla">
                                @(item.CentroCosto?.Nombre
                                    ?? "Sin centro")
                            </td>

                            <td>
                                @origenGasto
                            </td>

                            <td>
                                @item.Estado

                                @if (item.SuperaPresupuesto &&
                               item.Estado != "Anulado" &&
                               item.Estado != "Rechazado")
                                {
                                    <div class="texto-excedido">
                                        Límite excedido
                                    </div>
                                }
                            </td>

                            <td class="text-end monto-reporte">
                                ₡@((item.MontoTotal ?? 0m).ToString("N2"))
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10"
                            class="text-center text-muted py-4">

                            No existen gastos con los filtros seleccionados.

                        </td>
                    </tr>
                }

            </tbody>

        </table>

        <!-- ==================================================
             TOTALES INFERIORES
             ================================================== -->
        @if (Model.Any())
        {
            <div class="totales-reporte">

                <div>
                    <span>Total registrado:</span>
                    <strong>
                        ₡@totalRegistrado.ToString("N2")
                    </strong>
                </div>

                <div>
                    <span>Total aprobado:</span>
                    <strong>
                        ₡@totalAprobado.ToString("N2")
                    </strong>
                </div>

                <div>
                    <span>Total pendiente:</span>
                    <strong>
                        ₡@totalPendiente.ToString("N2")
                    </strong>
                </div>

                <div>
                    <span>Total no válido:</span>
                    <strong>
                        ₡@totalNoValido.ToString("N2")
                    </strong>
                </div>

            </div>
        }

    </div>

    <!-- ======================================================
         PIE DEL REPORTE
         ====================================================== -->
    <div class="pie-reporte">

        <div>
            Sistema Web de Gestión Financiera
        </div>

        <div>
            UCAD Santa Ana
        </div>

        <div>
            Generado:
            @(((DateTime)ViewBag.FechaGeneracion)
                .ToString("dd/MM/yyyy HH:mm"))
        </div>

    </div>

</div>

<style>

    body {
        background-color: #ffffff;
        font-family: Arial, Helvetica, sans-serif;
    }

    .reporte-contenedor {
        padding: 20px;
    }

    .encabezado-reporte {
        border-bottom: 3px solid #0f7c90;
        padding-bottom: 10px;
        margin-bottom: 12px;
        text-align: center;
    }

        .encabezado-reporte h2 {
            margin: 0;
            color: #15454d;
            font-size: 1.45rem;
            font-weight: 800;
        }

        .encabezado-reporte h4 {
            margin: 5px 0 0;
            color: #394b4f;
            font-size: 1.05rem;
            font-weight: 700;
        }

    .fecha-generacion {
        margin-top: 6px;
        color: #5e676b;
        font-size: 0.9rem;
    }

    .seccion-reporte {
        border: 1px solid #ced4da;
        border-radius: 5px;
        padding: 12px;
        margin-bottom: 15px;
    }

    .titulo-seccion {
        color: #0F5C64;
        font-weight: bold;
        margin-bottom: 8px;
    }

    /* Tarjetas de resumen */

    .resumen-reporte {
        height: 100%;
        padding: 10px 8px;
        background: #ffffff;
        border: 1px solid #d5e2e4;
        border-top: 4px solid #0f7c90;
        border-radius: 6px;
        text-align: center;
    }

        .resumen-reporte .icono {
            margin-bottom: 4px;
            color: #0f7c90;
            font-size: 1.1rem;
        }

        .resumen-reporte small {
            display: block;
            color: #59666a;
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .resumen-reporte .fw-bold {
            color: #15454d;
            font-size: 1rem;
            font-weight: 800;
            white-space: nowrap;
        }

    /* Total registrado */
    .card-registrado {
        border-top-color: #0f7c90;
    }

    /* Total aprobado */
    .card-aprobado {
        border-top-color: #198754;
    }

        .card-aprobado .icono,
        .card-aprobado .fw-bold {
            color: #198754;
        }

    /* Total pendiente */
    .card-pendiente {
        border-top-color: #f0ad00;
    }

        .card-pendiente .icono,
        .card-pendiente .fw-bold {
            color: #a66b00;
        }
    /* Filas anuladas */
    .fila-anulada td {
        background-color: #f8d7da !important;
        color: #842029 !important;
    }

    /* Filas pendientes de autorización */
    .fila-pendiente td {
        background-color: #fff3cd !important;
        color: #664d03 !important;
    }
    /* Límite excedido */
    .card-excedido {
        border-top-color: #dc3545;
    }

        .card-excedido .icono,
        .card-excedido .fw-bold {
            color: #b02a37;
        }

    .tabla-reporte {
        width: 100%;
        font-size: 13px;
    }

        .tabla-reporte thead th {
            background-color: #d8f0f3;
            color: #000000;
            vertical-align: middle;
            white-space: nowrap;
        }

        .tabla-reporte tbody td {
            vertical-align: middle;
        }

    .monto-reporte {
        white-space: nowrap;
    }

    .texto-excedido {
        color: #dc3545;
        font-size: 13px;
        font-weight: bold;
        margin-top: 2px;
    }

    .totales-reporte {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 24px;
        padding: 10px 12px;
        border-top: 2px solid #0F5C64;
        border-bottom: 1px solid #ced4da;
        background-color: #f8f9fa;
        font-size: 15px;
    }

        .totales-reporte div {
            display: flex;
            gap: 5px;
            white-space: nowrap;
        }

    .pie-reporte {
        border-top: 1px solid #adb5bd;
        margin-top: 20px;
        padding-top: 8px;
        display: flex;
        justify-content: space-between;
        font-size: 15px;
        color: #6c757d;
    }

    /* ========================================================
           CONFIGURACIÓN PARA IMPRIMIR O GUARDAR COMO PDF
           ======================================================== */
    @@media print {

        @@page {
            size: landscape;
            margin: 7mm;
        }

        html,
        body {
            width: 100%;
            margin: 0 !important;
            padding: 0 !important;
            background: white !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .fila-anulada td {
            background-color: #f8d7da !important;
            color: #842029 !important;
        }

        .fila-pendiente td {
            background-color: #fff3cd !important;
            color: #664d03 !important;
        }
        .no-imprimir {
            display: none !important;
        }
        /* Oculta columnas secundarias para que la tabla
               no se salga de la hoja al imprimir. */
        .solo-pantalla {
            display: none !important;
        }

        .reporte-contenedor {
            width: 98% !important;
            max-width: none !important;
            margin-left: auto !important;
            margin-right: auto !important;
            padding: 0 !important;
        }

        .table-responsive {
            width: 100% !important;
            overflow: visible !important;
        }
        /* ====================================================
               TAMAÑOS GENERALES DEL REPORTE IMPRESO
               ==================================================== */

        .encabezado-reporte {
            margin: 0 0 4px 0 !important;
            padding-bottom: 3px !important;
            border-bottom-width: 1px !important;
        }

            .encabezado-reporte h2 {
                font-size: 13pt !important;
                margin: 0 0 2px 0 !important;
            }

            .encabezado-reporte h4 {
                font-size: 9pt !important;
                margin: 0 0 1px 0 !important;
            }

        .fecha-generacion {
            margin-top: 1px !important;
            font-size: 6pt !important;
        }

        /* Criterios de consulta */
        .seccion-reporte {
            margin-bottom: 8px;
            padding: 8px;
            font-size: 11px !important;
        }

        .titulo-seccion {
            font-size: 13px !important;
            margin-bottom: 5px;
        }
        /* Tarjetas de resumen */
        .resumen-reporte {
            padding: 3px !important;
            min-height: 0 !important;
            border-top-width: 2px !important;
            border-radius: 3px !important;
        }

            .resumen-reporte .icono {
                margin-bottom: 0 !important;
                font-size: 7pt !important;
                line-height: 1 !important;
            }

            .resumen-reporte small {
                font-size: 7pt !important;
                line-height: 1 !important;
            }

            .resumen-reporte .fw-bold {
                font-size: 8pt !important;
                line-height: 1 !important;
            }
        /* ====================================================
               TABLA DEL REPORTE
               ==================================================== */

        .tabla-reporte {
            width: 100% !important;
            table-layout: fixed !important;
            font-size: 8px !important;
            margin-bottom: 0;
        }

            .tabla-reporte th,
            .tabla-reporte td {
                padding: 4px 4px !important;
                line-height: 1.15 !important;
                vertical-align: middle !important;
                word-break: normal !important;
                overflow-wrap: break-word !important;
            }

            .tabla-reporte thead th {
                font-size: 9px !important;
                font-weight: 700;
                white-space: nowrap;
            }

            .tabla-reporte tbody td {
                font-size: 9.5px !important;
            }
            /* Fecha */
            .tabla-reporte th:nth-child(1),
            .tabla-reporte td:nth-child(1) {
                width: 8%;
                white-space: nowrap;
            }
            /* Concepto */
            .tabla-reporte th:nth-child(2),
            .tabla-reporte td:nth-child(2) {
                width: 30%;
            }
            /* Factura */
            .tabla-reporte th:nth-child(3),
            .tabla-reporte td:nth-child(3) {
                width: 10%;
                white-space: nowrap;
            }
            /* Categoría */
            .tabla-reporte th:nth-child(4),
            .tabla-reporte td:nth-child(4) {
                width: 17%;
            }
            /* Proveedor */
            .tabla-reporte th:nth-child(5),
            .tabla-reporte td:nth-child(5) {
                width: 17%;
            }
            /* Origen */
            .tabla-reporte th:nth-child(8),
            .tabla-reporte td:nth-child(8) {
                width: 8%;
                white-space: nowrap;
            }
            /* Estado */
            .tabla-reporte th:nth-child(9),
            .tabla-reporte td:nth-child(9) {
                width: 13%;
            }
            /* Monto */
            .tabla-reporte th:nth-child(10),
            .tabla-reporte td:nth-child(10) {
                width: 14%;
                white-space: nowrap;
            }

        .texto-excedido {
            font-size: 8.5px !important;
            line-height: 1;
            margin-top: 2px;
        }
        /* Totales inferiores */
        .totales-reporte {
            gap: 18px;
            padding: 7px 8px;
            font-size: 9px !important;
            page-break-inside: avoid;
        }

            .totales-reporte strong {
                white-space: nowrap;
            }
        /* Pie de página */
        .pie-reporte {
            font-size: 9px !important;
            margin-top: 12px;
            padding-top: 5px;
        }
    }
</style>