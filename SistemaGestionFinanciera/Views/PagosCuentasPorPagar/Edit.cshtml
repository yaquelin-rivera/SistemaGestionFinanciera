@model SistemaGestionFinanciera.Models.PagosCuentaPorPagar

@{
    ViewData["Title"] = "Modificar Pago CxP";
}

<div class="container-fluid mt-4">

    <h2 class="fw-bold">Modificar Pago de Cuenta por Pagar</h2>
    <p class="text-muted">Actualización de la información registrada del pago aplicado a una cuenta por pagar</p>

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header text-white fw-bold" style="background-color:#0F5C64;">
            Complete la información del pago realizado
        </div>

        <div class="card-body">

            <div class="alert alert-secondary">
                El pago se modificará sobre la cuenta por pagar seleccionada y actualizará automáticamente el saldo pendiente.
            </div>

            <form asp-action="Edit" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        Revise los datos ingresados. Hay campos pendientes o con errores.
                    </div>
                }

                <input type="hidden" asp-for="IdPagoCuentaPorPagar" />
                <input type="hidden" asp-for="CuentaPorPagarId" />
                <input type="hidden" asp-for="Anulado" />

                <h5 class="text-primary fw-bold mt-3">Información de la cuenta</h5>
                <hr />

                <div class="row mb-4">

                    <div class="col-md-4">
                        <label class="form-label">Cuenta por pagar</label>
                        <input class="form-control"
                               value="@(Model.CuentaPorPagar?.NumeroDocumento ?? "Cuenta no registrada")"
                               readonly />
                        <small class="text-muted">
                            La cuenta por pagar no se modifica desde esta pantalla.
                        </small>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Proveedor</label>
                        <input class="form-control"
                               value="@(Model.CuentaPorPagar?.Proveedor?.Nombre ?? "No registrado")"
                               readonly />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="FechaPago" class="form-label">Fecha de pago</label>
                        <input asp-for="FechaPago" class="form-control" type="date" />
                        <span asp-validation-for="FechaPago" class="text-danger"></span>
                    </div>

                </div>

                <h5 class="text-primary fw-bold mt-3">Datos del pago</h5>
                <hr />

                <div class="row mb-4">

                    <div class="col-md-4">
                        <label asp-for="Monto" class="form-label">Monto del pago</label>
                        <input asp-for="Monto"
                               class="form-control"
                               type="number"
                               step="0.01"
                               min="0.01"
                               placeholder="Ej: 50000.00" />
                        <span asp-validation-for="Monto" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="MetodoPago" class="form-label">Método de pago</label>
                        <select asp-for="MetodoPago" class="form-control">
                            <option value="">-- Seleccione método de pago --</option>
                            <option value="Efectivo">Efectivo</option>
                            <option value="Transferencia">Transferencia</option>
                            <option value="Depósito">Depósito</option>
                            <option value="SINPE Móvil">SINPE Móvil</option>
                            <option value="Cheque">Cheque</option>
                        </select>
                        <span asp-validation-for="MetodoPago" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Referencia" class="form-label">Referencia</label>
                        <input asp-for="Referencia"
                               class="form-control"
                               placeholder="Ej: transferencia, comprobante o recibo" />
                        <span asp-validation-for="Referencia" class="text-danger"></span>
                    </div>

                </div>

                <h5 class="text-primary fw-bold mt-3">Observación</h5>
                <hr />

                <div class="row mb-4">

                    <div class="col-md-12">
                        <label asp-for="Observacion" class="form-label">Observación</label>
                        <textarea asp-for="Observacion"
                                  class="form-control"
                                  rows="2"
                                  placeholder="Observaciones del pago registrado"></textarea>
                        <span asp-validation-for="Observacion" class="text-danger"></span>
                        <small class="text-muted">
                            Puede indicar detalles del comprobante, acuerdo de pago o cualquier aclaración del abono.
                        </small>
                    </div>

                </div>

                <div class="d-flex justify-content-between mt-4">

                    <a asp-action="Index"
                       class="btn btn-secondary fw-bold">
                        <i class="fas fa-arrow-left me-1"></i> Volver al listado
                    </a>

                    <button type="submit"
                            class="btn fw-bold"
                            style="background-color:#0FB7C9;">
                        <i class="fas fa-save me-1"></i> Guardar
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}