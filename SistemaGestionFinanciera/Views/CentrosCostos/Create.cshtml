@model SistemaGestionFinanciera.Models.CentrosCosto

@{
    ViewData["Title"] = "Crear centro de costo";
}

<div class="container-fluid mt-4">

    <div class="mb-3">
        <h2 class="fw-bold mb-0">Crear centro de costo</h2>
        <small class="text-muted">
            Registre un centro de costo para clasificar movimientos contables por área o departamento.
        </small>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white fw-bold">
            Datos del centro de costo
        </div>

        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="Codigo" class="form-label fw-semibold">
                            Código <span class="text-danger">*</span>
                        </label>

                        <input asp-for="Codigo"
                               class="form-control"
                               maxlength="50"
                               autocomplete="off"
                               placeholder="Ejemplo: CC001" />

                        <small class="text-muted">
                            Solo letras, números y guiones. Se guardará en mayúscula.
                        </small>

                        <span asp-validation-for="Codigo" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Nombre" class="form-label fw-semibold">
                            Nombre <span class="text-danger">*</span>
                        </label>

                        <input asp-for="Nombre"
                               class="form-control"
                               maxlength="150"
                               autocomplete="off"
                               placeholder="Ejemplo: Administración" />

                        <small class="text-muted">
                            Solo letras, números y espacios. Mínimo 3 caracteres.
                        </small>

                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Descripcion" class="form-label fw-semibold">
                            Descripción
                        </label>

                        <textarea asp-for="Descripcion"
                                  class="form-control"
                                  rows="3"
                                  maxlength="300"
                                  autocomplete="off"
                                  placeholder="Describa brevemente el uso del centro de costo..."></textarea>

                        <small class="text-muted">
                            Campo opcional. Permite letras, números, espacios y signos básicos: . , ; : ( ) / -
                        </small>

                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>

                </div>

                <div class="alert alert-info mt-4 mb-0">
                   
                        El centro de costo se creará activo y podrá utilizarse para clasificar movimientos contables.
                  
                </div>

                <div class="mt-4 d-flex gap-2">
                    <a asp-action="Index" class="btn btn-dark">
                        <i class="fas fa-arrow-left me-1"></i>  Volver al listado
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Guardar
                    </button>

                    
                </div>

            </form>
        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const codigo = document.getElementById("Codigo");
            const nombre = document.getElementById("Nombre");
            const descripcion = document.getElementById("Descripcion");

            if (codigo) {
                codigo.addEventListener("input", function () {
                    this.value = this.value
                        .toUpperCase()
                        .replace(/[^A-Z0-9-]/g, "");
                });
            }

            if (nombre) {
                nombre.addEventListener("input", function () {
                    this.value = this.value.replace(/[^A-Za-zÁÉÍÓÚáéíóúÑñ0-9\s]/g, "");
                });
            }

            if (descripcion) {
                descripcion.addEventListener("input", function () {
                    this.value = this.value.replace(/[^A-Za-zÁÉÍÓÚáéíóúÑñ0-9\s.,;:()\/-]/g, "");
                });
            }
        });
    </script>
}